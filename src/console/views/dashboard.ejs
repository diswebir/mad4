<%- include('partials/page-header', { title: 'کنسول سازنده', icon: 'bi-shield-lock', breadcrumbs: [{ title: 'کنسول سازنده' }], subtitle: 'مدیریت فنی این نصب: ماژول‌ها، تنظیمات فنی، به‌روزرسانی، گزارش‌های خطا و ورود به پنل کاربران — این بخش برای سایر کاربران وجود ندارد.', actions: [{ href: '/system/modules', label: 'ماژول‌ها', icon: 'bi-grid-1x2', class: 'btn-primary' }, { href: '/console/security', label: 'امنیت کنسول', icon: 'bi-shield-check', class: 'btn-outline-secondary' }, { post: '/auth/logout', label: 'خروج', icon: 'bi-box-arrow-right', class: 'btn-outline-danger' }] }) %>
<% var fa = J.toPersianDigits; var up = info.uptime; var upStr = up >= 86400 ? fa(Math.floor(up / 86400)) + ' روز' : up >= 3600 ? fa(Math.floor(up / 3600)) + ' ساعت' : fa(Math.floor(up / 60)) + ' دقیقه'; %>
<% if (!info.totp || !info.allowIps) { %>
<div class="alert alert-warning d-flex align-items-center gap-2 py-2 fs-7"><i class="bi bi-shield-exclamation fs-5"></i><div class="flex-grow-1"><strong>امنیت کنسول را کامل کنید:</strong>
  <% if (!info.totp) { %> ورود دومرحله‌ای (TOTP) فعال نیست.<% } %><% if (!info.allowIps) { %> فهرست IPهای مجاز خالی است (ورود از هر نشانی ممکن است).<% } %></div><a href="/console/security" class="btn btn-sm btn-dark text-nowrap">تنظیم امنیت</a></div>
<% } %>
<div class="row g-3 mb-3">
  <div class="col-6 col-md-4 col-xl-2"><div class="card stat-card text-primary"><div class="card-body d-flex align-items-center gap-3"><div class="icon bg-brand-soft"><i class="bi bi-puzzle"></i></div><div><div class="value"><%= fa(stats.modulesEnabled) %><span class="text-secondary fs-6"> / <%= fa(stats.modules) %></span></div><div class="label">ماژول فعال</div></div></div></div></div>
  <div class="col-6 col-md-4 col-xl-2"><div class="card stat-card text-info"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-info"><i class="bi bi-stars"></i></div><div><div class="value"><%= fa(stats.featuresEnabled) %><span class="text-secondary fs-6"> / <%= fa(stats.features) %></span></div><div class="label">قابلیت فعال</div></div></div></div></div>
  <div class="col-6 col-md-4 col-xl-2"><a class="card stat-card text-danger text-decoration-none" href="/console/reports"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-danger"><i class="bi bi-bug"></i></div><div><div class="value"><%= fa(reports.new + reports.in_progress + (reports.seen || 0)) %></div><div class="label">گزارش باز (<%= fa(reports.new) %> جدید)</div></div></div></a></div>
  <div class="col-6 col-md-4 col-xl-2"><a class="card stat-card text-warning text-decoration-none" href="/console/requests"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-warning"><i class="bi bi-bag-plus"></i></div><div><div class="value"><%= fa(reports.requestsOpen || 0) %></div><div class="label">درخواست ماژول در انتظار</div></div></div></a></div>
  <div class="col-6 col-md-4 col-xl-2"><a class="card stat-card text-success text-decoration-none" href="/users"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-success"><i class="bi bi-people"></i></div><div><div class="value"><%= fa(Object.values(roles).reduce(function (a, b) { return a + b; }, 0)) %></div><div class="label">کاربر فعال</div></div></div></a></div>
  <div class="col-6 col-md-4 col-xl-2"><div class="card stat-card <%= disk && disk.level !== 'ok' ? 'text-danger' : 'text-secondary' %>"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-secondary"><i class="bi bi-hdd"></i></div><div><div class="value"><%= disk && disk.disk ? fa(disk.disk.percent) + '٪' : '—' %></div><div class="label">دیسک استفاده‌شده</div></div></div></div></div>
</div>
<div class="row g-3">
  <div class="col-xl-8">
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center"><h6 class="mb-0"><i class="bi bi-cpu me-1"></i>وضعیت این نصب</h6><a href="/system/info" class="fs-7">اطلاعات کامل</a></div>
      <div class="card-body py-2">
        <div class="row g-2 fs-7">
          <div class="col-md-4"><span class="text-secondary">نسخه:</span> <strong><%= fa(info.version) %></strong> <% if (info.installedVersion !== info.version) { %><span class="badge badge-soft-warning">DB: <%= fa(info.installedVersion) %></span><% } %> <a href="/system/update" class="ms-1"><i class="bi bi-cloud-arrow-down"></i> به‌روزرسانی</a></div>
          <div class="col-md-4"><span class="text-secondary">نصب:</span> <%= info.installedAt ? J.formatDate(info.installedAt) : '—' %><% if (info.updatedAt) { %> · <span class="text-secondary">آخرین به‌روزرسانی:</span> <%= J.formatDate(info.updatedAt.slice(0, 10)) %><% } %></div>
          <div class="col-md-4"><span class="text-secondary">Node:</span> <span class="ltr d-inline-block"><%= info.node %></span> · <span class="text-secondary">DB:</span> <%= info.driver %></div>
          <div class="col-md-4"><span class="text-secondary">زمان اجرا:</span> <%= upStr %> · <span class="text-secondary">حافظه:</span> <%= utils.fileSize(info.memory) %></div>
          <div class="col-md-4"><span class="text-secondary">نگهداری:</span> <% if (info.maintenance) { %><span class="badge text-bg-warning">فعال</span><% } else { %><span class="badge badge-soft-success">خاموش</span><% } %> · <span class="text-secondary">زمان‌بند:</span> <%= info.scheduler === 'cron' ? 'cron بیرونی' : 'داخلی' %></div>
          <div class="col-md-4"><span class="text-secondary">پیامک:</span> <%= info.sms ? info.sms : 'خاموش' %> · <span class="text-secondary">SMTP:</span> <%= info.smtp ? 'تنظیم‌شده' : 'خاموش' %></div>
          <div class="col-md-4"><span class="text-secondary">آخرین پشتیبان:</span> <% if (lastBackup) { %><%= J.formatDateTime(lastBackup.mtime) %> (<%= utils.fileSize(lastBackup.size) %>)<% } else { %><span class="text-danger">ندارد</span><% } %> <a href="/system/backup" class="ms-1">پشتیبان‌ها</a></div>
          <div class="col-md-4"><span class="text-secondary">نشانی عمومی:</span> <% if (info.siteUrl) { %><span class="ltr d-inline-block"><%= info.siteUrl %></span><% } else { %><span class="text-warning">تنظیم نشده</span><% } %></div>
          <div class="col-md-4"><span class="text-secondary">کاربران:</span> <% Object.keys(roles).forEach(function (r, i) { %><%= i ? '، ' : '' %><%= utils.ROLES[r] || r %> <%= fa(roles[r]) %><% }); %></div>
        </div>
      </div>
    </div>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center"><h6 class="mb-0"><i class="bi bi-bug me-1"></i>آخرین گزارش‌های خطا</h6><a href="/console/reports" class="fs-7">همهٔ گزارش‌ها</a></div>
      <div class="table-responsive"><table class="table table-sm table-hover mb-0 fs-7 align-middle"><thead><tr><th>#</th><th>نوع</th><th>عنوان</th><th>کاربر</th><th>صفحه</th><th>زمان</th><th>وضعیت</th></tr></thead><tbody>
        <% if (!latestReports.length) { %><tr><td colspan="7" class="text-center text-secondary py-3">گزارشی ثبت نشده است</td></tr><% } %>
        <% latestReports.forEach(function (r) { %><tr><td><a href="/console/reports/<%= r.id %>"><%= fa(r.id) %></a></td><td><%= consoleKinds[r.kind] || r.kind %></td><td><a href="/console/reports/<%= r.id %>" class="text-body"><%= r.subject %></a><% if (r.image) { %> <i class="bi bi-image text-secondary" title="دارای تصویر"></i><% } %></td><td><%= r.user_name || '—' %> <span class="text-secondary">(<%= utils.ROLES[r.role] || r.role %>)</span></td><td class="ltr text-start text-truncate" style="max-width:160px"><%= r.page_url || '' %></td><td class="text-nowrap"><%= J.formatDateTime(r.created_at) %></td><td><span class="badge badge-soft-<%= consoleStatusColor[r.status] || 'secondary' %>"><%= consoleStatuses[r.status] || r.status %></span></td></tr><% }); %>
      </tbody></table></div>
    </div>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center"><h6 class="mb-0"><i class="bi bi-bag-plus me-1"></i>درخواست‌های فعال‌سازی ماژول</h6><a href="/console/requests" class="fs-7">همهٔ درخواست‌ها</a></div>
      <div class="table-responsive"><table class="table table-sm table-hover mb-0 fs-7 align-middle"><thead><tr><th>#</th><th>درخواست</th><th>درخواست‌کننده</th><th>زمان</th><th>وضعیت</th></tr></thead><tbody>
        <% if (!latestRequests.length) { %><tr><td colspan="5" class="text-center text-secondary py-3">درخواستی ثبت نشده است</td></tr><% } %>
        <% latestRequests.forEach(function (r) { %><tr><td><%= fa(r.id) %></td><td><%= r.subject %></td><td><%= r.user_name || '—' %></td><td class="text-nowrap"><%= J.formatDateTime(r.created_at) %></td><td><span class="badge badge-soft-<%= consoleStatusColor[r.status] || 'secondary' %>"><%= consoleStatuses[r.status] || r.status %></span></td></tr><% }); %>
      </tbody></table></div>
    </div>
  </div>
  <div class="col-xl-4">
    <div class="card mb-3">
      <div class="card-header"><h6 class="mb-0"><i class="bi bi-box-arrow-in-left me-1"></i>ورود به پنل کاربر</h6></div>
      <div class="card-body">
        <form method="post" action="/console/impersonate" class="d-flex gap-2" data-no-lock>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input class="form-control ltr" name="username" placeholder="نام کاربری (مثلاً admin)" required aria-label="نام کاربری">
          <button class="btn btn-primary text-nowrap">ورود</button>
        </form>
        <div class="form-text">یا از <a href="/users">فهرست کاربران</a> روی «ورود به پنل کاربر» کلیک کنید. همهٔ اقدامات با برچسب «ورود به جای کاربر» ثبت می‌شود.</div>
        <% if (admins.length) { %><div class="mt-2 fs-7"><span class="text-secondary">مدیران مدرسه:</span> <% admins.forEach(function (a, i) { %><%= i ? '، ' : '' %><a href="#" data-post="/auth/impersonate/<%= a.id %>" title="ورود به پنل <%= a.name %>"><%= a.name %></a> <span class="text-secondary ltr d-inline-block">(<%= a.username %><%= a.phone ? ' · ' + a.phone : '' %>)</span><% }); %></div><% } %>
      </div>
    </div>
    <div class="card mb-3">
      <div class="card-header"><h6 class="mb-0"><i class="bi bi-lightning-charge me-1"></i>دسترسی سریع</h6></div>
      <div class="list-group list-group-flush fs-7">
        <a class="list-group-item list-group-item-action" href="/system/modules"><i class="bi bi-grid-1x2 me-2 text-brand"></i>ماژول‌ها و قابلیت‌ها (فعال/غیرفعال)</a>
        <a class="list-group-item list-group-item-action" href="/system/settings?tab=sms"><i class="bi bi-chat-left-text me-2 text-brand"></i>تنظیمات پیامک</a>
        <a class="list-group-item list-group-item-action" href="/system/settings?tab=email"><i class="bi bi-envelope me-2 text-brand"></i>تنظیمات ایمیل (SMTP)</a>
        <a class="list-group-item list-group-item-action" href="/system/settings?tab=offsite"><i class="bi bi-cloud-upload me-2 text-brand"></i>پشتیبان بیرونی</a>
        <a class="list-group-item list-group-item-action" href="/system/settings?tab=maintenance"><i class="bi bi-tools me-2 text-brand"></i>نگهداری، دیسک و پاک‌سازی</a>
        <a class="list-group-item list-group-item-action" href="/system/settings?tab=advanced"><i class="bi bi-list-ul me-2 text-brand"></i>همهٔ تنظیمات (پیشرفته)</a>
        <a class="list-group-item list-group-item-action" href="/system/update"><i class="bi bi-cloud-arrow-down me-2 text-brand"></i>به‌روزرسانی سامانه</a>
        <a class="list-group-item list-group-item-action" href="/system/logs"><i class="bi bi-journal-x me-2 text-brand"></i>خطاهای سرور</a>
        <a class="list-group-item list-group-item-action" href="/system/jobs"><i class="bi bi-alarm me-2 text-brand"></i>کارهای زمان‌بندی‌شده</a>
        <a class="list-group-item list-group-item-action" href="/system/activity"><i class="bi bi-clock-history me-2 text-brand"></i>گزارش فعالیت (شامل اقدامات سازنده)</a>
      </div>
    </div>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center"><h6 class="mb-0"><i class="bi bi-door-open me-1"></i>ورودهای کنسول</h6><a href="/console/security" class="fs-7">همه</a></div>
      <ul class="list-group list-group-flush fs-7">
        <% if (!consoleLogins.length) { %><li class="list-group-item text-secondary">موردی نیست</li><% } %>
        <% consoleLogins.forEach(function (l) { %><li class="list-group-item d-flex justify-content-between"><span><i class="bi <%= Number(l.success) ? 'bi-check-circle text-success' : 'bi-x-circle text-danger' %> me-1"></i><span class="ltr d-inline-block"><%= l.username %> · <%= l.ip %></span></span><span class="text-secondary text-nowrap"><%= J.formatDateTime(l.created_at) %></span></li><% }); %>
      </ul>
    </div>
    <% if (errors.length) { %>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center"><h6 class="mb-0"><i class="bi bi-exclamation-octagon me-1"></i>آخرین خطا/هشدارهای سرور</h6><a href="/system/logs" class="fs-7">همه</a></div>
      <ul class="list-group list-group-flush fs-7">
        <% errors.forEach(function (l) { %><li class="list-group-item"><span class="badge badge-soft-<%= l.level === 'error' ? 'danger' : 'warning' %> me-1"><%= l.level %></span><span class="ltr d-inline-block text-truncate" style="max-width:100%"><%= l.message %></span><div class="text-secondary" style="font-size:.7rem"><%= l.t %></div></li><% }); %>
      </ul>
    </div>
    <% } %>
  </div>
</div>
