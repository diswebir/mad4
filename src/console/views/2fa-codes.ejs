<%- include('partials/page-header', { title: 'کدهای پشتیبان ورود دومرحله‌ای', icon: 'bi-shield-check', breadcrumbs: [{ title: 'کنسول سازنده', href: '/console' }, { title: 'امنیت', href: '/console/security' }, { title: 'کدهای پشتیبان' }], actions: [{ print: true, label: 'چاپ' }] }) %>
<div class="row g-3 justify-content-center">
  <div class="col-lg-7">
    <div class="alert alert-success"><i class="bi bi-check-circle-fill me-1"></i><%= regenerated ? 'کدهای پشتیبان جدید ساخته شدند؛ کدهای قبلی باطل شدند.' : 'ورود دومرحله‌ای فعال شد.' %></div>
    <div class="card">
      <div class="card-body">
        <p class="fs-7">این <strong><%= J.toPersianDigits(codes.length) %> کد یکبارمصرف</strong> را در جای امنی ذخیره کنید. اگر به گوشی دسترسی نداشتید، به جای کد ۶ رقمی یکی از این کدها را وارد کنید. <strong class="text-danger">این کدها فقط همین یک‌بار نمایش داده می‌شوند.</strong></p>
        <div class="backup-codes p-3 bg-light rounded border"><% codes.forEach(function (c) { %><div><%= c %></div><% }); %></div>
        <a href="/console/security" class="btn btn-primary mt-3"><i class="bi bi-check2 me-1"></i>ذخیره کردم، بازگشت</a>
      </div>
    </div>
  </div>
</div>
