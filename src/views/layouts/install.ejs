<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> | نصب سامانه مدیریت مدرسه</title>
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/vendor/bootstrap/bootstrap.rtl.min.css">
<link rel="stylesheet" href="/assets/vendor/bootstrap-icons/bootstrap-icons.min.css">
<link rel="stylesheet" href="/assets/css/app.css?v=<%= appVersion %>">
</head>
<body>
<div class="install-wrap">
  <div class="text-center mb-4">
    <div class="d-inline-flex align-items-center justify-content-center rounded-4 bg-brand mb-2" style="width:64px;height:64px;font-size:2rem"><i class="bi bi-mortarboard-fill"></i></div>
    <h3 class="mb-0">نصب سامانه مدیریت مدرسه</h3>
    <div class="text-secondary fs-7">نسخه <%= J.toPersianDigits(appVersion) %> · Node.js <%= process.versions.node %></div>
  </div>
  <% if (step) { var names = ['پیش‌نیازها', 'پایگاه داده', 'مدرسه و مدیر', 'پایان']; %>
  <div class="steps"><% names.forEach(function (n, i) { %><div class="s <%= step === i + 1 ? 'active' : (step > i + 1 ? 'done' : '') %>"><%= J.toPersianDigits(i + 1) %>. <%= n %></div><% }); %></div>
  <% } %>
  <%- body %>
  <p class="text-center text-secondary fs-7 mt-4">پس از نصب، این ویزارد به‌صورت خودکار غیرفعال می‌شود.</p>
</div>
<script src="/assets/vendor/bootstrap/bootstrap.bundle.min.js"></script>
<script src="/assets/js/app.js?v=<%= appVersion %>"></script>
<%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
