<div class="empty-state py-5">
  <i class="bi bi-toggle-off"></i>
  <h4>بخش «<%= moduleName %>» غیرفعال است</h4>
  <p class="text-secondary">این ماژول یا قابلیت در حال حاضر برای این سامانه فعال نیست.</p>
  <% if (currentUser && isSuper) { %><a href="/system/modules" class="btn btn-primary"><i class="bi bi-grid me-1"></i>مدیریت ماژول‌ها</a><% } else if (currentUser && currentUser.role === 'admin' && enabled('support') && enabled('support.module_requests')) { %><a href="/support/modules" class="btn btn-primary"><i class="bi bi-bag-plus me-1"></i>درخواست فعال‌سازی</a><% } else { %><a href="/dashboard" class="btn btn-primary">داشبورد</a><% } %>
</div>
