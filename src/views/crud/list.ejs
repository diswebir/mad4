<%
var actions = [];
if (canManage && crud.canCreate !== false) actions.push({ href: urlBase + '/new', label: 'افزودن ' + crud.title, icon: 'bi-plus-lg', class: 'btn-primary' });
if (crud.exportable !== false && (!crud.exportFeature || enabled(crud.exportFeature))) actions.push({ href: urlBase + '/export' + (query.q ? '?q=' + encodeURIComponent(query.q) : ''), label: 'خروجی CSV', icon: 'bi-download' });
(pageActions || []).forEach(function (a) { actions.push(a); });
%>
<%- include('../partials/page-header', { title: crud.plural, icon: crud.icon, actions: actions, breadcrumbs: crud.breadcrumbs || [{ title: crud.plural }] }) %>
<% if (crud.intro) { %><div class="alert alert-info"><%- crud.intro %></div><% } %>
<div class="card table-card">
  <div class="card-header">
    <form class="toolbar" method="get" data-auto-submit>
      <% if (fields.some(function (f) { return f.search; })) { %>
      <div class="input-group input-group-sm" style="max-width:260px">
        <input type="search" class="form-control" name="q" value="<%= search %>" placeholder="جستجو…">
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
      </div>
      <% } %>
      <% filterFields.forEach(function (f) { var opts = f._resolved || []; %>
      <select class="form-select form-select-sm" name="f_<%= f.name %>">
        <option value="">همه <%= f.label %></option>
        <% opts.forEach(function (o) { %><option value="<%= o.value %>" <%= String(activeFilters[f.name]) === String(o.value) ? 'selected' : '' %>><%= o.label %></option><% }); %>
      </select>
      <% }); %>
      <% if (search || Object.keys(activeFilters).length) { %><a href="<%= urlBase %>" class="btn btn-sm btn-light">پاک کردن</a><% } %>
    </form>
    <span class="text-secondary fs-7"><%= J.toPersianDigits(result.total) %> مورد</span>
  </div>
  <% if (!result.data.length) { %>
    <%- include('../partials/empty', { message: 'هنوز موردی ثبت نشده است', action: canManage && crud.canCreate !== false ? { href: urlBase + '/new', label: 'افزودن ' + crud.title } : null }) %>
  <% } else { %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead><tr>
        <th style="width:50px">#</th>
        <% listFields.forEach(function (f) { var isSorted = sort === f.name; %>
        <th class="sortable"><a class="<%= isSorted ? 'active' : '' %>" href="?<%= Object.keys(query).filter(function(k){return k!=='sort'&&k!=='dir'&&k!=='page'}).map(function(k){return encodeURIComponent(k)+'='+encodeURIComponent(query[k])}).concat(['sort='+f.name,'dir='+(isSorted && dir==='asc'?'desc':'asc')]).join('&') %>"><%= f.label %> <% if (isSorted) { %><i class="bi bi-caret-<%= dir === 'asc' ? 'up' : 'down' %>-fill fs-7"></i><% } %></a></th>
        <% }); %>
        <% (crud.extraColumns || []).forEach(function (c) { %><th><%= c.label %></th><% }); %>
        <th class="actions"></th>
      </tr></thead>
      <tbody>
        <% result.data.forEach(function (row, i) { %>
        <tr>
          <td class="text-secondary fs-7"><%= J.toPersianDigits(result.from + i) %></td>
          <% listFields.forEach(function (f, fi) { %>
          <td><% if (fi === 0 && crud.showUrl) { %><a href="<%= crud.showUrl(row) %>" class="fw-500"><%- formatValue(f, row) %></a><% } else { %><%- formatValue(f, row) %><% } %></td>
          <% }); %>
          <% (crud.extraColumns || []).forEach(function (c) { %><td><%- c.render(row) %></td><% }); %>
          <td class="actions">
            <% if (rowActions) rowActions(row).forEach(function (a) { %>
              <% if (a.post) { %><a href="#" data-post="<%= a.post %>" <% if (a.confirm) { %>data-confirm="<%= a.confirm %>"<% } %> class="btn btn-sm <%= a.class || 'btn-light' %>" title="<%= a.label %>"><i class="bi <%= a.icon %>"></i></a>
              <% } else { %><a href="<%= a.href %>" class="btn btn-sm <%= a.class || 'btn-light' %>" title="<%= a.label %>"><i class="bi <%= a.icon %>"></i></a><% } %>
            <% }); %>
            <% if (crud.showUrl) { %><a href="<%= crud.showUrl(row) %>" class="btn btn-sm btn-light" title="مشاهده"><i class="bi bi-eye"></i></a><% } %>
            <% if (canManage && crud.canEdit !== false) { %><a href="<%= urlBase %>/<%= row.id %>/edit" class="btn btn-sm btn-light" title="ویرایش"><i class="bi bi-pencil"></i></a><% } %>
            <% if (canManage && crud.canDelete !== false) { %>
            <form method="post" action="<%= urlBase %>/<%= row.id %>/delete" class="d-inline" data-confirm="آیا از حذف این <%= crud.title %> مطمئن هستید؟"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-light text-danger" title="حذف"><i class="bi bi-trash"></i></button></form>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { result: result, baseUrl: urlBase }) %>
  <% } %>
</div>
