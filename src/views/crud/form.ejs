<%- include('../partials/page-header', { title: title, icon: crud.icon, breadcrumbs: (crud.breadcrumbs || []).concat([{ title: crud.plural, href: urlBase }, { title: isNew ? 'افزودن' : 'ویرایش' }]) }) %>
<form method="post" action="<%= action %>" enctype="multipart/form-data" class="card" style="max-width:<%= crud.formWidth || '980px' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <% if (crud.formIntro) { %><p class="text-secondary"><%- crud.formIntro %></p><% } %>
    <div class="row g-3">
      <% fields.filter(function (f) { return !f.hideInForm && !(f.readonly && isNew); }).forEach(function (field) { %>
        <%- include('../partials/field', { field: field, row: row, old: old }) %>
      <% }); %>
    </div>
  </div>
  <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
    <a href="<%= urlBase %>" class="btn btn-light">انصراف</a>
    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i><%= isNew ? 'ثبت' : 'ذخیره تغییرات' %></button>
  </div>
</form>
