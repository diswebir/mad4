<%
/* رندر یک فیلد فرم بر اساس تعریف: { name, label, type, required, options, col, placeholder, help, min, max, step, rows, readonly }
   مقادیر: row (داده‌های فعلی) و old (داده‌های فرم قبلی پس از خطا) */
var f = field;
var _row = typeof row !== 'undefined' && row ? row : {};
var _old = typeof old !== 'undefined' && old ? old : {};
var val = _old[f.name] !== undefined ? _old[f.name] : (_row[f.name] !== undefined && _row[f.name] !== null ? _row[f.name] : (f.default !== undefined ? f.default : ''));
if (f.type === 'date' && val && /^\d{4}-\d{2}-\d{2}/.test(String(val))) val = J.toJalali(val);
var id = 'f_' + f.name;
var cls = 'col-md-' + (f.col || 6);
var opts = f._resolved || (Array.isArray(f.options) ? f.options.map(function (o) { return typeof o === 'object' ? o : { value: o, label: o }; }) : (f.options && typeof f.options === 'object' ? Object.keys(f.options).map(function (k) { return { value: k, label: f.options[k] }; }) : []));
var attrs = (f.required ? ' required' : '') + (f.readonly ? ' readonly' : '') + (f.attrs || '');
%>
<% if (f.type === 'hidden') { %><input type="hidden" name="<%= f.name %>" value="<%= val %>"><% } else if (f.type === 'heading') { %>
<div class="col-12 mt-2"><h6 class="text-brand border-bottom pb-2 mb-0"><% if (f.icon) { %><i class="bi <%= f.icon %> me-1"></i><% } %><%= f.label %></h6></div>
<% } else { %>
<div class="<%= cls %>">
  <% if (f.type === 'checkbox') { %>
    <div class="form-check form-switch mt-4 pt-1">
      <input type="hidden" name="<%= f.name %>" value="0">
      <input class="form-check-input" type="checkbox" role="switch" id="<%= id %>" name="<%= f.name %>" value="1" <%= Number(val) ? 'checked' : '' %>>
      <label class="form-check-label" for="<%= id %>"><%= f.label %></label>
    </div>
  <% } else { %>
    <label for="<%= id %>" class="form-label<%= f.required ? ' required' : '' %>"><%= f.label %></label>
    <% if (f.type === 'select') { %>
      <select class="form-select" id="<%= id %>" name="<%= f.name %>"<%- attrs %>>
        <% if (!f.required || f.placeholder) { %><option value=""><%= f.placeholder || '— انتخاب کنید —' %></option><% } %>
        <% opts.forEach(function (o) { %><option value="<%= o.value %>" <%= String(o.value) === String(val) ? 'selected' : '' %>><%= o.label %></option><% }); %>
      </select>
    <% } else if (f.type === 'multiselect') { var _vals = String(val || '').split(',').filter(Boolean); %>
      <select class="form-select" id="<%= id %>" name="<%= f.name %>" multiple size="<%= Math.min(8, opts.length || 4) %>"<%- attrs %>>
        <% opts.forEach(function (o) { %><option value="<%= o.value %>" <%= _vals.includes(String(o.value)) ? 'selected' : '' %>><%= o.label %></option><% }); %>
      </select>
    <% } else if (f.type === 'radio') { %>
      <div class="d-flex gap-3 flex-wrap pt-1">
        <% opts.forEach(function (o, i) { %><div class="form-check"><input class="form-check-input" type="radio" name="<%= f.name %>" id="<%= id %>_<%= i %>" value="<%= o.value %>" <%= String(o.value) === String(val) ? 'checked' : '' %>><label class="form-check-label" for="<%= id %>_<%= i %>"><%= o.label %></label></div><% }); %>
      </div>
    <% } else if (f.type === 'textarea') { %>
      <textarea class="form-control" id="<%= id %>" name="<%= f.name %>" rows="<%= f.rows || 3 %>" placeholder="<%= f.placeholder || '' %>"<%- attrs %>><%= val %></textarea>
    <% } else if (f.type === 'date') { %>
      <input type="text" class="form-control jdate" id="<%= id %>" name="<%= f.name %>" value="<%= val ? J.toPersianDigits(val) : '' %>" placeholder="<%= f.placeholder || '۱۴۰۵/۰۷/۰۱' %>"<%- attrs %>>
    <% } else if (f.type === 'number') { %>
      <input type="text" inputmode="decimal" data-digits class="form-control en-digits" id="<%= id %>" name="<%= f.name %>" value="<%= val %>" <%- f.min != null ? 'data-min="' + f.min + '"' : '' %> placeholder="<%= f.placeholder || '' %>"<%- attrs %>>
    <% } else if (f.type === 'file') { %>
      <input type="file" class="form-control" id="<%= id %>" name="<%= f.name %>" <%- f.accept ? 'accept="' + f.accept + '"' : '' %><%- attrs %>>
      <% if (_row[f.name]) { %><div class="form-text d-flex align-items-center gap-2"><% if (f.images) { %><img src="/files/<%= _row[f.name] %>" alt="" style="height:36px;border-radius:6px"><% } %>فایل فعلی: <a href="/files/<%= _row[f.name] %>" target="_blank">مشاهده</a> <label class="ms-2"><input type="checkbox" name="remove_<%= f.name %>" value="1" class="form-check-input me-1">حذف</label></div><% } %>
    <% } else if (f.type === 'color') { %>
      <input type="color" class="form-control form-control-color" id="<%= id %>" name="<%= f.name %>" value="<%= val || '#2563eb' %>"<%- attrs %>>
    <% } else if (f.type === 'time') { %>
      <input type="time" class="form-control ltr" id="<%= id %>" name="<%= f.name %>" value="<%= val %>"<%- attrs %>>
    <% } else if (f.type === 'password') { %>
      <input type="password" class="form-control ltr" id="<%= id %>" name="<%= f.name %>" value="" autocomplete="new-password" placeholder="<%= f.placeholder || '' %>"<%- attrs %>>
    <% } else { %>
      <input type="<%= ['tel','email','text','url'].includes(f.type) ? f.type : 'text' %>" class="form-control<%= ['tel','email','username','en'].includes(f.type) || f.ltr ? ' ltr' : '' %>" id="<%= id %>" name="<%= f.name %>" value="<%= val %>" placeholder="<%= f.placeholder || '' %>" <%- f.maxLength ? 'maxlength="' + f.maxLength + '"' : '' %><%- attrs %>>
    <% } %>
    <% if (f.help) { %><div class="form-text"><%= f.help %></div><% } %>
  <% } %>
</div>
<% } %>
