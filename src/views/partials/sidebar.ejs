<aside class="sidebar">
  <a class="brand" href="/dashboard">
    <span class="logo"><% if (school('school_logo')) { %><img src="/files/<%= school('school_logo') %>" alt=""><% } else { %><i class="bi bi-mortarboard-fill"></i><% } %></span>
    <span class="mw-0"><span class="name d-block truncate"><%= school('school_name') %></span><span class="sub d-block truncate"><%= school('school_slogan') || 'سامانه مدیریت مدرسه' %></span></span>
  </a>
  <nav>
    <% (menu || []).forEach(function (group) { %>
      <div class="group-title"><%= group.title %></div>
      <% group.items.forEach(function (item) {
           var active = item.href === '/dashboard' ? currentPath === '/dashboard' : (currentPath === item.href || currentPath.startsWith(item.href + '/') || (item.match && currentPath.startsWith(item.match)));
      %>
        <a class="nav-link<%= active ? ' active' : '' %>" href="<%= item.href %>">
          <i class="bi <%= item.icon %>"></i><span><%= item.title %></span>
          <% if (item.badge === 'notifications' && unreadNotifications) { %><span class="badge text-bg-danger"><%= J.toPersianDigits(unreadNotifications) %></span><% } %>
          <% if (item.badge === 'tickets' && badgeTickets) { %><span class="badge text-bg-danger"><%= J.toPersianDigits(badgeTickets) %></span><% } %>
          <% if (item.badge === 'messages' && unreadMessages) { %><span class="badge text-bg-danger"><%= J.toPersianDigits(unreadMessages) %></span><% } %>
        </a>
      <% }); %>
    <% }); %>
  </nav>
  <div class="footer">نسخه <%= J.toPersianDigits(appVersion) %> · <%= currentUser ? utils.ROLES[currentUser.role] : '' %></div>
</aside>
