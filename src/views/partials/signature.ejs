<%# بلوک امضا و مهر + پاورقی سربرگ: lh, verifyCode (اختیاری) %>
<div class="signature-block mt-4">
  <div class="d-flex justify-content-between align-items-end">
    <div class="fs-7 text-secondary" style="max-width:55%">
      <% if (typeof verifyCode !== 'undefined' && verifyCode && enabled('documents.verify')) { %><div><i class="bi bi-shield-check me-1"></i>اصالت این سند با کد <strong class="ltr d-inline-block"><%= verifyCode %></strong> در نشانی <span class="ltr d-inline-block"><%= (S.get('site_url', '') || '').replace(/\/+$/, '') %>/documents/verify</span> قابل استعلام است.</div><% } %>
    </div>
    <div class="text-center position-relative" style="min-width:200px">
      <div class="fw-bold"><%= lh.signatory || '—' %></div>
      <div class="fs-7 text-secondary"><%= lh.signatoryTitle %></div>
      <div class="position-relative d-inline-block" style="height:84px;width:200px">
        <% if (lh.signature) { %><img src="/files/<%= lh.signature %>" alt="" style="max-height:70px;max-width:160px;position:absolute;right:20px;top:4px"><% } %>
        <% if (lh.stamp) { %><img src="/files/<%= lh.stamp %>" alt="" style="max-height:84px;max-width:110px;position:absolute;left:0;top:0;opacity:.85"><% } %>
      </div>
    </div>
  </div>
  <% if (lh.footer) { %><hr class="mb-1 mt-2" style="border-top:1.5px solid #111;opacity:1"><div class="fs-7 text-secondary text-center"><%= lh.footer %></div><% } %>
</div>
