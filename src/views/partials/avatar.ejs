<% var _u = user || {}; var _sz = typeof size !== 'undefined' ? size : ''; var _num = typeof _sz === 'number'; var _cls = 'avatar' + (!_num && _sz ? ' ' + _sz : ''); var _st = _num ? 'width:' + _sz + 'px;height:' + _sz + 'px;font-size:' + Math.max(10, Math.round(_sz * 0.4)) + 'px;' : ''; %>
<% if (_u.avatar) { %><img class="<%= _cls %>" style="<%= _st %>" src="/files/<%= _u.avatar %>" alt="<%= _u.name %>"><% } else { %><span class="<%= _cls %>" style="<%= _st %>background:<%= utils.colorFor(_u.name || _u.username) %>"><%= utils.initials(_u.name || _u.username) %></span><% } %>