<%- include('partials/page-header', { title: p.question, subtitle: (p.audience === 'class' ? (p.class_title || 'کلاس') : AUD[p.audience]) + ' · ' + (p.creator || '') + (p.ends_at ? ' · مهلت تا ' + J.formatDate(p.ends_at) : ''), icon: 'bi-bar-chart-steps', breadcrumbs: [{ title: 'نظرسنجی', href: '/polls' }, { title: 'مشاهده' }], actions: owner ? [{ post: '/polls/' + p.id + '/toggle', label: p.is_active ? 'بستن نظرسنجی' : 'بازکردن', icon: p.is_active ? 'bi-lock' : 'bi-unlock', class: 'btn-light' }, { post: '/polls/' + p.id + '/delete', label: 'حذف', icon: 'bi-trash', class: 'btn-outline-danger', confirm: 'نظرسنجی و آرا حذف شوند؟' }] : [] }) %>
<div class="row justify-content-center"><div class="col-lg-7">
<% if (p.description) { %><div class="alert alert-light border"><%- utils.nl2br(utils.escapeHtml(p.description)) %></div><% } %>
<% if (canVote) { %><form method="post" action="/polls/<%= p.id %>/vote" class="card mb-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="card-body">
  <% opts.forEach(function (o, i) { %><label class="list-group-item d-flex gap-2 align-items-center border rounded mb-2 p-3"><input class="form-check-input m-0" type="<%= p.multiple && enabled('polls.multiple') ? 'checkbox' : 'radio' %>" name="option" value="<%= i %>" <%= !p.multiple && i === 0 ? 'required' : '' %>><span><%= o %></span></label><% }); %>
</div><div class="card-footer bg-transparent text-end"><button class="btn btn-primary px-4"><i class="bi bi-check2-circle me-1"></i>ثبت رأی</button></div></form><% } else if (mine.length) { %><div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>رأی شما: <strong><%= mine.map(function (i) { return opts[i]; }).join('، ') %></strong></div><% } else if (!p.is_active || expired) { %><div class="alert alert-secondary">این نظرسنجی بسته شده است.</div><% } %>
<% if (showResults) { %><div class="card"><div class="card-header"><h6><i class="bi bi-bar-chart me-1"></i>نتایج</h6><span class="fs-7 text-secondary"><%= J.toPersianDigits(voters) %> شرکت‌کننده · <%= J.toPersianDigits(totalVotes) %> رأی</span></div><div class="card-body">
  <% results.forEach(function (r, i) { var pct = totalVotes ? Math.round(r.count / totalVotes * 100) : 0; %><div class="mb-3"><div class="d-flex justify-content-between"><span><%= r.label %></span><span class="fs-7"><%= J.toPersianDigits(r.count) %> رأی (<%= J.toPersianDigits(pct) %>٪)</span></div><div class="progress" style="height:10px"><div class="progress-bar <%= mine.includes(i) ? 'bg-success' : '' %>" style="width:<%= pct %>%"></div></div></div><% }); %>
</div></div><% } else if (!canVote) { %><div class="text-secondary fs-7">نتایج پس از پایان نظرسنجی نمایش داده می‌شود.</div><% } %>
</div></div>
