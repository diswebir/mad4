<%- include('partials/page-header', { title: a.title, subtitle: (a.author_name || '') + ' · ' + J.formatLong(a.created_at) + (a.audience === 'class' ? ' · ' + (a.class_title || '') : ' · ' + (AUDIENCES[a.audience] || '')), icon: 'bi-megaphone', breadcrumbs: [{ title: 'اطلاعیه‌ها', href: '/announcements' }, { title: a.title }], actions: canEdit ? [{ href: '/announcements/' + a.id + '/edit', label: 'ویرایش', icon: 'bi-pencil', class: 'btn-light' }, ...(isStaff ? [{ post: '/announcements/' + a.id + '/toggle', label: a.is_active ? 'غیرفعال‌کردن' : 'فعال‌کردن', icon: a.is_active ? 'bi-eye-slash' : 'bi-eye', class: 'btn-light' }] : []), { post: '/announcements/' + a.id + '/delete', label: 'حذف', icon: 'bi-trash', class: 'btn-outline-danger', confirm: 'اطلاعیه حذف شود؟' }] : [] }) %>
<div class="row g-3"><div class="col-lg-8"><div class="card"><div class="card-body">
  <% if (a.is_pinned && enabled('announcements.pin')) { %><span class="badge text-bg-warning mb-2"><i class="bi bi-pin-angle"></i> سنجاق‌شده</span><% } %>
  <div class="msg-body fs-6" style="line-height:2"><%- utils.nl2br(utils.escapeHtml(a.body)) %></div>
  <hr><div class="d-flex flex-wrap gap-3 fs-7 text-secondary"><% if (enabled('announcements.views')) { %><span><i class="bi bi-eye me-1"></i><%= J.toPersianDigits(a.views || 0) %> بازدید</span><% } %><% if (a.expires_at) { %><span><i class="bi bi-hourglass me-1"></i>اعتبار تا <%= J.formatDate(a.expires_at) %></span><% } %><% if (a.publish_at) { %><span><i class="bi bi-calendar-event me-1"></i>انتشار: <%= J.formatDate(a.publish_at) %></span><% } %><% if (!a.is_active) { %><span class="text-danger">غیرفعال</span><% } %></div>
</div></div></div>
<div class="col-lg-4"><div class="card"><div class="card-header"><h6>اطلاعیه‌های دیگر</h6></div><div class="list-group list-group-flush"><% others.forEach(function (o) { %><a class="list-group-item list-group-item-action" href="/announcements/<%= o.id %>"><div class="fw-semibold"><%= o.title %></div><div class="fs-7 text-secondary"><%= J.timeAgo(o.created_at) %></div></a><% }); if (!others.length) { %><div class="list-group-item text-secondary fs-7">—</div><% } %></div></div></div></div>
