<%- include('partials/page-header', { title: 'اطلاعیه‌ها', icon: 'bi-megaphone', actions: canCreate ? [{ href: '/announcements/new', label: 'اطلاعیهٔ جدید', icon: 'bi-plus-lg', class: 'btn-primary' }] : [] }) %>
<form method="get" class="d-flex flex-wrap gap-2 mb-3"><input class="form-control form-control-sm" style="max-width:260px" name="q" value="<%= f.q %>" placeholder="جستجو در اطلاعیه‌ها…">
  <% if (isStaff) { %><select class="form-select form-select-sm w-auto" name="audience" data-auto-submit><option value="">همهٔ مخاطبان</option><% Object.entries(AUDIENCES).forEach(function (x) { %><option value="<%= x[0] %>" <%= f.audience === x[0] ? 'selected' : '' %>><%= x[1] %></option><% }); %></select><select class="form-select form-select-sm w-auto" name="status" data-auto-submit><option value="">فعال و غیرفعال</option><option value="inactive" <%= f.status === 'inactive' ? 'selected' : '' %>>فقط غیرفعال</option></select><% } %>
  <button class="btn btn-sm btn-light"><i class="bi bi-search"></i></button></form>
<div class="row g-3"><% result.data.forEach(function (a) { var scheduled = a.publish_at && a.publish_at > now; var expired = a.expires_at && a.expires_at < today; %>
  <div class="col-md-6 col-xl-4"><div class="card h-100 <%= a.is_pinned && enabled('announcements.pin') ? 'border-warning' : '' %> <%= !a.is_active || expired ? 'opacity-75' : '' %>"><div class="card-body">
    <div class="d-flex justify-content-between align-items-start gap-2"><div class="d-flex flex-wrap gap-1"><% if (a.is_pinned && enabled('announcements.pin')) { %><span class="badge text-bg-warning"><i class="bi bi-pin-angle"></i> سنجاق</span><% } %><span class="badge badge-soft-primary"><%= a.audience === 'class' ? (a.class_title || 'کلاس') : AUDIENCES[a.audience] || a.audience %></span><% if (!a.is_active) { %><span class="badge badge-soft-secondary">غیرفعال</span><% } %><% if (scheduled) { %><span class="badge badge-soft-info">زمان‌بندی‌شده</span><% } %><% if (expired) { %><span class="badge badge-soft-danger">منقضی</span><% } %></div><% if (enabled('announcements.views')) { %><span class="fs-7 text-secondary text-nowrap"><i class="bi bi-eye"></i> <%= J.toPersianDigits(a.views || 0) %></span><% } %></div>
    <h6 class="mt-2 mb-1"><a href="/announcements/<%= a.id %>" class="text-body"><%= a.title %></a></h6>
    <div class="fs-7 text-secondary mb-2"><%= a.author_name || '' %> · <%= J.timeAgo(a.created_at) %></div>
    <div class="fs-7"><%= utils.truncate(a.body, 140) %></div>
  </div><div class="card-footer bg-transparent d-flex justify-content-between align-items-center"><a href="/announcements/<%= a.id %>" class="btn btn-sm btn-light">ادامه</a><% if (isStaff) { %><div class="d-flex gap-1"><% if (enabled('announcements.pin')) { %><a href="#" data-post="/announcements/<%= a.id %>/pin" class="btn btn-sm btn-light" title="سنجاق"><i class="bi bi-pin<%= a.is_pinned ? '-fill text-warning' : '' %>"></i></a><% } %><a href="/announcements/<%= a.id %>/edit" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a></div><% } %></div></div></div>
<% }); if (!result.data.length) { %><div class="col-12"><div class="card"><%- include('partials/empty', { message: 'اطلاعیه‌ای وجود ندارد', icon: 'bi-megaphone' }) %></div></div><% } %></div>
<%- include('partials/pagination', { result: result, query: query }) %>
