<%- include('partials/page-header', { title: a.id ? 'ویرایش اطلاعیه' : 'اطلاعیهٔ جدید', icon: 'bi-megaphone', breadcrumbs: [{ title: 'اطلاعیه‌ها', href: '/announcements' }, { title: a.id ? 'ویرایش' : 'جدید' }] }) %>
<div class="row justify-content-center"><div class="col-lg-8"><form method="post" action="<%= a.id ? '/announcements/' + a.id : '/announcements' %>" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body"><div class="row g-3">
    <div class="col-12"><label class="form-label required" for="f_title">عنوان</label><input class="form-control" name="title" required maxlength="200" value="<%= a.title || '' %>" id="f_title"></div>
    <div class="col-12"><label class="form-label required" for="f_body">متن</label><textarea class="form-control" name="body" rows="8" required id="f_body"><%= a.body || '' %></textarea></div>
    <% if (isStaff && enabled('announcements.audience')) { %><div class="col-md-4"><label class="form-label">مخاطب</label><select class="form-select" name="audience" id="aud" aria-label="مخاطب"><% Object.entries(AUDIENCES).forEach(function (x) { %><option value="<%= x[0] %>" <%= (a.audience || 'all') === x[0] ? 'selected' : '' %>><%= x[1] %></option><% }); %></select></div><% } else { %><input type="hidden" name="audience" value="class"><% } %>
    <div class="col-md-4" id="classBox"><label class="form-label" for="f_class_id">کلاس</label><select class="form-select" name="class_id" id="f_class_id"><% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= String(a.class_id) === String(c.id) ? 'selected' : '' %>><%= c.title %></option><% }); %></select></div>
    <% if (enabled('announcements.schedule')) { %><div class="col-md-4"><label class="form-label" for="f_publish_at">انتشار از تاریخ</label><input class="form-control jdate" name="publish_at" value="<%= a.publish_at ? J.formatDate(a.publish_at) : '' %>" placeholder="اکنون" id="f_publish_at"></div><div class="col-md-4"><label class="form-label" for="f_expires_at">انقضا</label><input class="form-control jdate" name="expires_at" value="<%= a.expires_at ? J.formatDate(a.expires_at) : '' %>" placeholder="بدون انقضا" id="f_expires_at"></div><% } %>
    <div class="col-md-4 d-flex align-items-end gap-3"><% if (isStaff && enabled('announcements.pin')) { %><label class="form-check"><input type="checkbox" class="form-check-input" name="is_pinned" value="1" <%= Number(a.is_pinned) ? 'checked' : '' %> aria-label="سنجاق"> سنجاق</label><% } %><% if (a.id) { %><label class="form-check"><input type="checkbox" class="form-check-input" name="is_active" value="1" <%= Number(a.is_active) ? 'checked' : '' %> aria-label="فعال"> فعال</label><% } %></div>
  </div></div>
  <div class="card-footer bg-transparent d-flex justify-content-between"><a href="/announcements" class="btn btn-light">انصراف</a><button class="btn btn-primary px-4"><i class="bi bi-send me-1"></i><%= a.id ? 'ذخیره' : 'انتشار' %></button></div>
</form></div></div>
<script>(function(){var a=document.getElementById('aud'),b=document.getElementById('classBox');function u(){if(!a){return;}b.style.display=a.value==='class'?'':'none';}if(a){a.addEventListener('change',u);u();}})();</script>
