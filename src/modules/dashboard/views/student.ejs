<% if (!student) { %><div class="alert alert-warning">پروندهٔ دانش‌آموزی برای حساب شما یافت نشد. با مدیر مدرسه تماس بگیرید.</div><% } else { %>
<div class="card mb-3 overflow-hidden">
  <div class="card-body profile-head">
    <% if (student.photo) { %><img src="/files/<%= student.photo %>" class="avatar avatar-lg" alt=""><% } else { %><%- include('partials/avatar', { user: currentUser, size: 'avatar-lg' }) %><% } %>
    <div class="flex-grow-1">
      <h4 class="mb-1"><%= student.first_name %> <%= student.last_name %></h4>
      <div class="text-secondary fs-7 d-flex gap-3 flex-wrap">
        <span><i class="bi bi-hash"></i> شماره دانش‌آموزی: <%= J.toPersianDigits(student.student_number) %></span>
        <% if (student.class_title) { %><span><i class="bi bi-door-open"></i> کلاس: <%= student.class_title %> (<%= student.grade_title %>)</span><% } %>
        <% if (typeof homeroom !== 'undefined' && homeroom) { %><span><i class="bi bi-person-video3"></i> معلم راهنما: <%= homeroom.name %></span><% } %>
      </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <% if (enabled('tickets.student')) { %><a href="/tickets/new" class="btn btn-primary"><i class="bi bi-ticket-detailed me-1"></i>ارسال تیکت</a><% } %>
      <a href="/students/me" class="btn btn-outline-secondary"><i class="bi bi-folder-person me-1"></i>پروندهٔ من</a>
    </div>
  </div>
</div>

<div class="row g-3 mb-3">
  <% if (typeof att !== 'undefined') { %>
  <div class="col-6 col-xl-3"><a href="/attendance/my" class="card stat-card text-success d-block text-reset"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-success"><i class="bi bi-calendar-check"></i></div><div><div class="value"><%= attAll.total ? J.toPersianDigits(Math.round(attAll.present / attAll.total * 100)) + '٪' : '—' %></div><div class="label">حضور کل · امروز: <%- todayStatus ? ({ present: '<span class="text-success">حاضر</span>', absent: '<span class="text-danger">غایب</span>', late: '<span class="text-warning">تأخیر</span>', excused: '<span class="text-info">موجه</span>', leave: 'مرخصی' })[todayStatus] : 'ثبت نشده' %></div></div></div></a></div>
  <div class="col-6 col-xl-3"><div class="card stat-card text-danger"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-danger"><i class="bi bi-calendar-x"></i></div><div><div class="value"><%= J.toPersianDigits(att.absent) %></div><div class="label">غیبت این ماه (<%= J.toPersianDigits(att.late) %> تأخیر)</div></div></div></div></div>
  <% } %>
  <% if (typeof avg !== 'undefined') { %>
  <div class="col-6 col-xl-3"><a href="/exams/my" class="card stat-card text-primary d-block text-reset"><div class="card-body d-flex align-items-center gap-3"><div class="icon bg-brand-soft"><i class="bi bi-award"></i></div><div><div class="value"><%= avg == null ? '—' : utils.num(avg) %></div><div class="label">معدل (از ۲۰)</div></div></div></a></div>
  <% } %>
  <% if (typeof points !== 'undefined') { %>
  <div class="col-6 col-xl-3"><div class="card stat-card text-warning"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-warning"><i class="bi bi-star"></i></div><div><div class="value"><%= J.toPersianDigits(points.pos - points.neg) %></div><div class="label">امتیاز رفتاری (+<%= J.toPersianDigits(points.pos) %> / −<%= J.toPersianDigits(points.neg) %>)</div></div></div></div></div>
  <% } %>
</div>

<div class="row g-3">
  <div class="col-xl-8">
    <% if (typeof dueSoon !== 'undefined' && dueSoon.length) { %>
    <div class="alert alert-warning d-flex align-items-start gap-2 mb-3"><i class="bi bi-alarm fs-5"></i><div><div class="fw-semibold">یادآوری مهلت تکالیف</div><ul class="mb-0 ps-3 fs-7"><% dueSoon.forEach(function (h) { var dl = J.diffDays(today, h.due_date); %><li><a href="/homework/<%= h.id %>" class="alert-link"><%= h.title %></a> (<%= h.subject_title || '' %>) — <%= dl === 0 ? 'امروز' : dl === 1 ? 'فردا' : J.toPersianDigits(dl) + ' روز دیگر' %></li><% }); %></ul></div></div>
    <% } %>
    <% if (typeof homework !== 'undefined') { %>
    <div class="card table-card mb-3">
      <div class="card-header"><h6><i class="bi bi-journal-text me-1 text-brand"></i>تکالیف</h6><a href="/homework" class="fs-7">همه</a></div>
      <table class="table table-hover table-sm"><thead><tr><th>عنوان</th><th>درس</th><th>مهلت</th><th>وضعیت</th></tr></thead><tbody>
        <% if (!homework.length) { %><tr><td colspan="4" class="text-center text-secondary py-3">تکلیفی ثبت نشده است</td></tr><% } %>
        <% homework.forEach(function (h) { var late = h.due_date && h.due_date < today && !h.sub_status; %><tr><td><a href="/homework/<%= h.id %>" class="fw-500"><%= h.title %></a></td><td><%= h.subject_title %></td><td class="<%= late ? 'text-danger' : '' %>"><%= J.formatDate(h.due_date) %></td><td><%- h.sub_status === 'graded' ? '<span class="badge badge-soft-success">نمره: ' + utils.num(h.sub_score) + '</span>' : (h.sub_status ? '<span class="badge badge-soft-info">ارسال شده</span>' : (late ? '<span class="badge badge-soft-danger">مهلت گذشته</span>' : '<span class="badge badge-soft-warning">در انتظار ارسال</span>')) %></td></tr><% }); %>
      </tbody></table>
    </div>
    <% } %>
    <% if (typeof grades !== 'undefined') { %>
    <div class="card table-card mb-3">
      <div class="card-header"><h6><i class="bi bi-award me-1 text-brand"></i>آخرین نمرات</h6><a href="/exams/my" class="fs-7">کارنامه</a></div>
      <table class="table table-hover table-sm"><thead><tr><th>درس</th><th>آزمون</th><th>تاریخ</th><th>نمره</th></tr></thead><tbody>
        <% if (!grades.length) { %><tr><td colspan="4" class="text-center text-secondary py-3">نمره‌ای ثبت نشده است</td></tr><% } %>
        <% grades.forEach(function (g) { %><tr><td class="fw-500"><%= g.subject_title %></td><td><%= g.exam_title %></td><td class="fs-7"><%= J.formatDate(g.date) %></td><td><% if (g.score != null) { %><span class="badge <%= Number(g.score) / Number(g.max_score || 20) >= 0.5 ? 'badge-soft-success' : 'badge-soft-danger' %>"><%= utils.num(g.score) %> / <%= utils.num(g.max_score) %></span><% } else if (g.descriptive) { %><span class="badge badge-soft-info"><%= g.descriptive %></span><% } else { %>—<% } %></td></tr><% }); %>
      </tbody></table>
    </div>
    <% } %>
    <div class="card">
      <div class="card-header"><h6><i class="bi bi-megaphone me-1 text-brand"></i>اطلاعیه‌ها</h6></div>
      <ul class="list-group list-group-flush">
        <% if (!announcements.length) { %><li class="list-group-item text-secondary fs-7">اطلاعیه‌ای نیست</li><% } %>
        <% announcements.forEach(function (a) { %><li class="list-group-item"><a href="/announcements/<%= a.id %>" class="fw-500 d-block"><% if (a.is_pinned) { %><i class="bi bi-pin-angle-fill text-warning me-1"></i><% } %><%= a.title %></a><span class="fs-7 text-secondary"><%= utils.truncate(a.body || '', 100) %> · <%= J.formatDate(a.publish_at || a.created_at) %></span></li><% }); %>
      </ul>
    </div>
  </div>
  <div class="col-xl-4">
    <% if (typeof birthday !== 'undefined' && birthday) { %>
      <%- include('partials/birthday-widget', { b: birthday, who: 'self', firstName: student.first_name }) %>
    <% } %>
    <% if (typeof schedule !== 'undefined') { %>
    <div class="card mb-3">
      <div class="card-header"><h6><i class="bi bi-table me-1 text-brand"></i>برنامهٔ امروز (<%= todayName %>)</h6><a href="/academic/schedule/class/<%= student.class_id %>" class="fs-7">هفتگی</a></div>
      <ul class="list-group list-group-flush">
        <% if (!schedule.length) { %><li class="list-group-item text-secondary fs-7">امروز کلاسی ندارید</li><% } %>
        <% schedule.forEach(function (s) { %><li class="list-group-item d-flex justify-content-between align-items-center fs-7"><span><span class="badge badge-soft-primary me-1">زنگ <%= J.toPersianDigits(s.period) %></span><%= s.subject_title %></span><span class="text-secondary"><%= s.teacher_name || '' %></span></li><% }); %>
      </ul>
    </div>
    <% } %>
    <% if (typeof exams !== 'undefined') { %>
    <div class="card mb-3">
      <div class="card-header"><h6><i class="bi bi-journal-check me-1 text-brand"></i>آزمون‌های پیش رو</h6></div>
      <ul class="list-group list-group-flush">
        <% if (!exams.length) { %><li class="list-group-item text-secondary fs-7">آزمونی ثبت نشده است</li><% } %>
        <% exams.forEach(function (x) { %><li class="list-group-item d-flex justify-content-between fs-7"><span><%= x.subject_title %> — <%= x.title %></span><span class="badge badge-soft-primary"><%= J.formatDate(x.date) %></span></li><% }); %>
      </ul>
    </div>
    <% } %>
    <% if (typeof invoices !== 'undefined' && invoices.length) { %>
    <div class="card mb-3 border-danger-subtle">
      <div class="card-header"><h6><i class="bi bi-receipt me-1 text-danger"></i>شهریهٔ پرداخت‌نشده</h6><a href="/finance/my" class="fs-7">جزئیات</a></div>
      <ul class="list-group list-group-flush"><% invoices.forEach(function (i) { %><li class="list-group-item d-flex justify-content-between fs-7"><span><%= i.title %></span><strong><%= utils.money(i.amount - i.paid_amount - i.discount) %></strong></li><% }); %></ul>
    </div>
    <% } %>
    <% if (typeof loans !== 'undefined' && loans.length) { %>
    <div class="card mb-3">
      <div class="card-header"><h6><i class="bi bi-book me-1 text-brand"></i>کتاب‌های امانتی</h6></div>
      <ul class="list-group list-group-flush"><% loans.forEach(function (l) { %><li class="list-group-item d-flex justify-content-between fs-7"><span><%= l.title %></span><span class="<%= l.due_at < today ? 'text-danger' : 'text-secondary' %>">تا <%= J.formatDate(l.due_at) %></span></li><% }); %></ul>
    </div>
    <% } %>
    <% if (typeof tickets !== 'undefined') { %>
    <div class="card mb-3">
      <div class="card-header"><h6><i class="bi bi-ticket-detailed me-1 text-brand"></i>تیکت‌های من</h6><a href="/tickets" class="fs-7">همه</a></div>
      <ul class="list-group list-group-flush">
        <% if (!tickets.length) { %><li class="list-group-item text-secondary fs-7">تیکتی ندارید</li><% } %>
        <% tickets.forEach(function (t) { %><li class="list-group-item d-flex justify-content-between align-items-center"><a href="/tickets/<%= t.id %>" class="fs-7 fw-500 truncate"><%= t.subject %></a><%- include('../../tickets/views/_status', { status: t.status }) %></li><% }); %>
      </ul>
    </div>
    <% } %>
    <% if (typeof polls !== 'undefined' && polls.length) { %>
    <div class="card mb-3">
      <div class="card-header"><h6><i class="bi bi-bar-chart-steps me-1 text-brand"></i>نظرسنجی</h6></div>
      <ul class="list-group list-group-flush"><% polls.forEach(function (p) { %><li class="list-group-item"><a href="/polls/<%= p.id %>" class="fw-500 fs-7"><%= p.question %></a></li><% }); %></ul>
    </div>
    <% } %>
    <div class="card">
      <div class="card-header"><h6><i class="bi bi-calendar-event me-1 text-brand"></i>رویدادها</h6></div>
      <ul class="list-group list-group-flush">
        <% if (!events.length) { %><li class="list-group-item text-secondary fs-7">رویدادی نیست</li><% } %>
        <% events.forEach(function (ev) { %><li class="list-group-item d-flex justify-content-between fs-7"><span><%= ev.title %></span><span class="text-secondary"><%= J.formatDate(ev.start_date) %></span></li><% }); %>
      </ul>
    </div>
  </div>
</div>
<% } %>
