<%- include('partials/page-header', { title: 'اولیا', icon: 'bi-people-fill', subtitle: 'حساب‌های کاربری پدر/مادر/سرپرست و پیوند با دانش‌آموزان', actions: [] }) %>
<div class="row g-3 mb-3">
  <div class="col-6 col-xl-3"><div class="card stat-card text-primary"><div class="card-body d-flex align-items-center gap-3"><div class="icon bg-brand-soft"><i class="bi bi-people"></i></div><div><div class="value"><%= J.toPersianDigits(stats.parents) %></div><div class="label">حساب ولی</div></div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card text-success"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-success"><i class="bi bi-link-45deg"></i></div><div><div class="value"><%= J.toPersianDigits(stats.linked) %> <span class="fs-7 text-muted">/ <%= J.toPersianDigits(stats.students) %></span></div><div class="label">دانش‌آموز دارای ولی</div></div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card text-info"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-info"><i class="bi bi-person-check"></i></div><div><div class="value"><%= J.toPersianDigits(stats.active) %></div><div class="label">حساب فعال</div></div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card text-warning"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-warning"><i class="bi bi-person-dash"></i></div><div><div class="value"><%= J.toPersianDigits(Math.max(0, stats.students - stats.linked)) %></div><div class="label">دانش‌آموز بدون ولی</div></div></div></div></div>
</div>
<div class="card table-card">
  <div class="card-header flex-wrap gap-2">
    <form class="d-flex gap-2 flex-wrap" method="get">
      <input class="form-control form-control-sm" name="q" value="<%= q %>" placeholder="نام، موبایل، کد ملی…" style="min-width:220px">
      <select class="form-select form-select-sm w-auto" name="status" aria-label="وضعیت"><option value="">همهٔ وضعیت‌ها</option><option value="active" <%= status === 'active' ? 'selected' : '' %>>فعال</option><option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>غیرفعال</option></select>
      <button class="btn btn-sm btn-outline-primary" aria-label="جستجو" title="جستجو"><i class="bi bi-search"></i></button>
    </form>
    <div class="d-flex gap-2">
      <% if (enabled('parents.export')) { %><a href="/parents/export.csv" class="btn btn-sm btn-outline-secondary"><i class="bi bi-filetype-csv me-1"></i>CSV</a><% } %>
      <% if (enabled('parents.bulk_create')) { %><form method="post" action="/parents/bulk" onsubmit="return confirm('برای همهٔ دانش‌آموزان فعال بدون ولی، حساب ساخته شود؟ (نام کاربری = موبایل پدر یا مادر، رمز پیش‌فرض)')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-primary"><i class="bi bi-people me-1"></i>ساخت گروهی حساب اولیا</button></form><% } %>
    </div>
  </div>
  <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>نام</th><th>نسبت</th><th>نام کاربری</th><th>موبایل</th><th>فرزندان</th><th>وضعیت</th><th>آخرین ورود</th></tr></thead><tbody>
  <% if (!rows.length) { %><tr><td colspan="7"><%- include('partials/empty', { message: 'ولی‌ای یافت نشد. از پروندهٔ هر دانش‌آموز (زبانهٔ «حساب اولیا») یا دکمهٔ ساخت گروهی استفاده کنید.' }) %></td></tr><% } %>
  <% rows.forEach(function (r) { %><tr>
    <td><a href="/parents/<%= r.id %>" class="fw-bold"><%= r.name %></a></td><td><%= RELATIONS[r.relation] || r.relation %></td><td dir="ltr" class="text-end"><%= r.username || '—' %></td><td dir="ltr" class="text-end"><%= J.toPersianDigits(r.phone || '') %></td>
    <td><% (byParent[r.id] || []).forEach(function (k) { %><a href="/students/<%= k.id %>" class="badge text-bg-light text-decoration-none"><%= k.first_name %> <%= k.last_name %><%= k.class_title ? ' — ' + k.class_title : '' %></a> <% }) %></td>
    <td><span class="badge text-bg-<%= r.user_status === 'active' ? 'success' : 'secondary' %>"><%= r.user_status === 'active' ? 'فعال' : 'غیرفعال' %></span></td>
    <td class="fs-7"><%= r.last_login_at ? J.timeAgo(r.last_login_at) : 'هرگز' %></td>
  </tr><% }) %>
  </tbody></table></div>
  <% if (pages > 1) { %><div class="card-footer"><%- include('partials/pagination', { result: { page: page, pages: pages } }) %></div><% } %>
</div>
