<% function val(k) { return data[k] == null ? '' : data[k]; } function sel(k, v) { return String(val(k)) === String(v) ? 'selected' : ''; } %>
<div class="card mb-3"><div class="card-body">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div><h5 class="mb-1"><i class="bi bi-person-plus me-1"></i>فرم پیش‌ثبت‌نام<%= year ? ' سال تحصیلی ' + J.toPersianDigits(year.title) : '' %></h5>
      <div class="text-secondary fs-7"><%= intro || 'لطفاً اطلاعات دانش‌آموز و اولیا را با دقت وارد کنید. پس از ثبت، کد رهگیری دریافت می‌کنید و نتیجهٔ بررسی از طریق پیامک/پیگیری اعلام می‌شود.' %></div></div>
    <% if (enabled('admissions.tracking')) { %><a href="/admissions/track" class="btn btn-light btn-sm"><i class="bi bi-search me-1"></i>پیگیری درخواست</a><% } %>
  </div>
  <% if (docs) { %><div class="alert alert-light border fs-7 mt-3 mb-0"><i class="bi bi-paperclip me-1"></i><strong>مدارک لازم برای ثبت‌نام قطعی:</strong> <%= docs %></div><% } %>
</div></div>
<% if (errors.length) { %><div class="alert alert-danger py-2"><ul class="mb-0 ps-3"><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul></div><% } %>
<form method="post" action="/admissions/apply" enctype="multipart/form-data" class="card" data-no-lock>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <h6 class="text-brand"><i class="bi bi-person me-1"></i>مشخصات دانش‌آموز</h6>
    <div class="row g-3 mb-4">
      <div class="col-md-4"><label class="form-label required">نام</label><input class="form-control" name="first_name" value="<%= val('first_name') %>" required maxlength="60"></div>
      <div class="col-md-4"><label class="form-label required">نام خانوادگی</label><input class="form-control" name="last_name" value="<%= val('last_name') %>" required maxlength="60"></div>
      <div class="col-md-4"><label class="form-label required">کد ملی</label><input class="form-control ltr" name="national_id" value="<%= val('national_id') %>" required inputmode="numeric" data-digits maxlength="10"></div>
      <div class="col-md-4"><label class="form-label required">تاریخ تولد (شمسی)</label><input type="text" class="form-control jdate" name="birth_date" value="<%= val('birth_date') && /^\d{4}-\d{2}-\d{2}/.test(val('birth_date')) ? J.toJalali(val('birth_date')) : val('birth_date') %>" placeholder="۱۳۹۲/۰۶/۱۵" required></div>
      <div class="col-md-4"><label class="form-label">محل تولد</label><input class="form-control" name="birth_place" value="<%= val('birth_place') %>" maxlength="60"></div>
      <div class="col-md-4"><label class="form-label required">جنسیت</label><select class="form-select" name="gender" required><option value="">—</option><% Object.keys(GENDERS).forEach(function (g) { %><option value="<%= g %>" <%= sel('gender', g) %>><%= GENDERS[g] %></option><% }); %></select></div>
      <div class="col-md-4"><label class="form-label required">پایهٔ درخواستی</label><select class="form-select" name="grade_level_id" required><option value="">—</option><% grades.forEach(function (g) { %><option value="<%= g.id %>" <%= sel('grade_level_id', g.id) %>><%= g.title %></option><% }); %></select></div>
      <div class="col-md-4"><label class="form-label">مدرسهٔ قبلی</label><input class="form-control" name="previous_school" value="<%= val('previous_school') %>" maxlength="120"></div>
      <div class="col-md-4"><label class="form-label">معدل سال گذشته</label><input class="form-control ltr" name="previous_average" value="<%= val('previous_average') %>" inputmode="decimal" data-digits placeholder="مثال: 18.25"></div>
    </div>
    <h6 class="text-brand"><i class="bi bi-people me-1"></i>اطلاعات اولیا</h6>
    <div class="row g-3 mb-4">
      <div class="col-md-4"><label class="form-label required">نام پدر / سرپرست</label><input class="form-control" name="father_name" value="<%= val('father_name') %>" required maxlength="80"></div>
      <div class="col-md-4"><label class="form-label required">موبایل پدر / سرپرست</label><input class="form-control ltr" name="father_phone" value="<%= val('father_phone') %>" required inputmode="tel" data-digits placeholder="09xxxxxxxxx"><div class="form-text">کد رهگیری و نتیجه به این شماره پیامک می‌شود</div></div>
      <div class="col-md-4"><label class="form-label">کد ملی پدر</label><input class="form-control ltr" name="father_national_id" value="<%= val('father_national_id') %>" inputmode="numeric" data-digits maxlength="10"></div>
      <div class="col-md-4"><label class="form-label">شغل پدر</label><input class="form-control" name="father_job" value="<%= val('father_job') %>" maxlength="80"></div>
      <div class="col-md-4"><label class="form-label">تحصیلات پدر</label><select class="form-select" name="father_education"><option value="">—</option><% Object.keys(EDUCATIONS).forEach(function (k) { %><option value="<%= k %>" <%= sel('father_education', k) %>><%= EDUCATIONS[k] %></option><% }); %></select></div>
      <div class="col-md-4"></div>
      <div class="col-md-4"><label class="form-label">نام مادر</label><input class="form-control" name="mother_name" value="<%= val('mother_name') %>" maxlength="80"></div>
      <div class="col-md-4"><label class="form-label">موبایل مادر</label><input class="form-control ltr" name="mother_phone" value="<%= val('mother_phone') %>" inputmode="tel" data-digits></div>
      <div class="col-md-4"><label class="form-label">شغل مادر</label><input class="form-control" name="mother_job" value="<%= val('mother_job') %>" maxlength="80"></div>
      <div class="col-md-4"><label class="form-label">تحصیلات مادر</label><select class="form-select" name="mother_education"><option value="">—</option><% Object.keys(EDUCATIONS).forEach(function (k) { %><option value="<%= k %>" <%= sel('mother_education', k) %>><%= EDUCATIONS[k] %></option><% }); %></select></div>
    </div>
    <h6 class="text-brand"><i class="bi bi-geo-alt me-1"></i>تماس و نشانی</h6>
    <div class="row g-3 mb-4">
      <div class="col-md-8"><label class="form-label">نشانی منزل</label><input class="form-control" name="address" value="<%= val('address') %>" maxlength="255"></div>
      <div class="col-md-4"><label class="form-label">کد پستی</label><input class="form-control ltr" name="postal_code" value="<%= val('postal_code') %>" inputmode="numeric" data-digits maxlength="10"></div>
      <div class="col-md-4"><label class="form-label">تلفن ثابت</label><input class="form-control ltr" name="home_phone" value="<%= val('home_phone') %>" inputmode="tel" data-digits></div>
      <div class="col-md-4"><label class="form-label">ایمیل</label><input class="form-control ltr" name="email" type="email" value="<%= val('email') %>"></div>
      <% if (enabled('admissions.attachments')) { %><div class="col-md-4"><label class="form-label">پیوست (تصویر شناسنامه یا کارنامه)</label><input class="form-control" type="file" name="file" accept="image/*,.pdf"><div class="form-text">تصویر یا PDF تا ۵ مگابایت</div></div><% } %>
      <div class="col-12"><label class="form-label">توضیحات / نیازهای ویژه</label><textarea class="form-control" name="notes" rows="2" maxlength="1000"><%= val('notes') %></textarea></div>
    </div>
    <div class="row g-3 align-items-end">
      <div class="col-md-4"><label class="form-label">سؤال امنیتی: <strong class="text-brand"><%= J.toPersianDigits(captcha.a) %> + <%= J.toPersianDigits(captcha.b) %> = ؟</strong></label><input class="form-control ltr" name="captcha" inputmode="numeric" data-digits required autocomplete="off"></div>
      <div class="col-md-8"><div class="form-check"><input class="form-check-input" type="checkbox" name="accept" value="1" id="accept" required <%= data.accept ? 'checked' : '' %>><label class="form-check-label fs-7" for="accept">صحت اطلاعات واردشده را تأیید می‌کنم و می‌دانم ثبت این فرم به‌منزلهٔ ثبت‌نام قطعی نیست.</label></div></div>
    </div>
  </div>
  <div class="card-footer bg-transparent d-flex justify-content-between align-items-center"><span class="fs-7 text-secondary"><i class="bi bi-shield-lock me-1"></i>اطلاعات شما فقط برای فرایند پذیرش استفاده می‌شود.</span><button class="btn btn-primary px-4"><i class="bi bi-send me-1"></i>ثبت درخواست</button></div>
</form>
