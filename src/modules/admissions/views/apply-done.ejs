<div class="card"><div class="card-body text-center py-4">
  <i class="bi bi-check-circle-fill text-success" style="font-size:3rem"></i>
  <h5 class="mt-3">درخواست شما ثبت شد</h5>
  <p class="text-secondary fs-7">کد رهگیری خود را یادداشت کنید<%= sms ? '؛ همچنین به شمارهٔ موبایل پدر/سرپرست پیامک شد' : '' %>.</p>
  <div class="display-6 fw-bold ltr my-3" style="letter-spacing:2px"><%= code %></div>
  <% if (docs) { %><div class="alert alert-light border fs-7 text-start"><strong>مدارک لازم برای ثبت‌نام قطعی:</strong> <%= docs %></div><% } %>
  <div class="d-flex gap-2 justify-content-center">
    <% if (enabled('admissions.tracking')) { %><a href="/admissions/track?code=<%= encodeURIComponent(code) %>" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>پیگیری وضعیت</a><% } %>
    <a href="/admissions/apply" class="btn btn-light btn-sm">ثبت درخواست دیگر</a>
  </div>
</div></div>
