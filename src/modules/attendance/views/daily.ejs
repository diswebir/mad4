<% if (!print) { %><%- include('partials/page-header', { title: 'گزارش روزانهٔ مدرسه', subtitle: J.formatLong(date), icon: 'bi-file-earmark-text', breadcrumbs: [{ title: 'حضور و غیاب', href: '/attendance' }, { title: 'گزارش روزانه' }], actions: [{ href: '/attendance/report/daily?date=' + date + '&print=1', label: 'چاپ', icon: 'bi-printer', class: 'btn-light', target: '_blank' }] }) %>
<div class="card mb-3"><div class="card-body py-2"><%- include('_datenav', { date: date }) %></div></div><% } else { %><h5>گزارش روزانهٔ حضور و غیاب — <%= J.formatLong(date) %></h5><% } %>
<% var tot = { c: 0, present: 0, absent: 0, late: 0 }; classes.forEach(function (c) { var s = stats[c.id] || {}; Object.keys(s).forEach(function (k) { tot.c += s[k]; }); tot.present += (s.present || 0) + (s.late || 0); tot.absent += s.absent || 0; tot.late += s.late || 0; }); %>
<div class="row g-3 mb-3">
  <div class="col-3"><div class="card stat-card text-primary"><div class="card-body"><div class="value"><%= J.toPersianDigits(tot.c) %></div><div class="label">ثبت‌شده</div></div></div></div>
  <div class="col-3"><div class="card stat-card text-success"><div class="card-body"><div class="value"><%= J.toPersianDigits(tot.present) %></div><div class="label">حاضر</div></div></div></div>
  <div class="col-3"><div class="card stat-card text-danger"><div class="card-body"><div class="value"><%= J.toPersianDigits(tot.absent) %></div><div class="label">غایب</div></div></div></div>
  <div class="col-3"><div class="card stat-card text-warning"><div class="card-body"><div class="value"><%= J.toPersianDigits(tot.late) %></div><div class="label">تأخیر</div></div></div></div>
</div>
<div class="row g-3">
  <div class="col-lg-5"><div class="card table-card"><div class="card-header"><h6>وضعیت کلاس‌ها</h6></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>کلاس</th><th>ثبت</th><th>غایب</th><th>تأخیر</th><th></th></tr></thead><tbody><% classes.forEach(function (c) { var s = stats[c.id]; %><tr><td><%= c.title %><div class="fs-7 text-secondary"><%= c.teacher_name || '' %></div></td><td><%- s ? '<span class="badge badge-soft-success">✓</span>' : '<span class="badge badge-soft-secondary">—</span>' %></td><td class="text-danger"><%= s ? J.toPersianDigits(s.absent || 0) : '' %></td><td class="text-warning"><%= s ? J.toPersianDigits(s.late || 0) : '' %></td><td class="no-print"><% if (!s && !print) { %><a href="/attendance/take?class_id=<%= c.id %>&date=<%= date %>" class="btn btn-sm btn-light py-0">ثبت</a><% } %></td></tr><% }); %></tbody></table></div></div></div>
  <div class="col-lg-7"><div class="card table-card"><div class="card-header"><h6>غایبان و تأخیرها (<%= J.toPersianDigits(absentees.length) %>)</h6></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>کلاس</th><th>دانش‌آموز</th><th>وضعیت</th><th>تماس ولی</th><th>توضیح</th></tr></thead><tbody><% absentees.forEach(function (a) { %><tr><td><%= a.class_title %></td><td><a href="/students/<%= a.id %>"><%= a.first_name %> <%= a.last_name %></a></td><td><%- utils.attBadge(a.status) %><%= a.minutes_late ? ' ' + J.toPersianDigits(a.minutes_late) + "'" : '' %></td><td class="ltr text-end fs-7"><%= J.toPersianDigits(a.father_phone || a.mother_phone || '') %></td><td class="fs-7"><%= a.note || '' %></td></tr><% }); if (!absentees.length) { %><tr><td colspan="5" class="text-center text-secondary py-3">غایبی ثبت نشده است</td></tr><% } %></tbody></table></div></div></div>
</div>
