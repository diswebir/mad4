<%- include('partials/page-header', { title: 'هشدار غیبت‌های مکرر', subtitle: 'دانش‌آموزان با ' + J.toPersianDigits(threshold) + ' غیبت یا بیشتر از ' + J.formatDate(from) + ' تاکنون', icon: 'bi-exclamation-triangle', breadcrumbs: [{ title: 'حضور و غیاب', href: '/attendance' }, { title: 'هشدارها' }] }) %>
<div class="row g-3">
  <div class="col-lg-7"><div class="card table-card"><div class="card-header"><h6 class="text-danger"><i class="bi bi-person-x me-1"></i>غیبت مکرر (<%= J.toPersianDigits(rows.length) %>)</h6></div>
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>دانش‌آموز</th><th>کلاس</th><th>غیبت</th><th>آخرین</th><th>تماس ولی</th><th></th></tr></thead><tbody><% rows.forEach(function (r) { %><tr><td><a href="/students/<%= r.id %>" class="d-flex align-items-center gap-2 fw-semibold"><%- include('partials/avatar', { user: { name: r.first_name + ' ' + r.last_name, avatar: r.photo }, size: 30 }) %><%= r.first_name %> <%= r.last_name %></a></td><td><a href="/academic/classes/<%= r.class_id %>"><%= r.class_title %></a></td><td><span class="badge text-bg-danger"><%= J.toPersianDigits(r.absences) %></span></td><td class="fs-7"><%= J.formatDate(r.last_date) %></td><td class="ltr text-end fs-7"><%= J.toPersianDigits(r.father_phone || r.mother_phone || '') %></td><td class="text-end"><a href="/attendance/report/student/<%= r.id %>" class="btn btn-sm btn-light" aria-label="گزارش" title="گزارش"><i class="bi bi-graph-up"></i></a><% if (enabled('tickets') && (currentUser.role === 'admin' || can('attendance.view_all') || can('tickets.manage'))) { %> <a href="/tickets/new?student_id=<%= r.id %>&subject=<%= encodeURIComponent('پیگیری غیبت‌های مکرر') %>" class="btn btn-sm btn-light" aria-label="پیام" title="پیام"><i class="bi bi-chat-left-text"></i></a><% } %></td></tr><% }); if (!rows.length) { %><tr><td colspan="6" class="text-center text-secondary py-4">موردی یافت نشد 🎉</td></tr><% } %></tbody></table></div></div></div>
  <div class="col-lg-5"><div class="card table-card"><div class="card-header"><h6 class="text-warning"><i class="bi bi-clock-history me-1"></i>تأخیر مکرر</h6></div>
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>دانش‌آموز</th><th>کلاس</th><th>تأخیر</th></tr></thead><tbody><% lates.forEach(function (r) { %><tr><td><a href="/students/<%= r.id %>"><%= r.first_name %> <%= r.last_name %></a></td><td><%= r.class_title %></td><td><span class="badge text-bg-warning"><%= J.toPersianDigits(r.lates) %></span></td></tr><% }); if (!lates.length) { %><tr><td colspan="3" class="text-center text-secondary py-4">موردی یافت نشد</td></tr><% } %></tbody></table></div></div></div>
</div>
