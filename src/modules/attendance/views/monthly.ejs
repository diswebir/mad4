<% var pm = jm === 1 ? 12 : jm - 1, py = jm === 1 ? jy - 1 : jy, nm = jm === 12 ? 1 : jm + 1, ny = jm === 12 ? jy + 1 : jy; var sym = { present: '●', absent: 'غ', late: 'ت', excused: 'م', leave: 'خ' }; %>
<% if (!print) { %><%- include('partials/page-header', { title: 'دفتر حضور ماهانه', subtitle: cls ? cls.title + ' — ' + J.MONTHS[jm - 1] + ' ' + J.toPersianDigits(jy) : '', icon: 'bi-calendar3', breadcrumbs: [{ title: 'حضور و غیاب', href: '/attendance' }, { title: 'دفتر ماهانه' }], actions: cls ? [{ href: '/attendance/report/monthly?class_id=' + classId + '&jy=' + jy + '&jm=' + jm + '&print=1', label: 'چاپ', icon: 'bi-printer', class: 'btn-light', target: '_blank' }] : [] }) %>
<form method="get" class="card mb-3" data-auto-submit><div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
  <select class="form-select form-select-sm w-auto" name="class_id"><% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= c.id === classId ? 'selected' : '' %>><%= c.title %></option><% }); %></select>
  <select class="form-select form-select-sm w-auto" name="jm"><% J.MONTHS.forEach(function (m, i) { %><option value="<%= i + 1 %>" <%= i + 1 === jm ? 'selected' : '' %>><%= m %></option><% }); %></select>
  <select class="form-select form-select-sm w-auto" name="jy"><% for (var y = jy - 2; y <= jy + 1; y++) { %><option value="<%= y %>" <%= y === jy ? 'selected' : '' %>><%= J.toPersianDigits(y) %></option><% } %></select>
  <a class="btn btn-sm btn-light" href="?class_id=<%= classId %>&jy=<%= py %>&jm=<%= pm %>">ماه قبل</a><a class="btn btn-sm btn-light" href="?class_id=<%= classId %>&jy=<%= ny %>&jm=<%= nm %>">ماه بعد</a>
  <span class="fs-7 text-secondary ms-auto">● حاضر · غ غایب · ت تأخیر · م موجه · خ مرخصی</span></div></form>
<% } else { %><h5>دفتر حضور و غیاب <%= cls ? cls.title : '' %> — <%= J.MONTHS[jm - 1] %> <%= J.toPersianDigits(jy) %></h5><div class="fs-7 mb-2">● حاضر · غ غایب · ت تأخیر · م موجه · خ مرخصی</div><% } %>
<% if (cls) { %>
<div class="card"><div class="table-responsive"><table class="table table-bordered table-sm mb-0 monthly-grid text-center" style="font-size:11px">
  <thead><tr><th class="text-start" style="min-width:140px">دانش‌آموز</th><% dayInfo.forEach(function (d) { %><th class="<%= d.holiday ? 'bg-danger-subtle text-danger' : d.school ? '' : 'bg-light text-muted' %>" title="<%= J.WEEKDAYS[d.wd] %><%= d.holiday ? ' — تعطیل: ' + d.holiday : '' %>"><%= J.toPersianDigits(d.d) %><div style="font-size:9px"><%= J.WEEKDAYS_SHORT[d.wd] %></div></th><% }); %><th>غ</th><th>ت</th></tr></thead>
  <tbody><% students.forEach(function (s) { var g = grid[s.id] || {}; var ab = 0, la = 0; %>
    <tr><td class="text-start text-nowrap"><a href="/students/<%= s.id %>"><%= s.first_name %> <%= s.last_name %></a></td>
    <% dayInfo.forEach(function (d) { var st = g[d.d]; if (st === 'absent') ab++; if (st === 'late') la++; %><td class="<%= st ? 'cell-' + st : (d.holiday ? 'bg-danger-subtle' : d.school ? '' : 'bg-light') %>" <%- d.holiday ? 'title="تعطیل: ' + d.holiday + '"' : '' %>><%= st ? sym[st] : '' %></td><% }); %>
    <td class="fw-bold text-danger"><%= J.toPersianDigits(ab) %></td><td class="fw-bold text-warning"><%= J.toPersianDigits(la) %></td></tr>
  <% }); %></tbody></table></div></div>
<% } else { %><%- include('partials/empty', { message: 'کلاسی انتخاب نشده است' }) %><% } %>
