<%- include('partials/page-header', { title: 'ارسال اعلان', subtitle: 'ارسال اعلان درون‌برنامه‌ای (و در صورت فعال‌بودن، پیامک/ایمیل) به گروهی از کاربران', icon: 'bi-megaphone' }) %>
<div class="row justify-content-center"><div class="col-lg-8"><form method="post" action="/notifications/send" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body"><div class="row g-3">
    <div class="col-md-4"><label class="form-label">مخاطب</label><select class="form-select" name="audience" id="aud"><option value="all">همهٔ کاربران</option><option value="role">یک نقش</option><option value="class">دانش‌آموزان یک کلاس</option><option value="user">یک کاربر</option></select></div>
    <div class="col-md-4 aud aud-role d-none"><label class="form-label">نقش</label><select class="form-select" name="role"><% Object.entries(ROLES).forEach(function (r) { %><option value="<%= r[0] %>"><%= r[1] %></option><% }); %></select></div>
    <div class="col-md-4 aud aud-class d-none"><label class="form-label">کلاس</label><select class="form-select" name="class_id"><% classes.forEach(function (c) { %><option value="<%= c.id %>"><%= c.title %></option><% }); %></select></div>
    <div class="col-md-8 aud aud-user d-none"><label class="form-label">کاربر</label><select class="form-select" name="user_id"><% users.forEach(function (u) { %><option value="<%= u.id %>"><%= u.name %> (<%= ROLES[u.role] || u.role %> — <%= u.username %>)</option><% }); %></select></div>
    <div class="col-md-8"><label class="form-label required">عنوان</label><input class="form-control" name="title" required maxlength="200"></div>
    <div class="col-md-4"><label class="form-label">نوع</label><select class="form-select" name="type"><option value="info">اطلاع</option><option value="success">موفقیت</option><option value="warning">هشدار</option><option value="danger">مهم</option></select></div>
    <div class="col-12"><label class="form-label">متن</label><textarea class="form-control" name="body" rows="3"></textarea></div>
    <div class="col-md-6"><label class="form-label">پیوند داخلی (اختیاری)</label><input class="form-control ltr" name="link" placeholder="/announcements/1"></div>
    <div class="col-md-6 d-flex align-items-end gap-3"><label class="form-check"><input type="checkbox" class="form-check-input" name="sms" value="1" <%= smsOn ? '' : 'disabled' %>> ارسال پیامک<% if (!smsOn) { %> <span class="fs-7 text-secondary">(غیرفعال)</span><% } %></label><label class="form-check"><input type="checkbox" class="form-check-input" name="email" value="1" <%= emailOn ? '' : 'disabled' %>> ارسال ایمیل<% if (!emailOn) { %> <span class="fs-7 text-secondary">(غیرفعال)</span><% } %></label></div>
  </div></div>
  <div class="card-footer bg-transparent text-end"><button class="btn btn-primary px-4"><i class="bi bi-send me-1"></i>ارسال</button></div>
</form></div></div>
<script>(function(){var a=document.getElementById('aud');function u(){document.querySelectorAll('.aud').forEach(function(e){e.classList.add('d-none')});var e=document.querySelector('.aud-'+a.value);if(e)e.classList.remove('d-none');}a.addEventListener('change',u);u();})();</script>
