<%- include('partials/page-header', { title: title, icon: 'bi-shield-check', breadcrumbs: [{ title: 'کاربران', href: '/users' }, { title: 'سمت‌ها', href: '/users/positions' }, { title: isNew ? 'افزودن' : 'ویرایش' }] }) %>
<form method="post" action="<%= isNew ? '/users/positions' : '/users/positions/' + pos.id %>" class="card" style="max-width:1100px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <div class="row g-3 mb-3">
      <div class="col-md-4"><label class="form-label required" for="f_title">عنوان سمت</label><input class="form-control" name="title" value="<%= pos.title %>" required id="f_title"></div>
      <div class="col-md-8"><label class="form-label" for="f_description">توضیح</label><input class="form-control" name="description" value="<%= pos.description || '' %>" id="f_description"></div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-2"><h6 class="mb-0">مجوزها</h6><div class="fs-7"><a href="#" onclick="document.querySelectorAll('.pp').forEach(function(c){c.checked=true});return false">انتخاب همه</a> · <a href="#" onclick="document.querySelectorAll('.pp').forEach(function(c){c.checked=false});return false">هیچ‌کدام</a></div></div>
    <div class="row g-3">
      <% GROUPS.forEach(function (g) { %>
      <div class="col-md-6"><div class="border rounded p-3 h-100"><div class="fw-bold mb-2 d-flex justify-content-between"><span><%= g.title %></span><a href="#" class="fs-7 fw-normal" onclick="this.closest('.border').querySelectorAll('.pp').forEach(function(c){c.checked=!c.checked});return false">وارونه</a></div>
        <% g.items.forEach(function (it) { %><label class="form-check fs-7 mb-1"><input type="checkbox" class="form-check-input pp" name="perms[]" value="<%= it[0] %>" <%= pos.perms.indexOf(it[0]) >= 0 ? 'checked' : '' %> aria-label="مجوز"> <%= it[1] %> <code class="text-muted">(<%= it[0] %>)</code></label><% }) %>
      </div></div>
      <% }) %>
    </div>
    <% if (!isNew && typeof users !== 'undefined' && users.length) { %><hr><div class="fs-7 text-muted mb-1">کاربران دارای این سمت:</div><div class="d-flex flex-wrap gap-1"><% users.forEach(function (u) { %><a href="/users/<%= u.id %>/edit" class="badge text-bg-light text-decoration-none"><%= u.name %> (<%= u.username %>)</a><% }) %></div><% } %>
  </div>
  <div class="card-footer bg-transparent d-flex gap-2 justify-content-end"><a href="/users/positions" class="btn btn-light">انصراف</a><button class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>ذخیره</button></div>
</form>
