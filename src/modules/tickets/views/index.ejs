<% var total = Object.values(counts).reduce(function (a, b) { return a + b; }, 0); var canCreate = currentUser.role !== 'teacher' || enabled('tickets.teacher_create'); %>
<%- include('partials/page-header', { title: 'تیکت‌ها', subtitle: isStaff ? 'مرکز پشتیبانی و ارتباط با دانش‌آموزان و اولیا' : 'ارتباط با مدیریت و معلم', icon: 'bi-chat-left-text', actions: [
  ...(canCreate ? [{ href: '/tickets/new', label: 'تیکت جدید', icon: 'bi-plus-lg', class: 'btn-primary' }] : []),
  ...(isStaff && enabled('tickets.stats') ? [{ href: '/tickets/stats', label: 'آمار', icon: 'bi-bar-chart', class: 'btn-light' }] : []),
  ...(currentUser.role !== 'student' && enabled('tickets.canned') ? [{ href: '/tickets/canned', label: 'پاسخ‌های آماده', icon: 'bi-card-text', class: 'btn-light' }] : []),
  ...(isStaff && enabled('tickets.export') ? [{ href: '/tickets/export', label: 'CSV', icon: 'bi-filetype-csv', class: 'btn-light' }] : [])
] }) %>
<% if (overdue && overdue.length) { %>
<div class="alert alert-danger d-flex align-items-start gap-2"><i class="bi bi-hourglass-split fs-5"></i><div class="flex-grow-1"><strong><%= J.toPersianDigits(slaCounts.overdue.length) %> تیکت از مهلت پاسخ (SLA) خارج شده است</strong> <a href="?sla=overdue" class="ms-2 fs-7">مشاهده همه</a>
  <ul class="mb-0 mt-1 fs-7"><% overdue.forEach(function (t) { %><li><a href="/tickets/<%= t.id %>"><%= t.code %> — <%= t.subject %></a> <span class="text-secondary">(<%= t.creator_name %> · <%- utils.priorityBadge(t.priority) %> · <%= t.sla.label %>)</span></li><% }); %></ul></div></div>
<% } %>
<% if (isStaff && slaCounts && enabled('tickets.sla')) { %>
<div class="d-flex flex-wrap gap-2 mb-3 fs-7 align-items-center"><span class="text-secondary"><i class="bi bi-stopwatch me-1"></i>مهلت پاسخ:</span>
  <a href="?sla=overdue" class="badge rounded-pill text-bg-<%= f.sla === 'overdue' ? 'danger' : 'light' %> text-decoration-none border"><i class="bi bi-exclamation-circle me-1 text-danger"></i>خارج از مهلت <%= J.toPersianDigits(slaCounts.overdue.length) %></a>
  <a href="?sla=warning" class="badge rounded-pill text-bg-<%= f.sla === 'warning' ? 'warning' : 'light' %> text-decoration-none border"><i class="bi bi-hourglass-split me-1 text-warning"></i>نزدیک مهلت <%= J.toPersianDigits(slaCounts.warning.length) %></a>
  <span class="badge rounded-pill text-bg-light border"><i class="bi bi-check-circle me-1 text-success"></i>در مهلت <%= J.toPersianDigits(slaCounts.ok.length) %></span>
  <% if (f.sla) { %><a href="?" class="badge rounded-pill text-bg-secondary text-decoration-none">حذف فیلتر</a><% } %>
  <span class="text-secondary ms-auto">پاسخ اول: عادی <%= J.toPersianDigits(slaHours) %> ساعت</span>
</div>
<% } %>
<ul class="nav nav-pills mb-3 flex-wrap gap-1">
  <li class="nav-item"><a class="nav-link <%= !f.status ? 'active' : '' %>" href="?">همه <span class="badge rounded-pill text-bg-light"><%= J.toPersianDigits(total) %></span></a></li>
  <% Object.keys(STATUSES).forEach(function (k) { %><li class="nav-item"><a class="nav-link <%= f.status === k ? 'active' : '' %>" href="?status=<%= k %>"><%= STATUSES[k] %> <span class="badge rounded-pill text-bg-light"><%= J.toPersianDigits(counts[k] || 0) %></span></a></li><% }); %>
  <% if (isStaff) { %><li class="nav-item ms-auto"><a class="nav-link <%= f.mine === '1' ? 'active' : '' %>" href="?mine=1"><i class="bi bi-person-check me-1"></i>ارجاع به من</a></li><li class="nav-item"><a class="nav-link <%= f.mine === 'unassigned' ? 'active' : '' %>" href="?mine=unassigned"><i class="bi bi-person-dash me-1"></i>بدون مسئول</a></li><% } %>
</ul>
<form method="get" class="card mb-3"><div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
  <input type="hidden" name="status" value="<%= f.status %>"><input type="hidden" name="mine" value="<%= f.mine %>"><% if (f.sla) { %><input type="hidden" name="sla" value="<%= f.sla %>"><% } %>
  <input class="form-control form-control-sm" style="max-width:260px" name="q" value="<%= f.q %>" placeholder="جستجو: کد، موضوع، نام…">
  <% if (enabled('tickets.categories')) { %><select class="form-select form-select-sm w-auto" name="category" data-auto-submit aria-label="دسته"><option value="">همهٔ دسته‌ها</option><% Object.keys(CATEGORIES).forEach(function (k) { %><option value="<%= k %>" <%= f.category === k ? 'selected' : '' %>><%= CATEGORIES[k] %></option><% }); %></select><% } %>
  <% if (enabled('tickets.priority')) { %><select class="form-select form-select-sm w-auto" name="priority" data-auto-submit aria-label="اولویت"><option value="">همهٔ اولویت‌ها</option><% Object.keys(utils.PRIORITIES).forEach(function (k) { %><option value="<%= k %>" <%= f.priority === k ? 'selected' : '' %>><%= utils.PRIORITIES[k] %></option><% }); %></select><% } %>
  <button class="btn btn-sm btn-primary" aria-label="جستجو" title="جستجو"><i class="bi bi-search"></i></button>
  <% if (f.q || f.category || f.priority) { %><a href="?status=<%= f.status %>" class="btn btn-sm btn-light">پاک کردن</a><% } %>
</div></form>
<div class="card table-card">
  <div class="table-responsive"><table class="table table-hover align-middle mb-0">
    <thead><tr><th>کد</th><th>موضوع</th><% if (currentUser.role !== 'student') { %><th>ایجادکننده</th><% } %><% if (enabled('tickets.categories')) { %><th>دسته</th><% } %><% if (enabled('tickets.priority')) { %><th>اولویت</th><% } %><th>وضعیت</th><% if (isStaff && enabled('tickets.assign')) { %><th>مسئول</th><% } %><th>آخرین پاسخ</th><% if (isStaff && enabled('tickets.sla')) { %><th>مهلت پاسخ</th><% } %></tr></thead>
    <tbody><% result.data.forEach(function (t) { var unread = (currentUser.role === 'student' && t.status === 'answered') || (currentUser.role !== 'student' && t.status === 'open'); %>
      <tr class="<%= unread ? 'fw-semibold' : '' %>">
        <td><a href="/tickets/<%= t.id %>" class="ltr d-inline-block font-monospace fs-7"><%= t.code %></a></td>
        <td><a href="/tickets/<%= t.id %>" class="text-body"><%= t.subject %></a><% if (t.replies_count > 1) { %> <span class="badge badge-soft-secondary fw-normal"><i class="bi bi-chat"></i> <%= J.toPersianDigits(t.replies_count) %></span><% } %><% if (t.rating) { %> <span class="text-warning fs-7"><i class="bi bi-star-fill"></i> <%= J.toPersianDigits(t.rating) %></span><% } %></td>
        <% if (currentUser.role !== 'student') { %><td><div class="d-flex align-items-center gap-2"><%- include('partials/avatar', { user: { name: t.creator_name, avatar: t.creator_avatar }, size: 26 }) %><div><div class="fs-7"><%= t.creator_name || 'کاربر حذف‌شده' %></div><% if (t.class_title) { %><div class="text-secondary" style="font-size:.7rem"><%= t.class_title %></div><% } %></div></div></td><% } %>
        <% if (enabled('tickets.categories')) { %><td class="fs-7"><%= CATEGORIES[t.category] || t.category || '—' %></td><% } %>
        <% if (enabled('tickets.priority')) { %><td><%- utils.priorityBadge(t.priority) %></td><% } %>
        <td><%- include('_status', { status: t.status }) %></td>
        <% if (isStaff && enabled('tickets.assign')) { %><td class="fs-7"><%= t.assignee_name || '—' %></td><% } %>
        <td class="fs-7 text-secondary text-nowrap" title="<%= J.formatDateTime(t.last_reply_at) %>"><%= J.timeAgo(t.last_reply_at) %></td>
        <% if (isStaff && enabled('tickets.sla')) { %><td class="text-nowrap"><% if (t.sla && t.sla.state !== 'na') { %><span class="badge badge-soft-<%= t.sla.badge %>" title="مهلت: <%= t.sla.targetLabel %> · سررسید <%= J.formatDateTime(t.sla.dueAt) %>"><i class="bi <%= t.sla.state === 'overdue' ? 'bi-exclamation-circle' : t.sla.state === 'warning' ? 'bi-hourglass-split' : 'bi-check-circle' %> me-1"></i><%= t.sla.label %></span><% } else if (t.sla && t.sla.resolveOverdue) { %><span class="badge badge-soft-secondary" title="بیش از <%= J.toPersianDigits(t.sla.resolveDays) %> روز حل‌نشده"><i class="bi bi-clock-history me-1"></i><%= J.toPersianDigits(t.sla.resolveElapsedDays) %> روز باز</span><% } else { %><span class="text-secondary">—</span><% } %></td><% } %>
      </tr><% }); if (!result.data.length) { %><tr><td colspan="10"><%- include('partials/empty', { message: 'تیکتی وجود ندارد', icon: 'bi-chat-left', action: canCreate ? { href: '/tickets/new', label: 'ثبت تیکت جدید' } : null }) %></td></tr><% } %></tbody>
  </table></div>
  <%- include('partials/pagination', { result: result, query: query }) %>
</div>
