<%- include('partials/page-header', { title: 'پاسخ‌های آماده', subtitle: 'الگوهایی که هنگام پاسخ به تیکت با یک کلیک درج می‌شوند', icon: 'bi-card-text', breadcrumbs: [{ title: 'تیکت‌ها', href: '/tickets' }, { title: 'پاسخ‌های آماده' }] }) %>
<div class="row g-3">
  <div class="col-lg-5"><form method="post" action="/tickets/canned" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="card-header"><h6>افزودن پاسخ آماده</h6></div><div class="card-body">
    <div class="mb-3"><label class="form-label required" for="f_title">عنوان</label><input class="form-control" name="title" required maxlength="80" id="f_title"></div>
    <div class="mb-3"><label class="form-label required" for="f_body">متن</label><textarea class="form-control" name="body" rows="5" required id="f_body"></textarea></div>
    <% if (currentUser.role === 'admin' || can('tickets.assign')) { %><label class="form-check fs-7"><input class="form-check-input" type="checkbox" name="shared" value="1"> در دسترس همهٔ کارکنان و معلمان</label><% } %>
  </div><div class="card-footer bg-transparent text-end"><button class="btn btn-primary">ذخیره</button></div></form></div>
  <div class="col-lg-7"><div class="card table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>عنوان</th><th>متن</th><th>مالک</th><th></th></tr></thead><tbody>
    <% rows.forEach(function (r) { %><tr><td class="fw-semibold"><%= r.title %></td><td class="fs-7 text-secondary"><%= utils.truncate(r.body, 120) %></td><td class="fs-7"><%= r.user_id ? (r.owner || '') : 'عمومی' %></td><td class="text-end"><% if (r.user_id === currentUser.id || currentUser.role === 'admin' || can('tickets.assign')) { %><a href="#" data-post="/tickets/canned/<%= r.id %>/delete" data-confirm="حذف شود؟" class="btn btn-sm btn-light text-danger" aria-label="حذف" title="حذف"><i class="bi bi-trash"></i></a><% } %></td></tr><% }); if (!rows.length) { %><tr><td colspan="4"><%- include('partials/empty', { message: 'پاسخ آماده‌ای ثبت نشده' }) %></td></tr><% } %>
  </tbody></table></div></div></div>
</div>
