<%- include('partials/page-header', { title: 'تیکت جدید', icon: 'bi-plus-circle', breadcrumbs: [{ title: 'تیکت‌ها', href: '/tickets' }, { title: 'جدید' }] }) %>
<% var old = typeof oldInput !== 'undefined' && oldInput ? oldInput : {}; var val = function (k) { return old[k] !== undefined ? old[k] : (prefill[k] || ''); }; %>
<div class="row justify-content-center"><div class="col-lg-8">
<form method="post" action="/tickets" enctype="multipart/form-data" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <% if (student) { %><div class="alert alert-light border d-flex align-items-center gap-2 fs-7"><i class="bi bi-info-circle"></i><span>تیکت از طرف <strong><%= student.first_name %> <%= student.last_name %></strong><%= student.class_title ? ' — کلاس ' + student.class_title : '' %> ثبت می‌شود.</span></div><% } %>
    <div class="row g-3">
      <% if (currentUser.role === 'parent' && typeof children !== 'undefined' && children.length > 1) { %><div class="col-md-6"><label class="form-label" for="f_student_id">دربارهٔ فرزند</label><select class="form-select" name="student_id" id="f_student_id"><% children.forEach(function (k) { %><option value="<%= k.id %>" <%= student && student.id === k.id ? 'selected' : '' %>><%= k.first_name %> <%= k.last_name %><%= k.class_title ? ' — ' + k.class_title : '' %></option><% }) %></select></div><% } %>
      <% if (currentUser.role === 'student' || currentUser.role === 'parent') { %>
      <div class="col-md-6"><label class="form-label required" for="f_department">گیرنده</label><select class="form-select" name="department" id="f_department"><% var _studentLike = currentUser.role === 'student' || currentUser.role === 'parent'; if (!_studentLike || S.get('allow_student_tickets_to_admin', '1') !== '0') { %><option value="admin">مدیریت مدرسه</option><% } %><% if (student && student.homeroom_teacher_id) { %><option value="teacher" <%= val('department') === 'teacher' ? 'selected' : '' %>>معلم کلاس (<%= student.class_title %>)</option><% } %><option value="staff" <%= val('department') === 'staff' ? 'selected' : '' %>>دفتر / امور اداری</option></select></div>
      <% } else if (isStaff) { %>
      <div class="col-md-6"><label class="form-label" for="f_student_id">دربارهٔ دانش‌آموز</label><select class="form-select" name="student_id" id="f_student_id"><option value="">— هیچ‌کدام —</option><% students.forEach(function (s) { %><option value="<%= s.id %>" <%= String(val('student_id')) === String(s.id) ? 'selected' : '' %>><%= s.first_name %> <%= s.last_name %> (<%= s.class_title || '—' %>)</option><% }); %></select></div>
      <% if (enabled('tickets.assign')) { %><div class="col-md-6"><label class="form-label" for="f_assigned_to">ارجاع به</label><select class="form-select" name="assigned_to" id="f_assigned_to"><option value="">— بعداً —</option><% teachers.forEach(function (u) { %><option value="<%= u.id %>" <%= String(val('assigned_to')) === String(u.id) ? 'selected' : '' %>><%= u.name %> (<%= utils.ROLES[u.role] %>)</option><% }); %></select></div><% } %>
      <% } else { %>
      <div class="col-md-6"><label class="form-label">گیرنده</label><input class="form-control" value="مدیریت مدرسه" disabled></div>
      <% } %>
      <% if (enabled('tickets.categories')) { %><div class="col-md-6"><label class="form-label" for="f_category">دسته‌بندی</label><select class="form-select" name="category" id="f_category"><% Object.keys(CATEGORIES).forEach(function (k) { %><option value="<%= k %>" <%= val('category') === k ? 'selected' : '' %>><%= CATEGORIES[k] %></option><% }); %></select></div><% } %>
      <% if (enabled('tickets.priority')) { %><div class="col-md-6"><label class="form-label" for="f_priority">اولویت</label><select class="form-select" name="priority" id="f_priority"><% Object.keys(utils.PRIORITIES).forEach(function (k) { %><option value="<%= k %>" <%= (val('priority') || 'normal') === k ? 'selected' : '' %>><%= utils.PRIORITIES[k] %></option><% }); %></select></div><% } %>
      <div class="col-12"><label class="form-label required" for="f_subject">موضوع</label><input class="form-control" name="subject" required maxlength="150" value="<%= val('subject') %>" placeholder="خلاصهٔ درخواست در یک جمله" id="f_subject"></div>
      <div class="col-12"><label class="form-label required" for="f_message">متن پیام</label><textarea class="form-control" name="message" rows="6" required placeholder="شرح کامل درخواست یا سؤال…" id="f_message"><%= val('message') %></textarea></div>
      <% if (enabled('tickets.attachments')) { %><div class="col-12"><label class="form-label" for="f_file">پیوست (تصویر یا PDF، حداکثر ۵ مگابایت)</label><input type="file" class="form-control" name="file" accept="image/*,.pdf,.doc,.docx" id="f_file"></div><% } %>
    </div>
  </div>
  <div class="card-footer bg-transparent d-flex justify-content-between"><a href="/tickets" class="btn btn-light">انصراف</a><button class="btn btn-primary px-4"><i class="bi bi-send me-1"></i>ارسال تیکت</button></div>
</form></div></div>
