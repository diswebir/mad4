<%- include('partials/page-header', { title: 'امانت‌های دیرکرده', icon: 'bi-exclamation-circle', breadcrumbs: [{ title: 'کتابخانه', href: '/library' }, { title: 'دیرکردها' }], actions: [...(currentUser.role !== 'teacher' && rows.length ? [{ post: '/library/overdue/remind', label: 'ارسال یادآوری به همه', icon: 'bi-bell', class: 'btn-warning' }] : []), { print: true, label: 'چاپ', icon: 'bi-printer', class: 'btn-light' }] }) %>
<div class="card table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>کتاب</th><th>امانت‌گیرنده</th><th>تاریخ امانت</th><th>مهلت</th><th>دیرکرد</th><% if (currentUser.role !== 'teacher') { %><th></th><% } %></tr></thead><tbody>
<% rows.forEach(function (l) { %><tr><td class="fw-semibold"><%= l.book_title %></td><td><% if (l.student_id) { %><a href="/students/<%= l.student_id %>" class="text-body"><%= l.first_name %> <%= l.last_name %></a> <span class="fs-7 text-secondary"><%= l.class_title || '' %></span><% } else { %><%= l.user_name %> <span class="fs-7 text-secondary">(همکار)</span><% } %></td><td><%= J.formatDate(l.loaned_at) %></td><td class="text-danger"><%= J.formatDate(l.due_at) %></td><td><span class="badge text-bg-danger"><%= J.toPersianDigits(J.diffDays(l.due_at, today)) %> روز</span></td><% if (currentUser.role !== 'teacher') { %><td class="text-end"><a href="#" data-post="/library/loans/<%= l.id %>/return" data-confirm="بازگشت ثبت شود؟" class="btn btn-sm btn-outline-success">ثبت بازگشت</a></td><% } %></tr><% }); if (!rows.length) { %><tr><td colspan="6"><%- include('partials/empty', { message: 'دیرکردی وجود ندارد', icon: 'bi-emoji-smile' }) %></td></tr><% } %>
</tbody></table></div></div>
