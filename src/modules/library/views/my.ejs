<%- include('partials/page-header', { title: 'کتابخانه', icon: 'bi-book' }) %>
<div class="card table-card mb-3"><div class="card-header"><h6><i class="bi bi-bookmark me-1"></i>امانت‌های من</h6></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>کتاب</th><th>تاریخ امانت</th><th>مهلت بازگشت</th><th>وضعیت</th></tr></thead><tbody>
<% loans.forEach(function (l) { var late = l.status === 'loaned' && l.due_at < today; %><tr><td class="fw-semibold"><%= l.book_title %> <span class="fs-7 text-secondary fw-normal"><%= l.author || '' %></span></td><td><%= J.formatDate(l.loaned_at) %></td><td class="<%= late ? 'text-danger fw-semibold' : '' %>"><%= J.formatDate(l.due_at) %><% if (late) { %> (<%= J.toPersianDigits(J.diffDays(l.due_at, today)) %> روز دیرکرد)<% } %></td><td><%- l.status === 'returned' ? utils.statusBadge('returned') + ' <span class="fs-7 text-secondary">' + J.formatDate(l.returned_at) + '</span>' : utils.statusBadge('loaned') %></td></tr><% }); if (!loans.length) { %><tr><td colspan="4" class="text-center text-secondary py-3">امانتی ثبت نشده</td></tr><% } %>
</tbody></table></div></div>
<% if (enabled('library.catalog')) { %>
<div class="card"><div class="card-header"><h6><i class="bi bi-search me-1"></i>فهرست کتاب‌ها</h6><form method="get" class="d-flex gap-2"><select class="form-select form-select-sm w-auto" name="category" data-auto-submit aria-label="دسته"><option value="">همهٔ دسته‌ها</option><% Object.entries(CATS).forEach(function (c) { %><option value="<%= c[0] %>" <%= f.category === c[0] ? 'selected' : '' %>><%= c[1] %></option><% }); %></select><input class="form-control form-control-sm" name="q" value="<%= f.q %>" placeholder="عنوان یا نویسنده…"><button class="btn btn-sm btn-light" aria-label="جستجو" title="جستجو"><i class="bi bi-search"></i></button></form></div>
<div class="card-body"><div class="row g-2"><% books.data.forEach(function (b) { %><div class="col-md-6 col-xl-4"><div class="border rounded p-2 h-100 d-flex gap-2"><div class="icon-box badge-soft-primary"><i class="bi bi-book"></i></div><div class="mw-0"><div class="fw-semibold truncate"><%= b.title %></div><div class="fs-7 text-secondary"><%= b.author || '' %><%= b.publisher ? ' · ' + b.publisher : '' %></div><div class="fs-7"><span class="badge badge-soft-secondary"><%= CATS[b.category] || '' %></span> <span class="badge <%= Number(b.available_copies) > 0 ? 'badge-soft-success' : 'badge-soft-danger' %>"><%= Number(b.available_copies) > 0 ? 'موجود' : 'در امانت' %></span><% if (b.shelf) { %> <span class="text-secondary">قفسهٔ <%= b.shelf %></span><% } %></div></div></div></div><% }); if (!books.data.length) { %><div class="col-12 text-secondary text-center py-3">کتابی یافت نشد</div><% } %></div></div>
<%- include('partials/pagination', { result: books, query: query }) %></div>
<% } %>
