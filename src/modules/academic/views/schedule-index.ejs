<%- include('partials/page-header', { title: 'برنامه هفتگی', icon: 'bi-table', breadcrumbs: [{ title: 'برنامه هفتگی' }] }) %>
<div class="row g-3">
  <div class="col-lg-7">
    <div class="card table-card">
      <div class="card-header"><h6><i class="bi bi-door-open me-1"></i>کلاس‌ها</h6></div>
      <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>کلاس</th><th>پایه</th><th>زنگ‌های تنظیم‌شده</th><th class="text-end">عملیات</th></tr></thead>
        <tbody><% classes.forEach(function (c) { %>
          <tr><td class="fw-semibold"><a href="/academic/classes/<%= c.id %>"><%= c.title %></a></td><td><%= c.grade_title %></td>
            <td><% if (Number(c.slots)) { %><span class="badge badge-soft-success"><%= J.toPersianDigits(c.slots) %> زنگ</span><% } else { %><span class="badge badge-soft-warning">تنظیم نشده</span><% } %></td>
            <td class="text-end"><a href="/academic/schedule/class/<%= c.id %>" class="btn btn-sm btn-primary"><i class="bi bi-table me-1"></i>مشاهده / ویرایش</a></td></tr>
        <% }); if (!classes.length) { %><tr><td colspan="4"><%- include('partials/empty', { message: 'کلاسی برای سال جاری تعریف نشده است' }) %></td></tr><% } %></tbody>
      </table></div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card table-card">
      <div class="card-header"><h6><i class="bi bi-person-video3 me-1"></i>معلمان</h6></div>
      <div class="table-responsive" style="max-height:600px"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>معلم</th><th>ساعت در هفته</th><th></th></tr></thead>
        <tbody><% teachers.forEach(function (t) { %>
          <tr><td><%= t.name %></td><td><%= J.toPersianDigits(t.slots) %></td><td class="text-end"><a href="/academic/schedule/teacher/<%= t.id %>" class="btn btn-sm btn-light"><i class="bi bi-table"></i></a></td></tr>
        <% }); %></tbody>
      </table></div>
    </div>
  </div>
</div>
