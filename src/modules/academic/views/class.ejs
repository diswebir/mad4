<%- include('partials/page-header', { title: 'کلاس ' + cls.title, subtitle: cls.grade_title + ' · ' + (cls.year_title || '') + (cls.room_title ? ' · ' + cls.room_title : '') + ' · شیفت ' + (cls.shift === 'afternoon' ? 'عصر' : 'صبح'), icon: 'bi-door-open', breadcrumbs: [{ title: 'کلاس‌ها', href: '/academic/classes' }, { title: cls.title }], actions: [
  ...(enabled('academic.schedule') ? [{ href: '/academic/schedule/class/' + cls.id, label: 'برنامه هفتگی', icon: 'bi-table', class: 'btn-light' }] : []),
  ...(enabled('attendance') && currentUser.role !== 'student' ? [{ href: '/attendance/take?class_id=' + cls.id, label: 'حضور و غیاب', icon: 'bi-clipboard-check', class: 'btn-outline-primary' }] : []),
  ...(isAdmin ? [{ href: '/academic/classes/' + cls.id + '/edit', label: 'ویرایش', icon: 'bi-pencil', class: 'btn-primary' }] : [])
] }) %>

<% if (enabled('academic.class_stats')) { %>
<div class="row g-3 mb-3">
  <div class="col-6 col-md-3"><div class="card stat-card text-primary"><div class="card-body d-flex align-items-center gap-3"><div class="icon bg-brand-soft"><i class="bi bi-people"></i></div><div><div class="value"><%= J.toPersianDigits(stats.active || 0) %></div><div class="label">دانش‌آموز فعال <span class="text-muted">/ ظرفیت <%= J.toPersianDigits(cls.capacity || 0) %></span></div></div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card text-info"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-info"><i class="bi bi-gender-ambiguous"></i></div><div><div class="value"><%= J.toPersianDigits(stats.boys || 0) %> / <%= J.toPersianDigits(stats.girls || 0) %></div><div class="label">پسر / دختر</div></div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card text-success"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-success"><i class="bi bi-clipboard-check"></i></div><div><div class="value"><%= stats.attendanceRate != null ? J.toPersianDigits(stats.attendanceRate) + '٪' : '—' %></div><div class="label">نرخ حضور · <%= J.toPersianDigits(stats.absences || 0) %> غیبت</div></div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card text-warning"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-warning"><i class="bi bi-award"></i></div><div><div class="value"><%= stats.avgScore != null ? J.toPersianDigits(stats.avgScore) : '—' %></div><div class="label">میانگین نمرات · <%= J.toPersianDigits(stats.exams || 0) %> آزمون</div></div></div></div></div>
</div>
<% } %>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card table-card">
      <div class="card-header"><h6><i class="bi bi-people me-1"></i>دانش‌آموزان (<%= J.toPersianDigits(students.length) %>)</h6>
        <% if (isAdmin && enabled('students')) { %><div class="d-flex gap-2"><button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addStudentsModal"><i class="bi bi-person-plus me-1"></i>افزودن دانش‌آموز موجود</button><a href="/students/new?class_id=<%= cls.id %>" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>ثبت‌نام جدید</a></div><% } %></div>
      <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>#</th><th>نام</th><th>شماره</th><th>ولی</th><th>تماس</th><% if (enabled('attendance')) { %><th>غیبت</th><% } %><th>وضعیت</th></tr></thead>
        <tbody><% students.forEach(function (s, i) { var ex = studentExtra[s.id] || {}; %>
          <tr>
            <td class="text-muted"><%= J.toPersianDigits(i + 1) %></td>
            <td><a href="/students/<%= s.id %>" class="d-flex align-items-center gap-2 fw-semibold"><%- include('partials/avatar', { user: { name: s.first_name + ' ' + s.last_name, avatar: s.photo }, size: 28 }) %><%= s.first_name %> <%= s.last_name %></a></td>
            <td class="ltr text-end text-secondary"><%= J.toPersianDigits(s.student_number) %></td>
            <td><%= s.father_name || s.guardian_name || '—' %></td>
            <td class="ltr text-end"><%= J.toPersianDigits(s.father_phone || s.guardian_phone || s.mobile || '—') %></td>
            <% if (enabled('attendance')) { %><td><% if (ex.absent) { %><span class="badge badge-soft-danger"><%= J.toPersianDigits(ex.absent) %></span><% } else { %><span class="text-muted">۰</span><% } %></td><% } %>
            <td><%- utils.statusBadge(s.status) %></td>
          </tr>
        <% }); if (!students.length) { %><tr><td colspan="7"><%- include('partials/empty', { message: 'هنوز دانش‌آموزی در این کلاس ثبت نشده است' }) %></td></tr><% } %></tbody>
      </table></div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card mb-3">
      <div class="card-header"><h6><i class="bi bi-person-video3 me-1"></i>معلم راهنما</h6></div>
      <div class="card-body">
        <% if (cls.teacher_id) { %><div class="d-flex align-items-center gap-3"><%- include('partials/avatar', { user: { name: cls.teacher_name, avatar: cls.teacher_avatar }, size: 48 }) %><div><a href="/teachers/<%= cls.teacher_id %>" class="fw-semibold"><%= cls.teacher_name %></a><div class="fs-7 text-secondary ltr text-end"><%= J.toPersianDigits(cls.teacher_phone || '') %></div></div></div>
        <% } else { %><div class="text-secondary fs-7">معلم راهنما تعیین نشده است.<% if (isAdmin) { %> <a href="/academic/classes/<%= cls.id %>/edit">تعیین کنید</a><% } %></div><% } %>
      </div>
    </div>
    <div class="card table-card" id="subjects">
      <div class="card-header"><h6><i class="bi bi-book me-1"></i>دروس و معلمان</h6></div>
      <div class="table-responsive"><table class="table align-middle mb-0 table-sm">
        <thead><tr><th>درس</th><th>معلم</th><th>ساعت</th><% if (isAdmin && enabled('academic.class_subjects')) { %><th></th><% } %></tr></thead>
        <tbody><% subjects.forEach(function (s) { %>
          <tr><td class="fw-semibold"><%= s.subject_title %></td><td><% if (s.teacher_name) { %><a href="/teachers/<%= s.teacher_id %>" class="text-reset"><%= s.teacher_name %></a><% } else { %><span class="badge badge-soft-danger"><i class="bi bi-exclamation-circle me-1"></i>معلم تعیین نشده</span><% if (isAdmin && enabled('academic.class_subjects')) { %> <button class="btn btn-link btn-sm p-0 fs-7 align-baseline" data-bs-toggle="modal" data-bs-target="#csModal" data-subject="<%= s.subject_id %>" data-teacher="" data-hours="<%= s.weekly_hours || '' %>">تعیین معلم</button><% } %><% } %></td><td><%= J.toPersianDigits(s.weekly_hours || 0) %></td>
            <% if (isAdmin && enabled('academic.class_subjects')) { %><td class="text-end"><button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#csModal" data-subject="<%= s.subject_id %>" data-teacher="<%= s.teacher_id || '' %>" data-hours="<%= s.weekly_hours || '' %>" aria-label="ویرایش" title="ویرایش"><i class="bi bi-pencil"></i></button> <a href="#" data-post="/academic/classes/<%= cls.id %>/subjects/<%= s.id %>/delete" data-confirm="این درس از کلاس حذف شود؟" class="btn btn-sm btn-light text-danger" aria-label="حذف" title="حذف"><i class="bi bi-trash"></i></a></td><% } %></tr>
        <% }); if (!subjects.length) { %><tr><td colspan="4" class="text-center text-secondary py-3">درسی تخصیص داده نشده است</td></tr><% } %></tbody>
      </table></div>
      <% if (isAdmin && enabled('academic.class_subjects')) { %><div class="card-footer bg-transparent"><button class="btn btn-sm btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#csModal"><i class="bi bi-plus-lg me-1"></i>تخصیص درس / معلم</button></div><% } %>
    </div>
    <% if (enabled('academic.schedule') && schedule.length) { var todayIdx = J.weekdayIndex(J.todayISO()); var todaySlots = schedule.filter(function (s) { return s.day_of_week === todayIdx; }); %>
    <div class="card mt-3"><div class="card-header"><h6><i class="bi bi-calendar-day me-1"></i>برنامه امروز (<%= J.WEEKDAYS[todayIdx] %>)</h6><a href="/academic/schedule/class/<%= cls.id %>" class="fs-7">کامل</a></div>
      <ul class="list-group list-group-flush"><% todaySlots.forEach(function (s) { %><li class="list-group-item d-flex justify-content-between"><span><span class="badge badge-soft-secondary me-1">زنگ <%= J.toPersianDigits(s.period) %></span><%= s.subject_title %></span><span class="text-secondary fs-7 ltr"><%= J.toPersianDigits(s.start_time || '') %></span></li><% }); if (!todaySlots.length) { %><li class="list-group-item text-secondary fs-7">امروز کلاسی ندارد</li><% } %></ul></div>
    <% } %>
  </div>
</div>

<% if (isAdmin && enabled('academic.class_subjects')) { %>
<div class="modal fade" id="csModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
  <form method="post" action="/academic/classes/<%= cls.id %>/subjects"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="modal-header"><h6 class="modal-title">تخصیص درس و معلم</h6><button type="button" class="btn-close" aria-label="بستن" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <div class="mb-3"><label class="form-label required">درس</label><select class="form-select" name="subject_id" id="csSubject" required aria-label="درس"><option value="">— انتخاب —</option><% subjectsOpts.forEach(function (o) { %><option value="<%= o.value %>"><%= o.label %></option><% }); %></select></div>
    <div class="mb-3"><label class="form-label">معلم</label><select class="form-select" name="teacher_id" id="csTeacher" aria-label="معلم"><option value="">— بعداً تعیین می‌شود —</option><% teachersOpts.forEach(function (o) { %><option value="<%= o.value %>"><%= o.label %></option><% }); %></select></div>
    <div class="mb-2"><label class="form-label">ساعت در هفته</label><input class="form-control en-digits" name="weekly_hours" id="csHours" placeholder="پیش‌فرض درس"></div>
  </div>
  <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button><button class="btn btn-primary">ذخیره</button></div>
  </form>
</div></div></div>
<script>
document.getElementById('csModal').addEventListener('show.bs.modal', function (e) {
  var b = e.relatedTarget || {}; var d = b.dataset || {};
  document.getElementById('csSubject').value = d.subject || ''; document.getElementById('csTeacher').value = d.teacher || ''; document.getElementById('csHours').value = d.hours || '';
});
</script>
<% } %>
<% if (isAdmin && enabled('students')) { %>
<div class="modal fade" id="addStudentsModal" tabindex="-1" aria-labelledby="addStudentsTitle"><div class="modal-dialog modal-lg"><form method="post" action="/academic/classes/<%= cls.id %>/students" class="modal-content" id="addStudentsForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="student_ids" id="addStudentIds" value="">
  <div class="modal-header"><h6 class="modal-title" id="addStudentsTitle"><i class="bi bi-person-plus ms-1"></i>افزودن دانش‌آموز به کلاس <%= cls.title %></h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button></div>
  <div class="modal-body">
    <div class="row g-2 align-items-center mb-2">
      <div class="col-md-7"><input type="search" class="form-control" id="addStudentSearch" placeholder="جستجوی نام، شماره دانش‌آموزی یا کد ملی…" autocomplete="off" aria-label="جستجو"></div>
      <div class="col-md-5"><div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="addOnlyNoClass" checked><label class="form-check-label fs-7" for="addOnlyNoClass">فقط دانش‌آموزان بدون کلاس</label></div></div>
    </div>
    <div class="border rounded" style="max-height:300px;overflow:auto"><table class="table table-sm table-hover mb-0 fs-7 align-middle"><tbody id="addStudentResults"><tr><td class="text-secondary text-center py-3">برای جستجو تایپ کنید یا منتظر فهرست بمانید…</td></tr></tbody></table></div>
    <div class="mt-3"><div class="fs-7 text-secondary mb-1">انتخاب‌شده‌ها (<span id="addSelCount">۰</span>):</div><div id="addSelected" class="d-flex flex-wrap gap-1"></div></div>
    <% if (cls.capacity) { %><div class="form-check mt-3"><input class="form-check-input" type="checkbox" name="ignore_capacity" value="1" id="ignoreCap"><label class="form-check-label fs-7" for="ignoreCap">نادیده‌گرفتن ظرفیت کلاس (<%= J.toPersianDigits(cls.capacity) %> نفر؛ اکنون <%= J.toPersianDigits(stats.active || students.length) %> نفر)</label></div><% } %>
  </div>
  <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button><button class="btn btn-primary" id="addStudentsBtn" disabled><i class="bi bi-check2 ms-1"></i>افزودن به کلاس</button></div>
</form></div></div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var modal = document.getElementById('addStudentsModal'); if (!modal) return;
  var sel = {}; var inp = document.getElementById('addStudentSearch'), res = document.getElementById('addStudentResults'), box = document.getElementById('addSelected'), timer = null;
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function renderSel() {
    box.innerHTML = ''; var ids = Object.keys(sel);
    ids.forEach(function (id) { var s = sel[id]; box.insertAdjacentHTML('beforeend', '<span class="badge badge-soft-primary d-inline-flex align-items-center gap-1 fs-7">' + esc(s.name) + ' <button type="button" class="btn-close btn-close-sm" style="font-size:.55rem" aria-label="حذف" data-rm="' + id + '"></button></span>'); });
    document.getElementById('addSelCount').textContent = App.fa(ids.length); document.getElementById('addStudentIds').value = ids.join(','); document.getElementById('addStudentsBtn').disabled = !ids.length;
    res.querySelectorAll('input[type=checkbox]').forEach(function (c) { c.checked = !!sel[c.value]; });
  }
  box.addEventListener('click', function (e) { var b = e.target.closest('[data-rm]'); if (b) { delete sel[b.getAttribute('data-rm')]; renderSel(); } });
  function search() {
    var q = inp.value.trim(); var url = '/students/api/search?exclude_class=<%= cls.id %>&limit=40&q=' + encodeURIComponent(q) + (document.getElementById('addOnlyNoClass').checked ? '&no_class=1' : '');
    fetch(url, { headers: { Accept: 'application/json' }, credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (list) {
      res.innerHTML = '';
      if (!list.length) { res.innerHTML = '<tr><td class="text-secondary text-center py-3">موردی یافت نشد' + (document.getElementById('addOnlyNoClass').checked ? ' — گزینهٔ «فقط بدون کلاس» را خاموش کنید تا دانش‌آموزان سایر کلاس‌ها هم نمایش داده شوند' : '') + '</td></tr>'; return; }
      list.forEach(function (s) { res.insertAdjacentHTML('beforeend', '<tr><td style="width:32px"><input class="form-check-input" type="checkbox" value="' + s.id + '" data-name="' + esc(s.name) + '" aria-label="انتخاب"' + (sel[s.id] ? ' checked' : '') + '></td><td>' + esc(s.name) + '</td><td class="ltr text-end text-secondary">' + App.fa(s.student_number) + '</td><td>' + (s.class_title ? '<span class="badge badge-soft-secondary">' + esc(s.class_title) + '</span>' : '<span class="text-secondary">بدون کلاس</span>') + '</td></tr>'); });
    }).catch(function () { res.innerHTML = '<tr><td class="text-danger text-center py-3">خطا در جستجو</td></tr>'; });
  }
  res.addEventListener('change', function (e) { var c = e.target; if (c.type !== 'checkbox') return; if (c.checked) sel[c.value] = { name: c.getAttribute('data-name') }; else delete sel[c.value]; renderSel(); });
  res.addEventListener('click', function (e) { var tr = e.target.closest('tr'); if (!tr || e.target.type === 'checkbox') return; var c = tr.querySelector('input[type=checkbox]'); if (c) { c.checked = !c.checked; c.dispatchEvent(new Event('change', { bubbles: true })); } });
  inp.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(search, 250); });
  document.getElementById('addOnlyNoClass').addEventListener('change', search);
  modal.addEventListener('shown.bs.modal', function () { inp.focus(); search(); });
});
</script>
<% } %>
