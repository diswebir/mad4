<% if (!print) { %>
<%- include('partials/page-header', { title: 'برنامه هفتگی ' + cls.title, subtitle: cls.grade_title, icon: 'bi-table', breadcrumbs: [{ title: 'برنامه هفتگی', href: '/academic/schedule' }, { title: cls.title }], actions: [
  ...(enabled('academic.schedule_print') ? [{ href: '/academic/schedule/class/' + cls.id + '?print=1', label: 'چاپ', icon: 'bi-printer', class: 'btn-outline-secondary', target: '_blank' }] : []),
  { href: '/academic/classes/' + cls.id, label: 'صفحه کلاس', icon: 'bi-door-open', class: 'btn-light' },
  ...(isAdmin && enabled('academic.schedule_auto') && classSubjects.length ? [{ modal: '#autoModal', label: 'تولید خودکار', icon: 'bi-magic', class: 'btn-primary' }] : [])
] }) %>
<% if (isAdmin) { %>
<div class="row g-3 mb-3">
  <div class="col-lg-8">
    <div class="alert alert-light border d-flex align-items-start gap-2 mb-0 h-100"><i class="bi bi-lightbulb text-warning fs-5"></i><div class="fs-7">
      برای تنظیم هر زنگ روی خانهٔ آن کلیک کنید. در پنجرهٔ انتخاب، وضعیت هر معلم برای همان زنگ نشان داده می‌شود:
      <span class="badge badge-soft-success">آزاد</span> <span class="badge badge-soft-danger">تداخل با کلاس دیگر</span> <span class="badge badge-soft-warning">در دسترس نیست</span> <span class="badge badge-soft-info">همان روز دارد</span> <span class="badge badge-soft-secondary">ساعات تکمیل</span>
      <% if (enabled('academic.teacher_availability')) { %><div class="mt-1 text-secondary">ساعات در دسترس‌نبودن هر معلم را از <a href="/academic/schedule">برنامهٔ معلم</a> علامت بزنید.</div><% } %>
    </div></div>
  </div>
  <div class="col-lg-4">
    <div class="card h-100"><div class="card-body py-2">
      <% if (cov) { var pct = cov.pct; var color = pct >= 100 ? 'success' : pct >= 60 ? 'warning' : 'danger'; %>
      <div class="d-flex justify-content-between align-items-center fs-7"><span><i class="bi bi-pie-chart me-1"></i>پوشش ساعات هفتگی</span><strong class="text-<%= color %>"><%= J.toPersianDigits(cov.placed) %> / <%= J.toPersianDigits(cov.need) %> زنگ (<%= J.toPersianDigits(pct) %>٪)</strong></div>
      <div class="progress mt-1" style="height:8px" role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar bg-<%= color %>" style="width:<%= Math.min(100, pct) %>%"></div></div>
      <% if (cov.missing.length) { %><div class="fs-7 text-secondary mt-1 truncate" title="<%= cov.missing.map(function (m) { return m.title + ' ' + J.toPersianDigits(m.missing); }).join('، ') %>">کسری: <%= cov.missing.map(function (m) { return m.title + ' (' + J.toPersianDigits(m.missing) + ')'; }).join('، ') %></div><% } %>
      <% if (cov.over.length) { %><div class="fs-7 text-warning mt-1">بیش از ساعت هفتگی: <%= cov.over.map(function (m) { return m.title + ' (+' + J.toPersianDigits(m.over) + ')'; }).join('، ') %></div><% } %>
      <% if (cov.no_teacher.length) { %><div class="fs-7 text-danger mt-1">بدون معلم: <%= cov.no_teacher.join('، ') %></div><% } %>
      <% } %>
      <div class="d-flex gap-2 mt-2">
        <form method="post" action="/academic/schedule/class/<%= cls.id %>/clear" class="d-inline" data-confirm="کل برنامهٔ این کلاس پاک شود؟"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-eraser ms-1"></i>پاک‌کردن برنامه</button></form>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#copyBox"><i class="bi bi-files ms-1"></i>کپی از کلاس دیگر</button>
      </div>
    </div></div>
  </div>
</div>
<div class="collapse mb-3" id="copyBox"><div class="card"><div class="card-body d-flex flex-wrap align-items-center gap-2">
  <form method="post" action="/academic/schedule/class/<%= cls.id %>/copy" class="d-flex gap-2 align-items-center"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <span class="fs-7 text-secondary">کپی برنامه از کلاس دیگر (دروس هم‌نام؛ تداخل معلمان بررسی می‌شود):</span>
    <select name="source_id" class="form-select form-select-sm" style="width:auto" required id="copySrc" aria-label="منبع"></select><button class="btn btn-sm btn-outline-primary" data-confirm="برنامهٔ فعلی جایگزین می‌شود. ادامه؟">کپی</button></form>
</div></div></div>
<% } %>
<% } else { %><h5 class="mb-3">برنامهٔ هفتگی کلاس <%= cls.title %> — <%= cls.grade_title %></h5><% } %>
<div class="card"><div class="table-responsive"><table class="table table-bordered schedule-table mb-0 text-center align-middle" id="scheduleTable">
  <thead><tr><th style="width:90px">روز / زنگ</th><% for (var p = 1; p <= periods; p++) { %><th>زنگ <%= J.toPersianDigits(p) %><div class="fs-7 fw-normal text-secondary ltr"><%= J.toPersianDigits(times[p-1] || '') %></div></th><% } %></tr></thead>
  <tbody><% days.forEach(function (d) { %>
    <tr><th class="bg-light"><%= J.WEEKDAYS[d] %></th>
    <% for (var p = 1; p <= periods; p++) { var s = grid[d] && grid[d][p]; %>
      <td class="<%= isAdmin && !print ? 'slot-cell' : '' %> <%= s ? 'has-slot' : '' %>" id="cell-<%= d %>-<%= p %>" <% if (isAdmin && !print) { %>data-day="<%= d %>" data-period="<%= p %>" data-cs="<%= s ? s.class_subject_id : '' %>" data-room="<%= s && s.room_id ? s.room_id : '' %>" role="button" tabindex="0" aria-label="<%= J.WEEKDAYS[d] %> زنگ <%= J.toPersianDigits(p) %>"<% } %>>
        <% if (s) { %><div class="fw-semibold"><%= s.subject_title %></div><div class="fs-7 text-secondary"><%= s.teacher_name || '' %></div><% if (s.room_title) { %><div class="fs-7 text-muted"><i class="bi bi-geo-alt"></i> <%= s.room_title %></div><% } %><% } else if (isAdmin && !print) { %><span class="text-muted fs-7">+</span><% } %>
      </td>
    <% } %></tr>
  <% }); %></tbody>
</table></div></div>
<% if (isAdmin && !print) { %>
<div class="modal fade" id="slotModal" tabindex="-1" aria-labelledby="slotTitle"><div class="modal-dialog modal-lg"><div class="modal-content">
  <form id="slotForm" action="/academic/schedule/class/<%= cls.id %>/slot" method="post">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="day" id="slotDay"><input type="hidden" name="period" id="slotPeriod"><input type="hidden" name="force" id="slotForce" value="0">
  <div class="modal-header"><h6 class="modal-title" id="slotTitle">تنظیم زنگ</h6><button type="button" class="btn-close" aria-label="بستن" data-bs-dismiss="modal"></button></div>
  <div class="modal-body">
    <div id="slotLoading" class="text-center text-secondary py-3"><span class="spinner-border spinner-border-sm ms-1"></span> بررسی وضعیت معلمان…</div>
    <div id="slotError" class="alert alert-danger d-none"></div>
    <div id="slotOptions" class="list-group mb-3"></div>
    <% if (!classSubjects.length) { %><div class="form-text text-danger">ابتدا در صفحهٔ کلاس، درس‌ها را به کلاس تخصیص دهید.</div><% } %>
    <div class="row g-2 align-items-end">
      <div class="col-sm-7"><label class="form-label" for="slotRoom">اتاق (اختیاری)</label><select class="form-select form-select-sm" name="room_id" id="slotRoom" aria-label="اتاق"><option value="">— پیش‌فرض کلاس —</option><% rooms.forEach(function (r) { %><option value="<%= r.id %>"><%= r.title %></option><% }); %></select></div>
      <div class="col-sm-5" id="forceWrap" style="display:none"><div class="form-check"><input class="form-check-input" type="checkbox" id="forceChk"><label class="form-check-label fs-7" for="forceChk">با وجود در دسترس‌نبودن معلم ثبت شود</label></div></div>
    </div>
  </div>
  <div class="modal-footer justify-content-between">
    <button type="button" class="btn btn-outline-danger btn-sm" id="slotClear"><i class="bi bi-eraser ms-1"></i>خالی‌کردن زنگ</button>
    <div><button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button> <button class="btn btn-primary" id="slotSave">ذخیره</button></div>
  </div>
  </form>
</div></div></div>
<% if (enabled('academic.schedule_auto') && classSubjects.length) { %>
<div class="modal fade" id="autoModal" tabindex="-1" aria-labelledby="autoTitle"><div class="modal-dialog"><form method="post" action="/academic/schedule/class/<%= cls.id %>/auto" class="modal-content">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="modal-header"><h6 class="modal-title" id="autoTitle"><i class="bi bi-magic ms-1"></i>تولید خودکار برنامهٔ <%= cls.title %></h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button></div>
  <div class="modal-body">
    <p class="fs-7 text-secondary">دروس بر اساس «ساعت در هفته» چیده می‌شوند؛ تداخل معلمان با کلاس‌های دیگر و ساعات در دسترس‌نبودن آن‌ها رعایت می‌شود و درس‌ها در روزهای هفته پخش می‌شوند.</p>
    <div class="mb-2"><label class="form-label">حالت</label>
      <div class="form-check"><input class="form-check-input" type="radio" name="mode" value="fill" id="modeFill" checked><label class="form-check-label" for="modeFill">حفظ زنگ‌های فعلی و تکمیل خانه‌های خالی</label></div>
      <div class="form-check"><input class="form-check-input" type="radio" name="mode" value="replace" id="modeReplace"><label class="form-check-label" for="modeReplace">پاک‌کردن برنامهٔ فعلی و چیدن از نو</label></div></div>
    <div class="row g-2">
      <div class="col-6"><label class="form-label" for="autoMax">حداکثر زنگ یک درس در روز</label><select class="form-select form-select-sm" name="max_per_day" id="autoMax"><option value="1">۱</option><option value="2" selected>۲</option><option value="3">۳</option></select></div>
      <div class="col-6"><label class="form-label" for="autoDouble">زنگ‌های دوتایی پشت‌سرهم</label><select class="form-select form-select-sm" name="allow_double" id="autoDouble"><option value="1" selected>مجاز</option><option value="0">غیرمجاز</option></select></div>
    </div>
    <div class="fs-7 text-secondary mt-2">برای چیدن هم‌زمان همهٔ کلاس‌ها (نتیجهٔ بهتر برای معلمان مشترک) از <a href="/academic/schedule/auto">تولید خودکار سراسری</a> استفاده کنید.</div>
  </div>
  <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button><button class="btn btn-primary"><i class="bi bi-magic ms-1"></i>تولید برنامه</button></div>
</form></div></div>
<% } %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var modalEl = document.getElementById('slotModal'); var modal = new bootstrap.Modal(modalEl);
  var days = <%- JSON.stringify(J.WEEKDAYS) %>; var classId = <%= cls.id %>;
  var current = { td: null, cs: '' };
  var BADGE = { free: ['success', 'آزاد'], current: ['primary', 'همین زنگ'], busy: ['danger', 'تداخل'], unavailable: ['warning', 'در دسترس نیست'], no_teacher: ['secondary', 'بدون معلم'], complete: ['secondary', 'ساعات تکمیل'], same_day: ['info', 'همان روز دارد'] };
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function render(info) {
    var box = document.getElementById('slotOptions'); box.innerHTML = '';
    if (!info.subjects.length) { box.innerHTML = '<div class="text-secondary fs-7 p-2">درسی به این کلاس تخصیص داده نشده است.</div>'; return; }
    info.subjects.forEach(function (s) {
      var b = BADGE[s.status] || BADGE.free; var disabled = s.status === 'busy' || s.status === 'no_teacher';
      var checked = (info.current && info.current === s.id) ? ' checked' : '';
      var hours = s.hours ? App.fa(s.placed) + '/' + App.fa(s.hours) + ' زنگ' : App.fa(s.placed) + ' زنگ';
      var pct = s.hours ? Math.min(100, Math.round(s.placed / s.hours * 100)) : 0;
      var html = '<label class="list-group-item d-flex align-items-center gap-3 ' + (disabled ? 'opacity-50' : 'list-group-item-action') + '">' +
        '<input class="form-check-input flex-shrink-0 m-0" type="radio" name="class_subject_id" value="' + s.id + '"' + checked + (disabled ? ' disabled' : '') + ' data-status="' + s.status + '">' +
        '<div class="flex-grow-1 min-w-0"><div class="d-flex align-items-center gap-2 flex-wrap"><strong>' + esc(s.title) + '</strong>' + (s.teacher_name ? '<span class="text-secondary fs-7"><i class="bi bi-person ms-1"></i>' + esc(s.teacher_name) + '</span>' : '') +
        '<span class="badge badge-soft-' + b[0] + '">' + b[1] + '</span></div>' +
        '<div class="fs-7 text-secondary">' + esc(s.detail || (s.teacher_id ? 'معلم در این زنگ آزاد است' : '')) + (s.teacher_id && s.teacher_day_load ? ' — امروز ' + App.fa(s.teacher_day_load) + ' زنگ دارد' : '') + '</div></div>' +
        '<div class="text-end flex-shrink-0" style="min-width:84px"><div class="fs-7">' + hours + '</div><div class="progress" style="height:4px"><div class="progress-bar ' + (pct >= 100 ? 'bg-success' : 'bg-primary') + '" style="width:' + pct + '%"></div></div></div></label>';
      box.insertAdjacentHTML('beforeend', html);
    });
    var roomSel = document.getElementById('slotRoom');
    Array.prototype.forEach.call(roomSel.options, function (o) { if (!o.value) return; var r = info.rooms.filter(function (x) { return String(x.id) === o.value; })[0]; o.disabled = false; o.textContent = o.textContent.replace(/ — اشغال.*$/, ''); if (r && r.busy_in) { o.textContent += ' — اشغال (' + r.busy_in + ')'; } });
    roomSel.value = info.current_room || '';
    box.querySelectorAll('input[type=radio]').forEach(function (r) { r.addEventListener('change', updateForce); }); updateForce();
  }
  function updateForce() { var sel = document.querySelector('#slotOptions input[type=radio]:checked'); var un = sel && sel.dataset.status === 'unavailable'; document.getElementById('forceWrap').style.display = un ? '' : 'none'; if (!un) document.getElementById('forceChk').checked = false; }
  function open(td) {
    current.td = td; document.getElementById('slotDay').value = td.dataset.day; document.getElementById('slotPeriod').value = td.dataset.period;
    document.getElementById('slotTitle').textContent = days[td.dataset.day] + ' — زنگ ' + App.fa(td.dataset.period);
    document.getElementById('slotOptions').innerHTML = ''; document.getElementById('slotError').classList.add('d-none'); document.getElementById('slotLoading').classList.remove('d-none'); document.getElementById('forceWrap').style.display = 'none';
    modal.show();
    fetch('/academic/schedule/class/' + classId + '/slot-info?day=' + td.dataset.day + '&period=' + td.dataset.period, { headers: { Accept: 'application/json' }, credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (info) {
      document.getElementById('slotLoading').classList.add('d-none'); if (!info.ok) throw new Error(info.message || 'خطا'); render(info);
    }).catch(function (e) { document.getElementById('slotLoading').classList.add('d-none'); var er = document.getElementById('slotError'); er.textContent = e.message || 'خطا در دریافت وضعیت'; er.classList.remove('d-none'); });
  }
  document.querySelectorAll('.slot-cell').forEach(function (td) { td.addEventListener('click', function () { open(td); }); td.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(td); } }); });
  function submit(clear) {
    var fd = new FormData(document.getElementById('slotForm')); if (clear) fd.set('class_subject_id', '');
    fd.set('force', document.getElementById('forceChk').checked ? '1' : '0');
    var btn = document.getElementById('slotSave'); btn.disabled = true;
    fetch('/academic/schedule/class/' + classId + '/slot', { method: 'POST', body: new URLSearchParams(fd), headers: { Accept: 'application/json', 'X-Requested-With': 'fetch' }, credentials: 'same-origin' }).then(function (r) { return r.json().then(function (d) { d._status = r.status; return d; }); }).then(function (d) {
      btn.disabled = false;
      if (!d.ok) { var er = document.getElementById('slotError'); er.textContent = d.message || 'خطا'; er.classList.remove('d-none'); return; }
      var td = current.td;
      if (d.cleared) { td.innerHTML = '<span class="text-muted fs-7">+</span>'; td.classList.remove('has-slot'); td.dataset.cs = ''; td.dataset.room = ''; }
      else { td.innerHTML = '<div class="fw-semibold">' + esc(d.slot.subject_title) + '</div><div class="fs-7 text-secondary">' + esc(d.slot.teacher_name || '') + '</div>' + (d.slot.room_title ? '<div class="fs-7 text-muted"><i class="bi bi-geo-alt"></i> ' + esc(d.slot.room_title) + '</div>' : ''); td.classList.add('has-slot'); td.dataset.cs = d.slot.class_subject_id; td.dataset.room = d.slot.room_id || ''; }
      td.classList.add('slot-flash'); setTimeout(function () { td.classList.remove('slot-flash'); }, 900);
      modal.hide(); App.toast(d.cleared ? 'زنگ خالی شد' : (d.forced ? 'ذخیره شد (معلم در این زنگ در دسترس نیست)' : 'ذخیره شد'), d.forced ? 'warning' : 'success');
    }).catch(function () { btn.disabled = false; App.toast('خطا در ارتباط', 'danger'); });
  }
  document.getElementById('slotForm').addEventListener('submit', function (e) { e.preventDefault(); submit(false); });
  document.getElementById('slotClear').addEventListener('click', function () { submit(true); });
  var copySel = document.getElementById('copySrc');
  if (copySel) fetch('/academic/api/classes').then(function (r) { return r.json(); }).then(function (list) { list.filter(function (c) { return c.id !== classId; }).forEach(function (c) { var o = document.createElement('option'); o.value = c.id; o.textContent = c.title; copySel.appendChild(o); }); }).catch(function(){});
});
</script>
<% } %>
