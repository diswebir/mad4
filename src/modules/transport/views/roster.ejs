<% if (!print) { %><%- include('partials/page-header', { title: 'سرنشینان ' + route.title, subtitle: 'راننده: ' + route.driver_name + (route.driver_phone ? ' — ' + J.toPersianDigits(route.driver_phone) : '') + ' · ' + (route.vehicle || '') + ' ' + (route.plate ? J.toPersianDigits(route.plate) : ''), icon: 'bi-people', breadcrumbs: [{ title: 'سرویس مدرسه', href: '/transport' }, { title: route.title }], actions: [{ href: '/transport/' + route.id + '/roster?print=1', label: 'چاپ', icon: 'bi-printer', class: 'btn-light' }, ...(enabled('transport.assign') ? [{ href: '/transport/' + route.id + '/assign', label: 'تخصیص', icon: 'bi-person-plus', class: 'btn-primary' }] : [])] }) %><% } else { %><h4 class="text-center">فهرست سرنشینان — <%= route.title %></h4><div class="text-center fs-7 mb-3">راننده: <%= route.driver_name %> · <%= J.toPersianDigits(route.driver_phone || '') %> · <%= route.vehicle || '' %> <%= route.plate ? J.toPersianDigits(route.plate) : '' %> · حرکت <%= route.departure_time ? J.formatTime(route.departure_time) : '' %></div><% } %>
<div class="card table-card"><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>#</th><th>دانش‌آموز</th><th>کلاس</th><th>تلفن پدر</th><th>تلفن مادر</th><th>نشانی</th></tr></thead><tbody>
<% rows.forEach(function (s, i) { %><tr><td><%= J.toPersianDigits(i + 1) %></td><td><% if (!print) { %><a href="/students/<%= s.id %>" class="text-body"><% } %><%= s.first_name %> <%= s.last_name %><% if (!print) { %></a><% } %></td><td><%= s.class_title || '' %></td><td class="ltr text-end"><%= J.toPersianDigits(s.father_phone || '') %></td><td class="ltr text-end"><%= J.toPersianDigits(s.mother_phone || '') %></td><td class="fs-7"><%= s.address || '' %></td></tr><% }); if (!rows.length) { %><tr><td colspan="6" class="text-center text-secondary py-3">سرنشینی ثبت نشده</td></tr><% } %>
</tbody></table></div><div class="card-footer fs-7 text-secondary"><%= J.toPersianDigits(rows.length) %> نفر از ظرفیت <%= J.toPersianDigits(route.capacity) %></div></div>
