<%- include('partials/page-header', { title: 'تخصیص دانش‌آموز به ' + route.title, subtitle: 'سرنشینان فعلی: ' + J.toPersianDigits(riders) + ' از ' + J.toPersianDigits(route.capacity), icon: 'bi-person-plus', breadcrumbs: [{ title: 'سرویس مدرسه', href: '/transport' }, { title: route.title }] }) %>
<form method="get" class="mb-3 d-flex gap-2 align-items-center"><label class="fs-7">کلاس:</label><select class="form-select form-select-sm w-auto" name="class_id" data-auto-submit><% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= Number(classId) === c.id ? 'selected' : '' %>><%= c.title %></option><% }); %></select></form>
<form method="post" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="class_id" value="<%= classId %>">
  <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th style="width:40px"><input type="checkbox" class="form-check-input" id="chkAll"></th><th>دانش‌آموز</th><th>شماره</th><th>سرویس فعلی</th><th>نشانی</th></tr></thead><tbody>
  <% students.forEach(function (s) { var mine = s.transport_route_id === route.id; var other = s.transport_route_id && !mine; %><tr class="<%= mine ? 'table-success' : '' %>"><td><input type="checkbox" class="form-check-input" name="student_ids" value="<%= s.id %>" <%= mine ? 'checked' : '' %> <%= other ? 'title="در سرویس دیگری است؛ با انتخاب به این مسیر منتقل می‌شود"' : '' %>></td><td><%= s.first_name %> <%= s.last_name %></td><td><%= J.toPersianDigits(s.student_number) %></td><td class="fs-7"><%= mine ? 'همین مسیر' : (s.route_title || '—') %></td><td class="fs-7 text-secondary"><%= utils.truncate(s.address || '', 50) %></td></tr><% }); %>
  </tbody></table></div>
  <div class="card-footer bg-transparent d-flex justify-content-between"><span class="fs-7 text-secondary">دانش‌آموزانِ تیک‌نخورده‌ای که در این مسیر هستند از سرویس حذف می‌شوند.</span><button class="btn btn-primary px-4">ذخیره</button></div>
</form>
<script>document.getElementById('chkAll').addEventListener('change',function(){document.querySelectorAll('input[name=student_ids]').forEach(function(c){c.checked=this.checked}.bind(this))});</script>
