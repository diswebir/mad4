<%- include('partials/page-header', { title: 'سرویس من', icon: 'bi-bus-front' }) %>
<% if (!route) { %><div class="card"><%- include('partials/empty', { message: 'برای شما سرویسی ثبت نشده است. برای درخواست سرویس با دفتر مدرسه تماس بگیرید.', icon: 'bi-bus-front' }) %></div><% } else { %>
<div class="row g-3"><div class="col-lg-6"><div class="card"><div class="card-header"><h6><i class="bi bi-bus-front me-1"></i><%= route.title %></h6><%- route.is_active ? '<span class="badge badge-soft-success">فعال</span>' : '<span class="badge badge-soft-secondary">غیرفعال</span>' %></div><div class="card-body"><dl class="row mb-0">
  <dt class="col-5">راننده</dt><dd class="col-7"><%= route.driver_name %></dd><dt class="col-5">تلفن راننده</dt><dd class="col-7 ltr text-end"><a href="tel:<%= route.driver_phone %>"><%= J.toPersianDigits(route.driver_phone || '—') %></a></dd>
  <dt class="col-5">خودرو</dt><dd class="col-7"><%= route.vehicle || '—' %> <span class="fs-7 text-secondary"><%= route.plate ? J.toPersianDigits(route.plate) : '' %></span></dd><dt class="col-5">ساعت حرکت</dt><dd class="col-7"><%= route.departure_time ? J.formatTime(route.departure_time) : '—' %></dd>
  <% if (route.fee) { %><dt class="col-5">هزینهٔ سرویس</dt><dd class="col-7"><%= utils.money(route.fee) %></dd><% } %>
  <% if (route.path_description) { %><dt class="col-12 mt-2">مسیر و ایستگاه‌ها</dt><dd class="col-12 fs-7"><%- utils.nl2br(utils.escapeHtml(route.path_description)) %></dd><% } %></dl></div></div></div>
<div class="col-lg-6"><div class="card"><div class="card-header"><h6><i class="bi bi-people me-1"></i>هم‌سرویسی‌ها (<%= J.toPersianDigits(mates.length) %> نفر)</h6></div><ul class="list-group list-group-flush"><% mates.forEach(function (m) { %><li class="list-group-item d-flex justify-content-between"><span><%= m.first_name %> <%= m.last_name %></span><span class="fs-7 text-secondary"><%= m.class_title || '' %></span></li><% }); %></ul></div></div></div><% } %>
