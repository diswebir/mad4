<%- include('partials/page-header', { title: 'تحلیل نمرات', icon: 'bi-graph-up', breadcrumbs: [{ title: 'آزمون‌ها', href: '/exams' }, { title: 'تحلیل' }] }) %>
<form method="get" class="card mb-3"><div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
  <select class="form-select form-select-sm w-auto" name="class_id" data-auto-submit aria-label="کلاس"><% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= c.id === classId ? 'selected' : '' %>><%= c.title %></option><% }); %></select>
  <select class="form-select form-select-sm w-auto" name="term_id" data-auto-submit aria-label="نوبت"><% terms.forEach(function (t) { %><option value="<%= t.id %>" <%= String(termId) === String(t.id) ? 'selected' : '' %>><%= t.title %> (<%= t.year_title %>)</option><% }); %></select>
  <span class="fs-7 text-secondary ms-auto"><%= J.toPersianDigits(report.examsCount) %> آزمون · <%= J.toPersianDigits(report.rows.length) %> دانش‌آموز · میانگین کلاس: <strong><%= report.classAvg != null ? J.toPersianDigits(report.classAvg) : '—' %></strong></span></div></form>
<div class="row g-3">
  <div class="col-lg-6"><div class="card h-100"><div class="card-header"><h6>توزیع معدل دانش‌آموزان</h6></div><div class="card-body"><canvas id="cDist" height="170"></canvas></div></div></div>
  <div class="col-lg-6"><div class="card h-100"><div class="card-header"><h6>میانگین دروس</h6></div><div class="card-body"><canvas id="cSubj" height="170"></canvas></div></div></div>
  <div class="col-lg-4"><div class="card h-100"><div class="card-header"><h6>مقایسهٔ کلاس‌های هم‌پایه</h6></div><div class="card-body"><canvas id="cCmp" height="200"></canvas></div></div></div>
  <div class="col-lg-4"><div class="card h-100 table-card"><div class="card-header"><h6 class="text-success"><i class="bi bi-trophy me-1"></i>برترین‌ها</h6></div><table class="table table-sm mb-0"><tbody><% top.forEach(function (r) { %><tr><td><span class="badge text-bg-<%= r.rank === 1 ? 'warning' : 'light' %>"><%= J.toPersianDigits(r.rank) %></span></td><td><a href="/students/<%= r.student.id %>"><%= r.student.first_name %> <%= r.student.last_name %></a></td><td class="fw-bold"><%= J.toPersianDigits(r.gpa) %></td></tr><% }); if (!top.length) { %><tr><td class="text-center text-secondary py-3">—</td></tr><% } %></tbody></table></div></div>
  <div class="col-lg-4"><div class="card h-100 table-card"><div class="card-header"><h6 class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>نیازمند توجه (زیر <%= J.toPersianDigits(pass) %>)</h6></div><div style="max-height:320px;overflow:auto"><table class="table table-sm mb-0"><tbody><% failing.forEach(function (f) { %><tr><td><a href="/students/<%= f.student.id %>"><%= f.student.first_name %> <%= f.student.last_name %></a><div class="fs-7 text-danger"><%= f.subjects.join('، ') %></div></td></tr><% }); if (!failing.length) { %><tr><td class="text-center text-secondary py-3">موردی نیست 🎉</td></tr><% } %></tbody></table></div></div></div>
</div>
<script src="/assets/vendor/chartjs/chart.umd.min.js"></script>
<script>
Chart.defaults.font.family = 'Vazirmatn';
new Chart(document.getElementById('cDist'), { type: 'bar', data: { labels: ['< ۱۰', '۱۰-۱۲', '۱۲-۱۵', '۱۵-۱۸', '۱۸-۲۰'], datasets: [{ label: 'تعداد', data: <%- JSON.stringify(buckets) %>, backgroundColor: ['#dc2626', '#f59e0b', '#eab308', '#22c55e', '#16a34a'] }] }, options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } } });
new Chart(document.getElementById('cSubj'), { type: 'bar', data: { labels: <%- JSON.stringify(report.subjects.map(function (s) { return s.title; })) %>, datasets: [{ label: 'میانگین', data: <%- JSON.stringify(report.subjects.map(function (s) { return report.subjectAvg[s.subject_id]; })) %>, backgroundColor: '#2563eb' }] }, options: { indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { min: 0, max: 20 } } } });
new Chart(document.getElementById('cCmp'), { type: 'bar', data: { labels: <%- JSON.stringify(compare.map(function (c) { return c.title; })) %>, datasets: [{ label: 'میانگین کلاس', data: <%- JSON.stringify(compare.map(function (c) { return c.avg; })) %>, backgroundColor: '#7c3aed' }] }, options: { plugins: { legend: { display: false } }, scales: { y: { min: 0, max: 20 } } } });
</script>
