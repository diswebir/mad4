<% if (!print) { %><%- include('partials/page-header', { title: 'ریزنمرات ' + cls.title, subtitle: 'میانگین وزنی هر درس از ۲۰ · ' + J.toPersianDigits(report.examsCount) + ' آزمون', icon: 'bi-table', breadcrumbs: [{ title: 'آزمون‌ها', href: '/exams' }, { title: cls.title }], actions: [
  ...(enabled('exams.export') ? [{ href: '/exams/class/' + cls.id + '?term_id=' + termId + '&export=1', label: 'CSV', icon: 'bi-filetype-csv', class: 'btn-light' }] : []),
  { href: '/exams/class/' + cls.id + '?term_id=' + termId + '&print=1', label: 'چاپ', icon: 'bi-printer', class: 'btn-light', target: '_blank' },
  ...(enabled('exams.analytics') ? [{ href: '/exams/analytics?class_id=' + cls.id + '&term_id=' + termId, label: 'تحلیل', icon: 'bi-graph-up', class: 'btn-light' }] : [])
] }) %>
<form method="get" class="mb-3 d-flex gap-2 align-items-center"><label class="fs-7 text-secondary">نوبت:</label><select class="form-select form-select-sm w-auto" name="term_id" data-auto-submit><% terms.forEach(function (t) { %><option value="<%= t.id %>" <%= String(termId) === String(t.id) ? 'selected' : '' %>><%= t.title %> (<%= t.year_title %>)</option><% }); %></select></form>
<% } else { %><h5>ریزنمرات <%= cls.title %> — <%= S.get('school_name') %></h5><% } %>
<div class="card"><div class="table-responsive"><table class="table table-bordered table-sm align-middle mb-0 text-center" style="font-size:12px">
  <thead class="table-light"><tr><th>#</th><th class="text-start">دانش‌آموز</th><% report.subjects.forEach(function (sb) { %><th><%= sb.title %><% if (!print && enabled('documents.grade_sheet')) { %> <a href="/documents/grade-sheet/<%= sb.cs_id %>?term_id=<%= termId %>" target="_blank" class="text-secondary" title="ریزنمرات رسمی این درس (با سربرگ)"><i class="bi bi-file-earmark-ruled"></i></a><% } %></th><% }); %><th>معدل</th><th>رتبه</th><% if (!print) { %><th></th><% } %></tr></thead>
  <tbody><% report.rows.forEach(function (r, i) { %><tr><td class="text-muted"><%= J.toPersianDigits(i + 1) %></td><td class="text-start text-nowrap"><a href="/students/<%= r.student.id %>" class="text-body"><%= r.student.first_name %> <%= r.student.last_name %></a></td>
    <% report.subjects.forEach(function (sb) { var p = r.per[sb.subject_id]; %><td class="<%= p.val != null && p.val < pass ? 'text-danger fw-semibold' : '' %>"><% if (p.val != null) { %><%= J.toPersianDigits(p.val) %><% } else if (p.desc) { %><%= utils.DESCRIPTIVE_GRADES[p.desc].split(' ')[0] %><% } else { %><span class="text-muted">—</span><% } %></td><% }); %>
    <td class="fw-bold <%= r.gpa != null && r.gpa < pass ? 'text-danger' : '' %>"><%= r.gpa != null ? J.toPersianDigits(r.gpa) : '—' %></td><td><%= r.rank ? J.toPersianDigits(r.rank) : '—' %></td>
    <% if (!print) { %><td><% if (enabled('exams.report_card')) { %><a href="/exams/report-card/<%= r.student.id %>?term_id=<%= termId %>" class="btn btn-sm btn-light py-0" title="کارنامه"><i class="bi bi-file-earmark-text"></i></a><% } %></td><% } %></tr><% }); %></tbody>
  <tfoot class="table-light fw-bold"><tr><td></td><td class="text-start">میانگین کلاس</td><% report.subjects.forEach(function (sb) { %><td><%= report.subjectAvg[sb.subject_id] != null ? J.toPersianDigits(report.subjectAvg[sb.subject_id]) : '—' %></td><% }); %><td><%= report.classAvg != null ? J.toPersianDigits(report.classAvg) : '—' %></td><td></td><% if (!print) { %><td></td><% } %></tr></tfoot>
</table></div></div>
