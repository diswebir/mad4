<%- include('partials/page-header', { title: exam.title, subtitle: exam.subject_title + ' · ' + exam.class_title + ' · ' + J.formatLong(exam.date) + ' · بارم ' + J.toPersianDigits(exam.max_score) + (Number(exam.weight) !== 1 ? ' · ضریب ' + J.toPersianDigits(exam.weight) : '') + (exam.term_title ? ' · ' + exam.term_title : ''), icon: 'bi-award', breadcrumbs: [{ title: 'آزمون‌ها', href: '/exams' }, { title: exam.title }], actions: canManage ? [
  ...(enabled('exams.publish') ? [{ post: '/exams/' + exam.id + '/publish', label: exam.is_published ? 'لغو انتشار' : 'انتشار نمرات', icon: exam.is_published ? 'bi-eye-slash' : 'bi-megaphone', class: exam.is_published ? 'btn-outline-secondary' : 'btn-success' }] : []),
  { href: '/exams/' + exam.id + '/edit', label: 'ویرایش', icon: 'bi-gear', class: 'btn-light' },
  { post: '/exams/' + exam.id + '/delete', label: 'حذف', icon: 'bi-trash', class: 'btn-outline-danger', confirm: 'آزمون و همهٔ نمرات حذف شود؟' }
] : [] }) %>
<% if (exam.description) { %><div class="alert alert-light border fs-7"><%- utils.nl2br(utils.escapeHtml(exam.description)) %></div><% } %>
<div class="row g-3">
  <div class="col-lg-8">
    <% if (lock.locked) { %><div class="alert alert-<%= canUnlock ? 'warning' : 'secondary' %> d-flex align-items-center gap-2 py-2 mb-3"><i class="bi bi-lock-fill fs-5"></i><div><strong>نمرات نوبت «<%= lock.term.title %>» نهایی شده است.</strong> <% if (canUnlock) { %>شما به‌عنوان مدیر می‌توانید با ثبت «دلیل تغییر» نمرات را اصلاح کنید؛ هر تغییر در تاریخچه ثبت می‌شود.<% } else { %>تغییر نمرات فقط توسط مدیر و با ثبت دلیل امکان‌پذیر است؛ در صورت نیاز درخواست اصلاح بدهید.<% } %></div></div><% } %>
    <form method="post" action="/exams/<%= exam.id %>/grades" class="card table-card"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-header"><h6><i class="bi bi-pencil-square me-1"></i>برگهٔ نمره (<%= J.toPersianDigits(students.length) %> دانش‌آموز)</h6><% if (canManage && enabled('exams.grades') && !(lock.locked && !canUnlock)) { %><div class="d-flex gap-2 align-items-center fs-7"><% if (!descriptive) { %><button type="button" class="btn btn-sm btn-light" id="fillAll">پر کردن خالی‌ها با نمرهٔ کامل</button><% } %><span class="text-secondary">Enter = ردیف بعدی</span></div><% } %></div>
      <div class="table-responsive"><table class="table table-sm align-middle mb-0" id="gradeTable">
        <thead><tr><th>#</th><th>دانش‌آموز</th><% if (descriptive) { %><th style="width:220px">ارزشیابی</th><% } else { %><th style="width:130px">نمره (از <%= J.toPersianDigits(exam.max_score) %>)</th><th style="width:70px">از ۲۰</th><% } %><th style="width:70px">غایب</th><th>توضیح</th></tr></thead>
        <tbody><% students.forEach(function (s, i) { var g = grades[s.id] || {}; var isAbsent = g.note && /^غایب/.test(g.note); var ro = !canManage || !enabled('exams.grades') || (lock.locked && !canUnlock); %>
          <tr><td class="text-muted"><%= J.toPersianDigits(i + 1) %></td>
            <td><div class="d-flex align-items-center gap-2"><%- include('partials/avatar', { user: { name: s.first_name + ' ' + s.last_name, avatar: s.photo }, size: 28 }) %><div><a href="/students/<%= s.id %>" class="text-body fw-semibold"><%= s.first_name %> <%= s.last_name %></a><div class="fs-7 text-secondary ltr text-end"><%= J.toPersianDigits(s.student_number) %></div></div></div></td>
            <% if (descriptive) { %><td><select class="form-select form-select-sm" name="desc_<%= s.id %>" <%= ro ? 'disabled' : '' %> aria-label="ارزشیابی توصیفی"><option value="">—</option><% Object.keys(utils.DESCRIPTIVE_GRADES).sort(function (a, b) { return b - a; }).forEach(function (k) { %><option value="<%= k %>" <%= String(g.descriptive) === String(k) ? 'selected' : '' %>><%= utils.DESCRIPTIVE_GRADES[k] %></option><% }); %></select></td>
            <% } else { %><td><input class="form-control form-control-sm ltr text-center score-input" name="score_<%= s.id %>" inputmode="decimal" value="<%= g.score != null ? J.toPersianDigits(g.score) : '' %>" data-max="<%= exam.max_score %>" <%= ro ? 'readonly' : '' %> aria-label="نمره"></td><td class="fs-7 text-secondary s20"><%= g.score != null ? J.toPersianDigits(Math.round(g.score / exam.max_score * 20 * 100) / 100) : '' %></td><% } %>
            <td class="text-center"><input type="checkbox" class="form-check-input" name="absent_<%= s.id %>" value="1" <%= isAbsent ? 'checked' : '' %> <%= ro ? 'disabled' : '' %> aria-label="غایب"></td>
            <td><input class="form-control form-control-sm" name="note_<%= s.id %>" value="<%= isAbsent ? (g.note || '').replace(/^غایب( — )?/, '') : (g.note || '') %>" <%= ro ? 'readonly' : '' %> aria-label="یادداشت"></td></tr>
        <% }); %></tbody></table></div>
      <% if (canManage && enabled('exams.grades') && lock.locked && canUnlock) { %><div class="card-footer bg-transparent border-bottom"><label class="form-label fs-7 fw-500 mb-1" for="f_change_reason"><i class="bi bi-exclamation-triangle text-warning me-1"></i>دلیل تغییر نمرات پس از نهایی شدن (الزامی)</label><input class="form-control form-control-sm" name="change_reason" required maxlength="255" placeholder="مثال: اعتراض دانش‌آموز بررسی و تأیید شد / خطای ورود نمره" id="f_change_reason"></div><% } %>
      <% if (canManage && enabled('exams.grades') && !(lock.locked && !canUnlock)) { %><div class="card-footer bg-transparent d-flex justify-content-between align-items-center"><span class="fs-7 text-secondary">نمره‌های خالی ذخیره نمی‌شوند. اعداد فارسی و ممیز «/» پذیرفته می‌شود.</span><button class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>ذخیرهٔ نمرات</button></div><% } %>
    </form>
  </div>
  <div class="col-lg-4">
    <div class="card mb-3"><div class="card-header"><h6>آمار آزمون</h6></div><div class="card-body">
      <% if (stats) { %><div class="row g-2 text-center">
        <div class="col-4"><div class="fs-4 fw-bold"><%= J.toPersianDigits(stats.avg) %></div><div class="fs-7 text-secondary">میانگین</div></div>
        <div class="col-4"><div class="fs-4 fw-bold text-success"><%= J.toPersianDigits(stats.max) %></div><div class="fs-7 text-secondary">بیشترین</div></div>
        <div class="col-4"><div class="fs-4 fw-bold text-danger"><%= J.toPersianDigits(stats.min) %></div><div class="fs-7 text-secondary">کمترین</div></div>
        <div class="col-6"><div class="fs-5 fw-bold"><%= J.toPersianDigits(stats.n) %></div><div class="fs-7 text-secondary">نمره ثبت‌شده</div></div>
        <div class="col-6"><div class="fs-5 fw-bold"><%= J.toPersianDigits(Math.round(stats.pass / stats.n * 100)) %>٪</div><div class="fs-7 text-secondary">قبولی (≥ <%= J.toPersianDigits(pass) %>)</div></div></div>
        <canvas id="distChart" height="160" class="mt-3"></canvas>
      <% } else { %><div class="text-secondary text-center py-3 fs-7">هنوز نمره‌ای ثبت نشده است</div><% } %>
    </div></div>
    <div class="card"><div class="card-header"><h6>اطلاعات</h6></div><ul class="list-group list-group-flush fs-7">
      <li class="list-group-item d-flex justify-content-between"><span class="text-secondary">نوع</span><span><%= TYPES[exam.type] || exam.type %></span></li>
      <li class="list-group-item d-flex justify-content-between"><span class="text-secondary">تعریف‌کننده</span><span><%= exam.creator_name || '—' %></span></li>
      <% if (enabled('exams.publish')) { %><li class="list-group-item d-flex justify-content-between"><span class="text-secondary">وضعیت</span><%- exam.is_published ? '<span class="badge badge-soft-success">منتشر شده</span>' : '<span class="badge badge-soft-secondary">پیش‌نویس (مخفی از دانش‌آموز)</span>' %></li><% } %>
      <% if (enabled('exams.lock') && lock.term) { %><li class="list-group-item d-flex justify-content-between"><span class="text-secondary">نوبت</span><span><%= lock.term.title %> <%- lock.locked ? '<span class="badge text-bg-warning"><i class="bi bi-lock-fill"></i> نهایی</span>' : '<span class="badge badge-soft-success">باز</span>' %></span></li><% } %>
      <% if (enabled('exams.history')) { %><li class="list-group-item"><a href="/exams/<%= exam.id %>/history"><i class="bi bi-clock-history me-1"></i>تاریخچهٔ تغییر نمرات<% if (changesCount) { %> <span class="badge badge-soft-secondary"><%= J.toPersianDigits(changesCount) %></span><% } %></a></li><% } %>
      <% if (enabled('exams.class_sheet')) { %><li class="list-group-item"><a href="/exams/class/<%= exam.class_id %><%= exam.term_id ? '?term_id=' + exam.term_id : '' %>"><i class="bi bi-table me-1"></i>ریزنمرات کلاس <%= exam.class_title %></a></li><% } %>
    </ul></div>
  </div>
</div>
<% if (stats) { %><script src="/assets/vendor/chartjs/chart.umd.min.js"></script><script>Chart.defaults.font.family = 'Vazirmatn'; new Chart(document.getElementById('distChart'), { type: 'bar', data: { labels: ['< ۱۰', '۱۰-۱۲', '۱۲-۱۵', '۱۵-۱۸', '۱۸-۲۰'], datasets: [{ data: <%- JSON.stringify(dist) %>, backgroundColor: ['#dc2626', '#f59e0b', '#eab308', '#22c55e', '#16a34a'] }] }, options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } } });</script><% } %>
<script>
(function () {
  var inputs = [].slice.call(document.querySelectorAll('.score-input'));
  inputs.forEach(function (inp, i) {
    inp.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); if (inputs[i + 1]) { inputs[i + 1].focus(); inputs[i + 1].select(); } } });
    inp.addEventListener('input', function () { var max = Number(inp.dataset.max); var v = Number(App.en(inp.value).replace('/', '.')); var cell = inp.closest('tr').querySelector('.s20'); if (!inp.value || isNaN(v) || v < 0 || v > max) { inp.classList.toggle('is-invalid', !!inp.value && (isNaN(v) || v < 0 || v > max)); if (cell) cell.textContent = ''; return; } inp.classList.remove('is-invalid'); if (cell) cell.textContent = App.fa(Math.round(v / max * 2000) / 100); });
  });
  var fill = document.getElementById('fillAll'); if (fill) fill.addEventListener('click', function () { inputs.forEach(function (inp) { if (!inp.value) { inp.value = App.fa(inp.dataset.max); inp.dispatchEvent(new Event('input')); } }); });
})();
</script>
