<%- include('partials/page-header', { title: 'نمرات من', subtitle: s.first_name + ' ' + s.last_name, icon: 'bi-award', actions: enabled('exams.report_card') ? [{ href: '/exams/report-card/' + s.id + (termId ? '?term_id=' + termId : ''), label: 'کارنامه', icon: 'bi-file-earmark-text', class: 'btn-primary' }] : [] }) %>
<form method="get" class="mb-3 d-flex gap-2 align-items-center"><label class="fs-7 text-secondary">نوبت:</label><select class="form-select form-select-sm w-auto" name="term_id" data-auto-submit aria-label="نوبت"><% terms.forEach(function (t) { %><option value="<%= t.id %>" <%= String(termId) === String(t.id) ? 'selected' : '' %>><%= t.title %> (<%= t.year_title %>)</option><% }); %></select></form>
<% if (mine && mine.gpa != null) { %><div class="row g-3 mb-3">
  <div class="col-6 col-md-3"><div class="card stat-card text-primary"><div class="card-body"><div class="value"><%= J.toPersianDigits(mine.gpa) %></div><div class="label">معدل تا امروز</div></div></div></div>
  <% if (mine.rank) { %><div class="col-6 col-md-3"><div class="card stat-card text-success"><div class="card-body"><div class="value"><%= J.toPersianDigits(mine.rank) %></div><div class="label">رتبه در کلاس (از <%= J.toPersianDigits(report.rows.filter(function (r) { return r.gpa != null; }).length) %>)</div></div></div></div><% } %>
  <div class="col-6 col-md-3"><div class="card stat-card text-info"><div class="card-body"><div class="value"><%= report.classAvg != null ? J.toPersianDigits(report.classAvg) : '—' %></div><div class="label">میانگین کلاس</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card text-warning"><div class="card-body"><div class="value"><%= J.toPersianDigits(grades.length) %></div><div class="label">نمرهٔ ثبت‌شده</div></div></div></div>
</div><% } %>
<div class="row g-3">
  <div class="col-lg-8">
    <% Object.keys(bySubject).forEach(function (subj) { var list = bySubject[subj]; %>
    <div class="card mb-3"><div class="card-header"><h6><i class="bi bi-book me-1"></i><%= subj %></h6><% var sid = list[0] && report ? report.subjects.find(function (x) { return x.title === subj; }) : null; var pv = sid && mine ? mine.per[sid.subject_id] : null; %><% if (pv && pv.val != null) { %><span class="badge <%= pv.val >= 10 ? 'text-bg-success' : 'text-bg-danger' %>">میانگین: <%= J.toPersianDigits(pv.val) %></span><% } else if (pv && pv.desc) { %><span class="badge text-bg-info"><%= utils.DESCRIPTIVE_GRADES[pv.desc] %></span><% } %></div>
      <div class="table-responsive"><table class="table table-sm mb-0 align-middle"><thead><tr><th>آزمون</th><th>تاریخ</th><th>نمره</th><th>از ۲۰</th><th>میانگین کلاس</th><th>توضیح</th></tr></thead><tbody>
        <% list.forEach(function (g) { var t20 = to20(g.score, g.max_score); %><tr><td><%= g.title %> <span class="fs-7 text-secondary"><%= TYPES[g.type] || '' %></span></td><td class="fs-7"><%= J.formatDate(g.date) %></td>
          <td><% if (g.score != null) { %><strong class="<%= t20 < 10 ? 'text-danger' : '' %>"><%= J.toPersianDigits(g.score) %></strong> <span class="fs-7 text-secondary">/ <%= J.toPersianDigits(g.max_score) %></span><% } else if (g.descriptive) { %><span class="badge text-bg-info"><%= utils.DESCRIPTIVE_GRADES[g.descriptive] %></span><% } else { %>—<% } %></td>
          <td class="fs-7"><%= t20 != null ? J.toPersianDigits(t20) : '' %></td><td class="fs-7 text-secondary"><%= g.class_avg != null ? J.toPersianDigits(Math.round(g.class_avg * 100) / 100) : '' %></td><td class="fs-7 text-secondary"><%= g.note || '' %></td></tr><% }); %>
      </tbody></table></div></div>
    <% }); if (!grades.length) { %><div class="card"><%- include('partials/empty', { message: 'هنوز نمره‌ای برای این نوبت منتشر نشده است', icon: 'bi-award' }) %></div><% } %>
  </div>
  <div class="col-lg-4"><% if (upcoming.length) { %><div class="card"><div class="card-header"><h6><i class="bi bi-calendar-event me-1"></i>آزمون‌های پیش رو</h6></div><ul class="list-group list-group-flush"><% upcoming.forEach(function (e) { %><li class="list-group-item"><div class="d-flex justify-content-between"><strong><%= e.subject_title %></strong><span class="fs-7 text-secondary"><%= J.formatDate(e.date) %> <%= J.weekdayName(e.date) %></span></div><div class="fs-7"><%= e.title %> · <%= TYPES[e.type] || '' %><%= e.start_time ? ' · ' + J.formatTime(e.start_time) : '' %></div><% if (e.description) { %><div class="fs-7 text-secondary"><%= utils.truncate(e.description, 80) %></div><% } %></li><% }); %></ul></div><% } %></div>
</div>
