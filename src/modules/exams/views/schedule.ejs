<%- include('partials/page-header', { title: 'برنامهٔ آزمون‌ها', subtitle: 'آزمون‌های هفتهٔ گذشته و پیش رو', icon: 'bi-calendar-event', breadcrumbs: [{ title: 'آزمون‌ها', href: currentUser.role === 'student' ? '/exams/my' : '/exams' }, { title: 'برنامه' }], actions: [{ print: true }] }) %>
<% if (classes.length) { %><form method="get" class="mb-3 no-print"><select class="form-select form-select-sm w-auto" name="class_id" data-auto-submit><option value="">همهٔ کلاس‌ها</option><% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= String(classId) === String(c.id) ? 'selected' : '' %>><%= c.title %></option><% }); %></select></form><% } %>
<% if (!days.length) { %><div class="card"><%- include('partials/empty', { message: 'آزمونی برنامه‌ریزی نشده است', icon: 'bi-calendar-x' }) %></div><% } %>
<div class="row g-3"><% days.forEach(function (d) { var past = d.date < J.todayISO(); var today = d.date === J.todayISO(); %>
  <div class="col-md-6 col-xl-4"><div class="card h-100 <%= today ? 'border-primary' : '' %> <%= past ? 'opacity-75' : '' %>"><div class="card-header"><h6><%= J.weekdayName(d.date) %> <%= J.formatDate(d.date) %><% if (today) { %> <span class="badge text-bg-primary">امروز</span><% } %></h6></div>
    <ul class="list-group list-group-flush"><% d.exams.forEach(function (e) { %><li class="list-group-item"><div class="d-flex justify-content-between"><strong><%= e.subject_title %></strong><span class="fs-7 text-secondary"><%= e.class_title %></span></div><div class="fs-7"><% if (currentUser.role !== 'student') { %><a href="/exams/<%= e.id %>"><%= e.title %></a><% } else { %><%= e.title %><% } %> · <%= TYPES[e.type] || '' %><%= e.start_time ? ' · ' + J.formatTime(e.start_time) : '' %> · بارم <%= J.toPersianDigits(e.max_score) %></div></li><% }); %></ul></div></div>
<% }); %></div>
