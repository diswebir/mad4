<%- include('partials/page-header', { title: 'جستجو', subtitle: q ? J.toPersianDigits(total) + ' نتیجه برای «' + q + '»' : 'حداقل دو حرف وارد کنید', icon: 'bi-search' }) %>
<form method="get" class="mb-3"><div class="input-group input-group-lg"><input class="form-control" name="q" value="<%= q %>" placeholder="نام دانش‌آموز، شماره، کد ملی، تلفن، معلم، کلاس، تیکت، کتاب…" autofocus><button class="btn btn-primary" aria-label="جستجو" title="جستجو"><i class="bi bi-search"></i></button></div></form>
<div class="row g-3"><% groups.forEach(function (g) { %><div class="col-md-6"><div class="card"><div class="card-header"><h6><i class="bi <%= g.icon %> me-1"></i><%= g.title %> <span class="badge text-bg-light"><%= J.toPersianDigits(g.items.length) %></span></h6></div><div class="list-group list-group-flush"><% g.items.forEach(function (i) { %><a href="<%= i.href %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><div><div class="fw-semibold"><%= i.title %></div><div class="fs-7 text-secondary"><%= i.sub %></div></div><%- i.badge || '' %></a><% }); %></div></div></div><% }); if (q && !groups.length) { %><div class="col-12"><div class="card"><%- include('partials/empty', { message: 'نتیجه‌ای یافت نشد', icon: 'bi-search' }) %></div></div><% } %></div>
