<style>
  .id-cards { display: flex; flex-wrap: wrap; gap: 12px; }
  .id-card { width: 86mm; height: 54mm; border: 1px solid #cbd5e1; border-radius: 10px; overflow: hidden; position: relative; background: linear-gradient(135deg, #fff 60%, #eff6ff); page-break-inside: avoid; display: flex; flex-direction: column; }
  .id-card .top { background: var(--brand, #2563eb); color: #fff; padding: 5px 10px; font-size: 11px; display: flex; justify-content: space-between; align-items: center; }
  .id-card .body { display: flex; gap: 10px; padding: 8px 10px; flex: 1; }
  .id-card .photo { width: 24mm; height: 30mm; border-radius: 6px; object-fit: cover; border: 1px solid #e2e8f0; background: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #fff; }
  .id-card .info { font-size: 11px; line-height: 1.7; flex: 1; }
  .id-card .info b { font-size: 13px; }
  .id-card .bottom { font-size: 9px; color: #475569; padding: 3px 10px; border-top: 1px dashed #cbd5e1; display: flex; justify-content: space-between; }
  .id-card .barcode svg { height: 9mm; width: auto; max-width: 34mm; display: block; }
  .id-card .qr { position: absolute; left: 3mm; top: 8mm; width: 13mm; height: 13mm; background: #fff; padding: 1px; border-radius: 3px; border: 1px solid #e2e8f0; }
  .id-card .qr svg { width: 100%; height: 100%; display: block; }
  .id-card.has-qr .info { padding-left: 14mm; }
  @media print { .print-header { display: none !important; } .id-cards { gap: 6mm; } }
</style>
<% if (enabled('students.card_qr') && students.length === 1 && currentUser && (currentUser.role === 'admin' || can('students.manage'))) { %>
<div class="no-print d-flex align-items-center gap-2 mb-3 fs-7">
  <span class="text-secondary"><i class="bi bi-qr-code me-1"></i>کد یکتای کارت: <code><%= students[0].card_token %></code> · <a href="<%= verifyUrl(students[0].card_token) %>" target="_blank" rel="noopener">صفحهٔ استعلام</a></span>
  <form method="post" action="/students/<%= students[0].id %>/card/reissue" class="ms-auto" onsubmit="return confirm('کارت فعلی باطل می‌شود و QR کارت‌های چاپ‌شدهٔ قبلی دیگر معتبر نیست. ادامه می‌دهید؟')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger btn-sm"><i class="bi bi-arrow-repeat me-1"></i>ابطال و صدور مجدد</button></form>
</div>
<% } %>
<div class="id-cards">
<% students.forEach(function (s) { %>
  <% var qrOn = enabled('students.card_qr') && s.card_token; %>
  <div class="id-card<%= qrOn ? ' has-qr' : '' %>">
    <% if (qrOn) { %><div class="qr" title="استعلام اصالت کارت"><%- barcode.qr(verifyUrl(s.card_token), { level: 'M' }) %></div><% } %>
    <div class="top"><span><%= school('school_name', 'مدرسه') %></span><span>کارت دانش‌آموزی <%= year ? J.toPersianDigits(year.title) : '' %></span></div>
    <div class="body">
      <% if (s.photo) { %><img class="photo" src="/files/<%= s.photo %>" alt=""><% } else { %><div class="photo" style="background:<%= utils.colorFor(s.first_name + s.last_name) %>"><%= utils.initials(s.first_name + ' ' + s.last_name) %></div><% } %>
      <div class="info">
        <div><b><%= s.first_name %> <%= s.last_name %></b></div>
        <div>شماره: <span class="ltr d-inline-block"><%= J.toPersianDigits(s.student_number) %></span></div>
        <div>کلاس: <%= s.class_title || '—' %> <%= s.grade_title ? '(' + s.grade_title + ')' : '' %></div>
        <% if (s.national_id) { %><div>کد ملی: <span class="ltr d-inline-block"><%= J.toPersianDigits(s.national_id) %></span></div><% } %>
        <% if (s.birth_date) { %><div>تولد: <%= J.formatDate(s.birth_date) %></div><% } %>
        <% if (enabled('students.medical') && s.blood_type) { %><div>گروه خونی: <b class="text-danger"><%= s.blood_type %></b></div><% } %>
      </div>
    </div>
    <div class="bottom"><span><%= school('school_phone') ? 'تلفن مدرسه: ' + J.toPersianDigits(school('school_phone')) : (school('school_address') || '') %></span><span class="barcode" title="<%= s.student_number %>"><%- barcode.code128(String(s.student_number || ''), { height: 30, label: false, quiet: 4 }) %></span></div>
  </div>
<% }); %>
</div>
