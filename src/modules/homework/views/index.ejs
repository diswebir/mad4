<%- include('partials/page-header', { title: 'تکالیف', icon: 'bi-journal-check', actions: [{ href: '/homework/new', label: 'تکلیف جدید', icon: 'bi-plus-lg', class: 'btn-primary' }, ...(enabled('homework.materials') ? [{ href: '/homework/materials', label: 'محتوای آموزشی', icon: 'bi-folder2-open', class: 'btn-light' }] : [])] }) %>
<form method="get" class="card mb-3"><div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
  <select class="form-select form-select-sm w-auto" name="class_id" data-auto-submit><option value="">همهٔ کلاس‌ها</option><% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= String(f.class_id) === String(c.id) ? 'selected' : '' %>><%= c.title %></option><% }); %></select>
  <select class="form-select form-select-sm w-auto" name="status" data-auto-submit><option value="">همه</option><option value="open" <%= f.status === 'open' ? 'selected' : '' %>>مهلت باز</option><option value="past" <%= f.status === 'past' ? 'selected' : '' %>>مهلت گذشته</option></select>
  <input class="form-control form-control-sm" style="max-width:220px" name="q" value="<%= f.q %>" placeholder="جستجو…"><button class="btn btn-sm btn-primary"><i class="bi bi-search"></i></button></div></form>
<div class="card table-card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
  <thead><tr><th>عنوان</th><th>درس / کلاس</th><th>مهلت</th><% if (enabled('homework.stats')) { %><th>تحویل</th><th>نمره‌دهی</th><% } %><th>معلم</th><th></th></tr></thead>
  <tbody><% result.data.forEach(function (h) { var past = h.due_date < J.todayISO(); var pct = h.students_count ? Math.round(h.submissions / h.students_count * 100) : 0; %>
    <tr><td><a href="/homework/<%= h.id %>" class="fw-semibold"><%= h.title %></a><% if (h.file_path) { %> <i class="bi bi-paperclip text-secondary"></i><% } %></td><td><%= h.subject_title %><div class="fs-7 text-secondary"><%= h.class_title %></div></td>
      <td class="text-nowrap"><%= J.formatDate(h.due_date) %> <%- past ? '<span class="badge badge-soft-secondary">گذشته</span>' : '<span class="badge badge-soft-success">' + J.toPersianDigits(J.diffDays(J.todayISO(), h.due_date)) + ' روز</span>' %></td>
      <% if (enabled('homework.stats')) { %><td><div class="d-flex align-items-center gap-2"><div class="progress" style="width:70px;height:6px"><div class="progress-bar" style="width:<%= pct %>%"></div></div><span class="fs-7"><%= J.toPersianDigits(h.submissions) %>/<%= J.toPersianDigits(h.students_count) %></span></div></td><td class="fs-7"><%= J.toPersianDigits(h.graded) %> نمره</td><% } %>
      <td class="fs-7"><%= h.creator_name || '' %></td><td class="text-end"><a href="/homework/<%= h.id %>" class="btn btn-sm btn-light"><i class="bi bi-eye"></i></a> <a href="/homework/<%= h.id %>/edit" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a></td></tr>
  <% }); if (!result.data.length) { %><tr><td colspan="7"><%- include('partials/empty', { message: 'تکلیفی یافت نشد', action: { href: '/homework/new', label: 'تعریف تکلیف' } }) %></td></tr><% } %></tbody></table></div>
  <%- include('partials/pagination', { result: result, query: query }) %></div>
