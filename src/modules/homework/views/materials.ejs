<%- include('partials/page-header', { title: 'محتوای آموزشی', subtitle: 'جزوه‌ها، فایل‌ها و لینک‌های اشتراکی هر درس', icon: 'bi-folder2-open', breadcrumbs: [{ title: 'تکالیف', href: currentUser.role === 'student' ? '/homework/my' : '/homework' }, { title: 'محتوای آموزشی' }] }) %>
<div class="row g-3">
  <% if (canAdd) { %><div class="col-lg-4"><form method="post" action="/homework/materials" enctype="multipart/form-data" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="card-header"><h6><i class="bi bi-cloud-upload me-1"></i>اشتراک محتوای جدید</h6></div><div class="card-body">
    <div class="mb-2"><label class="form-label required">درس / کلاس</label><select class="form-select form-select-sm" name="class_subject_id" required><% cs.forEach(function (x) { %><option value="<%= x.id %>"><%= x.subject_title %> — <%= x.class_title %></option><% }); %></select></div>
    <div class="mb-2"><label class="form-label required">عنوان</label><input class="form-control form-control-sm" name="title" required maxlength="150"></div>
    <div class="mb-2"><label class="form-label">توضیح</label><textarea class="form-control form-control-sm" name="description" rows="2"></textarea></div>
    <div class="mb-2"><label class="form-label">فایل (تا ۲۰ مگابایت)</label><input type="file" class="form-control form-control-sm" name="file"></div>
    <div><label class="form-label">یا لینک</label><input class="form-control form-control-sm ltr" name="link" placeholder="https://…"></div>
  </div><div class="card-footer bg-transparent text-end"><button class="btn btn-sm btn-primary">اشتراک‌گذاری</button></div></form></div><% } %>
  <div class="col-lg-<%= canAdd ? 8 : 12 %>">
    <form method="get" class="d-flex gap-2 mb-3"><% if (classes.length) { %><select class="form-select form-select-sm w-auto" name="class_id" data-auto-submit><option value="">همهٔ کلاس‌ها</option><% classes.forEach(function (c) { %><option value="<%= c.id %>" <%= String(f.class_id) === String(c.id) ? 'selected' : '' %>><%= c.title %></option><% }); %></select><% } %><input class="form-control form-control-sm" style="max-width:240px" name="q" value="<%= f.q %>" placeholder="جستجو…"><button class="btn btn-sm btn-light"><i class="bi bi-search"></i></button></form>
    <div class="row g-3"><% result.data.forEach(function (m) { %><div class="col-md-6"><div class="card h-100"><div class="card-body d-flex gap-3">
      <div class="icon-box badge-soft-<%= m.file_path ? 'primary' : 'info' %>"><i class="bi <%= m.file_path ? (/\.pdf$/i.test(m.file_name || '') ? 'bi-file-earmark-pdf' : /\.(png|jpe?g|gif|webp)$/i.test(m.file_name || '') ? 'bi-file-earmark-image' : 'bi-file-earmark-arrow-down') : 'bi-link-45deg' %>"></i></div>
      <div class="flex-grow-1 mw-0"><div class="fw-semibold"><%= m.title %></div><div class="fs-7 text-secondary"><%= m.subject_title || '' %> · <%= m.class_title %> · <%= m.creator_name || '' %> · <%= J.formatDate(m.created_at) %></div><% if (m.description) { %><div class="fs-7 mt-1"><%= utils.truncate(m.description, 100) %></div><% } %>
        <div class="mt-2 d-flex gap-2"><% if (m.file_path) { %><a href="/files/<%= m.file_path %>" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-download me-1"></i>دانلود</a><% } %><% if (m.link) { %><a href="<%= m.link %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-info"><i class="bi bi-box-arrow-up-left me-1"></i>باز کردن لینک</a><% } %><% if (canAdd && (currentUser.role !== 'teacher' || m.created_by === currentUser.id)) { %><a href="#" data-post="/homework/materials/<%= m.id %>/delete" data-confirm="حذف شود؟" class="btn btn-sm btn-light text-danger ms-auto"><i class="bi bi-trash"></i></a><% } %></div></div></div></div></div><% }); if (!result.data.length) { %><div class="col-12"><div class="card"><%- include('partials/empty', { message: 'محتوایی به اشتراک گذاشته نشده', icon: 'bi-folder2-open' }) %></div></div><% } %></div>
    <%- include('partials/pagination', { result: result, query: query }) %>
  </div>
</div>
