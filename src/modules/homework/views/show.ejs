<% var past = hw.due_date < today; %>
<%- include('partials/page-header', { title: hw.title, subtitle: hw.subject_title + ' · ' + hw.class_title + ' · مهلت: ' + J.formatLong(hw.due_date) + (past ? ' (گذشته)' : ' — ' + J.toPersianDigits(J.diffDays(today, hw.due_date)) + ' روز مانده') + ' · بارم ' + J.toPersianDigits(hw.max_score), icon: 'bi-journal-check', breadcrumbs: [{ title: s ? 'تکالیف من' : 'تکالیف', href: s ? '/homework/my' : '/homework' }, { title: hw.title }], actions: manage ? [{ href: '/homework/' + hw.id + '/edit', label: 'ویرایش', icon: 'bi-pencil', class: 'btn-light' }, { post: '/homework/' + hw.id + '/delete', label: 'حذف', icon: 'bi-trash', class: 'btn-outline-danger', confirm: 'تکلیف و پاسخ‌ها حذف شود؟' }] : [] }) %>
<div class="row g-3">
  <div class="col-lg-<%= s ? 7 : 12 %>">
    <div class="card mb-3"><div class="card-body"><% if (hw.description) { %><div class="msg-body"><%- utils.nl2br(utils.escapeHtml(hw.description)) %></div><% } else { %><span class="text-secondary">بدون توضیح</span><% } %>
      <% if (hw.file_path) { %><div class="mt-3"><a href="/files/<%= hw.file_path %>" target="_blank" class="btn btn-sm btn-outline-primary"><i class="bi bi-download me-1"></i><%= hw.file_name || 'دانلود پیوست' %></a></div><% } %>
      <div class="fs-7 text-secondary mt-3">تعریف‌شده توسط <%= hw.creator_name || '—' %> · <%= J.formatDateTime(hw.created_at) %></div></div></div>
    <% if (!s) { var submitted = Object.keys(subs).length; %>
    <form method="post" action="/homework/<%= hw.id %>/grade" class="card table-card"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-header"><h6><i class="bi bi-people me-1"></i>پاسخ‌ها (<%= J.toPersianDigits(submitted) %> از <%= J.toPersianDigits(students.length) %>)</h6><% if (enabled('homework.stats')) { var sc = Object.values(subs).map(function (x) { return x.score; }).filter(function (x) { return x != null; }); %><span class="fs-7 text-secondary"><%= sc.length ? 'میانگین نمره: ' + J.toPersianDigits(Math.round(sc.reduce(function (a, b) { return a + Number(b); }, 0) / sc.length * 100) / 100) : '' %></span><% } %></div>
      <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>دانش‌آموز</th><th>وضعیت</th><th>پاسخ</th><% if (enabled('homework.grade')) { %><th style="width:110px">نمره (از <%= J.toPersianDigits(hw.max_score) %>)</th><th>بازخورد</th><% } %></tr></thead><tbody>
        <% students.forEach(function (st) { var x = subs[st.id]; %><tr><td><a href="/students/<%= st.id %>" class="text-body fw-semibold"><%= st.first_name %> <%= st.last_name %></a></td>
          <td><% if (!x || (!x.submitted_at && x.score == null)) { %><span class="badge badge-soft-<%= past ? 'danger' : 'secondary' %>"><%= past ? 'ارسال نشده' : 'در انتظار' %></span><% } else { %><%- utils.statusBadge(x.status) %><% if (x.submitted_at) { %><div class="fs-7 text-secondary"><%= J.formatDateTime(x.submitted_at) %></div><% } %><% } %></td>
          <td class="fs-7" style="max-width:260px"><% if (x && x.content) { %><%= utils.truncate(x.content, 120) %><% } %><% if (x && x.file_path) { %> <a href="/files/<%= x.file_path %>" target="_blank"><i class="bi bi-paperclip"></i> <%= x.file_name || 'فایل' %></a><% } %></td>
          <% if (enabled('homework.grade')) { %><td><input class="form-control form-control-sm ltr text-center" name="score_<%= st.id %>" value="<%= x && x.score != null ? J.toPersianDigits(x.score) : '' %>" <%= manage ? '' : 'readonly' %> aria-label="نمره"></td><td><input class="form-control form-control-sm" name="feedback_<%= st.id %>" value="<%= x && x.feedback ? x.feedback : '' %>" <%= manage ? '' : 'readonly' %> aria-label="بازخورد"></td><% } %></tr><% }); %>
      </tbody></table></div>
      <% if (manage && enabled('homework.grade')) { %><div class="card-footer bg-transparent text-end"><button class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>ذخیرهٔ نمرات</button></div><% } %>
    </form>
    <% } %>
  </div>
  <% if (s) { %>
  <div class="col-lg-5">
    <div class="card"><div class="card-header"><h6><i class="bi bi-send me-1"></i>پاسخ من</h6><% if (sub) { %><%- utils.statusBadge(sub.status) %><% } %></div>
      <div class="card-body">
        <% if (sub && sub.score != null) { %><div class="alert alert-success"><div class="fs-4 fw-bold"><%= J.toPersianDigits(sub.score) %> <span class="fs-7 fw-normal">از <%= J.toPersianDigits(hw.max_score) %></span></div><% if (sub.feedback) { %><div class="mt-1"><i class="bi bi-chat-quote me-1"></i><%= sub.feedback %></div><% } %></div><% } else if (sub && sub.feedback) { %><div class="alert alert-info"><i class="bi bi-chat-quote me-1"></i><%= sub.feedback %></div><% } %>
        <% if (sub && sub.submitted_at) { %><div class="fs-7 text-secondary mb-2">ارسال‌شده در <%= J.formatDateTime(sub.submitted_at) %></div><% if (sub.content) { %><div class="border rounded p-2 mb-2 fs-7"><%- utils.nl2br(utils.escapeHtml(sub.content)) %></div><% } %><% if (sub.file_path) { %><a href="/files/<%= sub.file_path %>" target="_blank" class="btn btn-sm btn-light mb-3"><i class="bi bi-paperclip me-1"></i><%= sub.file_name || 'فایل ارسالی' %></a><% } %><% } %>
        <% if (canSubmit) { %><form method="post" action="/homework/<%= hw.id %>/submit" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (isLate) { %><div class="alert alert-warning fs-7 py-2">مهلت گذشته است؛ ارسال شما با برچسب «با تأخیر» ثبت می‌شود.</div><% } %>
          <textarea class="form-control mb-2" name="content" rows="5" placeholder="متن پاسخ…"><%= sub && sub.content ? sub.content : '' %></textarea>
          <input type="file" class="form-control form-control-sm mb-3" name="file" aria-label="فایل">
          <button class="btn btn-primary w-100"><i class="bi bi-send me-1"></i><%= sub && sub.submitted_at ? 'ویرایش و ارسال مجدد' : 'ارسال پاسخ' %></button></form>
        <% } else if (!sub || !sub.submitted_at) { %><div class="text-secondary fs-7"><%= hw.allow_submission ? 'مهلت ارسال به پایان رسیده است.' : 'این تکلیف نیاز به ارسال آنلاین ندارد.' %></div><% } %>
      </div></div>
  </div>
  <% } %>
</div>
