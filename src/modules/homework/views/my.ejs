<%- include('partials/page-header', { title: 'تکالیف من', icon: 'bi-journal-check', actions: enabled('homework.materials') ? [{ href: '/homework/materials', label: 'محتوای آموزشی', icon: 'bi-folder2-open', class: 'btn-light' }] : [] }) %>
<% if (typeof counts !== 'undefined') { %><ul class="nav nav-pills mb-3"><% [['pending', 'در انتظار انجام'], ['submitted', 'ارسال‌شده'], ['graded', 'نمره‌داده‌شده'], ['missing', 'ارسال‌نشده'], ['all', 'همه']].forEach(function (x) { %><li class="nav-item"><a class="nav-link <%= tab === x[0] ? 'active' : '' %>" href="?tab=<%= x[0] %>"><%= x[1] %> <span class="badge rounded-pill text-bg-light"><%= J.toPersianDigits(counts[x[0]]) %></span></a></li><% }); %></ul><% } %>
<div class="row g-3"><% rows.forEach(function (h) { var days = J.diffDays(today, h.due_date); %>
  <div class="col-md-6 col-xl-4"><div class="card h-100 <%= h.state === 'pending' && days <= 2 ? 'border-warning' : '' %>"><div class="card-body">
    <div class="d-flex justify-content-between align-items-start"><span class="badge badge-soft-primary"><%= h.subject_title %></span><%- h.state === 'graded' ? '<span class="badge text-bg-success">' + J.toPersianDigits(h.score) + ' / ' + J.toPersianDigits(h.max_score) + '</span>' : h.state === 'submitted' ? '<span class="badge badge-soft-info">ارسال شده</span>' : h.state === 'missing' ? '<span class="badge badge-soft-danger">ارسال نشده</span>' : (days <= 2 ? '<span class="badge text-bg-warning">' + (days === 0 ? 'امروز' : J.toPersianDigits(days) + ' روز مانده') + '</span>' : '<span class="badge badge-soft-secondary">' + J.toPersianDigits(days) + ' روز مانده</span>') %></div>
    <h6 class="mt-2 mb-1"><a href="/homework/<%= h.id %>" class="text-body"><%= h.title %></a></h6>
    <div class="fs-7 text-secondary">مهلت: <%= J.formatLong(h.due_date) %></div>
    <% if (h.description) { %><div class="fs-7 mt-2"><%= utils.truncate(h.description, 100) %></div><% } %>
    <% if (h.feedback) { %><div class="fs-7 mt-2 text-success"><i class="bi bi-chat-quote me-1"></i><%= utils.truncate(h.feedback, 80) %></div><% } %>
  </div><div class="card-footer bg-transparent d-flex justify-content-between align-items-center fs-7"><span><% if (h.file_path) { %><i class="bi bi-paperclip"></i> پیوست<% } %></span><a href="/homework/<%= h.id %>" class="btn btn-sm btn-<%= h.state === 'pending' ? 'primary' : 'light' %>"><%= h.state === 'pending' && h.allow_submission ? 'ارسال پاسخ' : 'مشاهده' %></a></div></div></div>
<% }); if (!rows.length) { %><div class="col-12"><div class="card"><%- include('partials/empty', { message: 'تکلیفی در این بخش نیست', icon: 'bi-journal-check' }) %></div></div><% } %></div>
