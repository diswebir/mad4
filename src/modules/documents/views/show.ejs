<% var t = TYPES[doc.type] || { title: doc.type }; %>
<% if (doc.status === 'revoked') { %><div class="alert alert-danger py-2 no-print"><i class="bi bi-x-octagon me-1"></i>این سند در تاریخ <%= J.formatDateTime(doc.revoked_at) %> باطل شده است<%= doc.revoke_reason ? ' — ' + doc.revoke_reason : '' %>.</div><% } %>
<div class="official-doc position-relative" style="max-width:820px;margin:0 auto;min-height:900px;padding:10px 6px">
  <% if (doc.status === 'revoked') { %><div style="position:absolute;top:35%;left:0;right:0;text-align:center;font-size:84px;color:rgba(220,38,38,.18);transform:rotate(-20deg);font-weight:800;pointer-events:none">باطل شد</div><% } %>
  <%- include('partials/letterhead', { lh: lh, serial: doc.serial, date: doc.issued_at }) %>
  <% if (doc.type === 'report_card' && data) { %>
    <h5 class="text-center fw-bold mb-1">کارنامهٔ تحصیلی <%= data.term.title %> — سال تحصیلی <%= J.toPersianDigits(data.term.year) %> <% if (data.term.is_locked) { %><span class="badge text-bg-success align-middle" style="font-size:.7rem">نهایی</span><% } else { %><span class="badge text-bg-secondary align-middle" style="font-size:.7rem">موقت</span><% } %></h5>
    <%- include('_rc', { data: data }) %>
  <% } else { %>
    <h5 class="text-center fw-bold mb-3 mt-2"><%= doc.title %></h5>
    <% if (doc.recipient) { %><div class="mb-2 fw-bold">به: <%= doc.recipient %></div><% } %>
    <% if (doc.purpose) { %><div class="mb-2 fw-bold">موضوع: <%= doc.purpose %></div><% } %>
    <div class="doc-body" style="white-space:pre-wrap;line-height:2.2;font-size:14.5px;text-align:justify"><%= doc.body %></div>
  <% } %>
  <%- include('partials/signature', { lh: lh, verifyCode: doc.verify_code }) %>
</div>
<% if (canIssue) { %><div class="no-print text-center mt-3 fs-7 text-secondary">صادرکننده: <%= doc.issuer_name || '—' %> · کد استعلام: <code><%= doc.verify_code %></code> · <a href="/documents">بازگشت به بایگانی</a></div><% } %>
