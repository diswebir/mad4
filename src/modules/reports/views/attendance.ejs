<% if (!print) { %><%- include('partials/page-header', { title: 'گزارش حضور و غیاب', subtitle: J.formatDate(from) + ' تا ' + J.formatDate(to), icon: 'bi-calendar-check', breadcrumbs: [{ title: 'گزارش‌ها', href: '/reports' }, { title: 'حضور و غیاب' }], actions: [...(enabled('reports.print') ? [{ href: '/reports/attendance?print=1&from=' + J.formatDate(from) + '&to=' + J.formatDate(to), label: 'چاپ', icon: 'bi-printer', class: 'btn-light' }] : []), ...(enabled('reports.export') ? [{ href: '/reports/attendance?export=1&from=' + J.formatDate(from) + '&to=' + J.formatDate(to), label: 'CSV', icon: 'bi-download', class: 'btn-light' }] : [])] }) %>
<form method="get" class="card mb-3"><div class="card-body py-2 d-flex flex-wrap gap-2 align-items-end"><div><label class="form-label fs-7 mb-0">از</label><input class="form-control form-control-sm jdate" name="from" value="<%= J.formatDate(from) %>"></div><div><label class="form-label fs-7 mb-0">تا</label><input class="form-control form-control-sm jdate" name="to" value="<%= J.formatDate(to) %>"></div><button class="btn btn-sm btn-primary">نمایش</button></div></form><% } else { %><h4 class="text-center mb-3">گزارش حضور و غیاب — <%= J.formatDate(from) %> تا <%= J.formatDate(to) %></h4><% } %>
<div class="row g-3"><div class="col-lg-8"><div class="card table-card"><div class="card-header"><h6>به تفکیک کلاس</h6></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>کلاس</th><th>ثبت‌ها</th><th>حاضر</th><th>غایب</th><th>تأخیر</th><th>موجه</th><th>درصد غیبت</th></tr></thead><tbody>
<% rows.forEach(function (r) { %><tr><td class="fw-semibold"><% if (!print) { %><a href="/attendance/report/class/<%= r.id %>" class="text-body"><% } %><%= r.title %><% if (!print) { %></a><% } %></td><td><%= J.toPersianDigits(r.total) %></td><td class="text-success"><%= J.toPersianDigits(r.present) %></td><td class="text-danger"><%= J.toPersianDigits(r.absent) %></td><td class="text-warning"><%= J.toPersianDigits(r.late) %></td><td><%= J.toPersianDigits(r.excused) %></td><td><div class="d-flex align-items-center gap-1"><div class="progress flex-grow-1" style="height:6px;min-width:60px"><div class="progress-bar bg-danger" style="width:<%= Math.min(100, r.absentRate * 5) %>%"></div></div><span class="fs-7"><%= J.toPersianDigits(r.absentRate) %>٪</span></div></td></tr><% }); if (!rows.length) { %><tr><td colspan="7" class="text-center text-secondary py-3">داده‌ای در این بازه نیست</td></tr><% } %>
</tbody></table></div></div>
<div class="card mt-3"><div class="card-header"><h6>درصد غیبت به تفکیک روز هفته</h6></div><div class="card-body d-flex flex-wrap gap-3"><% weekdays.slice(0, 5).forEach(function (w) { %><div class="text-center flex-fill"><div class="fs-4 fw-bold <%= w.rate > 8 ? 'text-danger' : '' %>"><%= J.toPersianDigits(w.rate) %>٪</div><div class="fs-7 text-secondary"><%= w.label %></div></div><% }); %></div></div></div>
<div class="col-lg-4"><div class="card table-card"><div class="card-header"><h6><i class="bi bi-person-x text-danger me-1"></i>بیشترین غیبت</h6></div><div class="table-responsive"><table class="table table-sm mb-0"><tbody><% top.forEach(function (s, i) { %><tr><td class="text-secondary"><%= J.toPersianDigits(i + 1) %></td><td><% if (!print) { %><a href="/students/<%= s.id %>" class="text-body"><% } %><%= s.first_name %> <%= s.last_name %><% if (!print) { %></a><% } %><div class="fs-7 text-secondary"><%= s.class_title || '' %></div></td><td class="fw-bold text-danger"><%= J.toPersianDigits(s.absent) %></td></tr><% }); %></tbody></table></div></div></div></div>
