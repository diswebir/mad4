<% if (!print) { %><%- include('partials/page-header', { title: 'گزارش دانش‌آموزان', icon: 'bi-mortarboard', breadcrumbs: [{ title: 'گزارش‌ها', href: '/reports' }, { title: 'دانش‌آموزان' }], actions: [...(enabled('reports.print') ? [{ href: '/reports/students?print=1', label: 'چاپ', icon: 'bi-printer', class: 'btn-light' }] : []), ...(enabled('reports.export') ? [{ href: '/reports/students?export=1', label: 'CSV', icon: 'bi-download', class: 'btn-light' }] : [])] }) %><% } else { %><h4 class="text-center mb-3">گزارش دانش‌آموزان — <%= J.formatLong(J.todayISO()) %></h4><% } %>
<div class="row g-3"><div class="col-lg-8"><div class="card table-card"><div class="card-header"><h6>به تفکیک کلاس</h6></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>کلاس</th><th>پایه</th><th>معلم راهنما</th><th>تعداد</th><th>پسر</th><th>دختر</th><th>ظرفیت</th><th>سرویس</th><th>پزشکی</th></tr></thead><tbody>
<% rows.forEach(function (r) { var pct = r.capacity ? Math.round(r.total / r.capacity * 100) : 0; %><tr><td class="fw-semibold"><%= r.title %></td><td><%= r.grade || '' %></td><td class="fs-7"><%= r.teacher || '—' %></td><td><%= J.toPersianDigits(r.total) %></td><td><%= J.toPersianDigits(r.male) %></td><td><%= J.toPersianDigits(r.female) %></td><td><div class="d-flex align-items-center gap-1"><div class="progress flex-grow-1" style="height:6px;min-width:50px"><div class="progress-bar <%= pct > 100 ? 'bg-danger' : '' %>" style="width:<%= Math.min(100, pct) %>%"></div></div><span class="fs-7"><%= J.toPersianDigits(r.capacity || 0) %></span></div></td><td><%= J.toPersianDigits(r.transport) %></td><td><%= J.toPersianDigits(r.medical) %></td></tr><% }); %>
</tbody><tfoot class="table-light fw-semibold"><tr><td colspan="3">جمع</td><td><%= J.toPersianDigits(totals.total) %></td><td><%= J.toPersianDigits(totals.male) %></td><td><%= J.toPersianDigits(totals.female) %></td><td><%= J.toPersianDigits(totals.capacity) %></td><td colspan="2"></td></tr></tfoot></table></div></div></div>
<div class="col-lg-4"><div class="card mb-3"><div class="card-header"><h6>توزیع سنی</h6></div><div class="card-body"><% var maxA = Math.max.apply(null, ages.map(function (a) { return a[1]; }).concat([1])); ages.forEach(function (a) { %><div class="d-flex align-items-center gap-2 fs-7 mb-1"><span style="width:60px"><%= J.toPersianDigits(a[0]) %> سال</span><div class="progress flex-grow-1" style="height:10px"><div class="progress-bar" style="width:<%= Math.round(a[1] / maxA * 100) %>%"></div></div><span style="width:30px"><%= J.toPersianDigits(a[1]) %></span></div><% }); %></div></div>
<div class="card mb-3"><div class="card-header"><h6>وضعیت تحصیلی</h6></div><ul class="list-group list-group-flush"><% byStatus.forEach(function (s) { %><li class="list-group-item d-flex justify-content-between"><span><%- utils.statusBadge(s.status) %></span><strong><%= J.toPersianDigits(s.c) %></strong></li><% }); %></ul></div>
<% if (byEdu.length) { %><div class="card"><div class="card-header"><h6>تحصیلات پدر</h6></div><ul class="list-group list-group-flush"><% byEdu.forEach(function (e) { %><li class="list-group-item d-flex justify-content-between fs-7"><span><%= e.father_education %></span><strong><%= J.toPersianDigits(e.c) %></strong></li><% }); %></ul></div><% } %></div></div>
