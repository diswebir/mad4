<% if (!print) { %><%- include('partials/page-header', { title: 'گزارش نمرات', icon: 'bi-award', breadcrumbs: [{ title: 'گزارش‌ها', href: '/reports' }, { title: 'نمرات' }], actions: [...(enabled('reports.print') ? [{ href: '/reports/grades?print=1&term_id=' + termId, label: 'چاپ', icon: 'bi-printer', class: 'btn-light' }] : []), ...(enabled('reports.export') ? [{ href: '/reports/grades?export=1&term_id=' + termId, label: 'CSV', icon: 'bi-download', class: 'btn-light' }] : [])] }) %>
<form method="get" class="mb-3 d-flex gap-2 align-items-center"><label class="fs-7">نوبت:</label><select class="form-select form-select-sm w-auto" name="term_id" data-auto-submit><% terms.forEach(function (t) { %><option value="<%= t.id %>" <%= Number(termId) === t.id ? 'selected' : '' %>><%= t.title %></option><% }); %></select></form><% } else { %><h4 class="text-center mb-3">گزارش نمرات</h4><% } %>
<div class="card table-card mb-3"><div class="card-header"><h6>میانگین کلاس × درس (از ۲۰)</h6></div><div class="table-responsive"><table class="table table-sm table-bordered align-middle mb-0 text-center" style="font-size:.8rem"><thead><tr><th class="text-start">کلاس</th><% subjects.forEach(function (s) { %><th><%= s %></th><% }); %><th>میانگین</th></tr></thead><tbody>
<% matrix.forEach(function (m) { %><tr><td class="text-start fw-semibold"><%= m.cls %></td><% m.cells.forEach(function (c) { var a = c ? Math.round(c.avg * 10) / 10 : null; %><td class="<%= a == null ? 'text-secondary' : a < 10 ? 'table-danger' : a >= 17 ? 'table-success' : '' %>"><%= a == null ? '—' : J.toPersianDigits(a) %></td><% }); %><td class="fw-bold"><%= m.avg == null ? '—' : J.toPersianDigits(Math.round(m.avg * 100) / 100) %></td></tr><% }); if (!matrix.length) { %><tr><td colspan="<%= subjects.length + 2 %>" class="py-3 text-secondary">نمره‌ای برای این نوبت ثبت نشده</td></tr><% } %>
</tbody></table></div></div>
<div class="row g-3"><div class="col-lg-6"><div class="card table-card"><div class="card-header"><h6>دروس با کمترین میانگین</h6></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>درس</th><th>میانگین</th><th>تعداد نمره</th><th>زیر ۱۰</th></tr></thead><tbody><% subjAvg.slice(0, 10).forEach(function (s) { %><tr><td><%= s.subject %></td><td class="<%= s.avg < 12 ? 'text-danger fw-semibold' : '' %>"><%= s.avg == null ? '—' : J.toPersianDigits(Math.round(s.avg * 100) / 100) %></td><td><%= J.toPersianDigits(s.n) %></td><td><%= J.toPersianDigits(s.fails) %> (<%= s.n ? J.toPersianDigits(Math.round(s.fails / s.n * 100)) : '۰' %>٪)</td></tr><% }); %></tbody></table></div></div></div>
<div class="col-lg-6"><div class="card"><div class="card-header"><h6>نمودار میانگین کلاس‌ها</h6></div><div class="card-body"><canvas id="chCls" height="180"></canvas></div></div></div></div>
<% if (!print) { %><script src="/assets/vendor/chartjs/chart.umd.min.js"></script><script>new Chart(document.getElementById('chCls'),{type:'bar',data:{labels:<%- JSON.stringify(matrix.map(function (m) { return m.cls; })) %>,datasets:[{data:<%- JSON.stringify(matrix.map(function (m) { return m.avg == null ? 0 : Math.round(m.avg * 100) / 100; })) %>,backgroundColor:'#2563eb',borderRadius:6}]},options:{plugins:{legend:{display:false}},scales:{y:{min:0,max:20}}}});</script><% } %>
