<%- include('partials/page-header', { title: 'گزارش‌ها و آمار', icon: 'bi-graph-up-arrow' }) %>
<div class="row g-3 mb-3">
  <% [['دانش‌آموزان فعال', counts.students, 'bi-mortarboard', 'primary'], ['معلمان', counts.teachers, 'bi-person-workspace', 'success'], ['کلاس‌ها', counts.classes, 'bi-door-open', 'info'], ['کاربران فعال', counts.users, 'bi-people', 'warning']].forEach(function (c) { %><div class="col-6 col-xl-3"><div class="card stat-card"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-<%= c[3] %>"><i class="bi <%= c[2] %>"></i></div><div><div class="fs-7 text-secondary"><%= c[0] %></div><div class="fs-4 fw-bold"><%= J.toPersianDigits(c[1]) %></div></div></div></div></div><% }); %>
</div>
<div class="row g-3 mb-3">
  <% [['students', 'گزارش دانش‌آموزان', 'bi-mortarboard', 'ترکیب جمعیتی به تفکیک کلاس، جنسیت، سن و وضعیت'], ['attendance', 'گزارش حضور و غیاب', 'bi-calendar-check', 'نرخ غیبت و تأخیر کلاس‌ها و دانش‌آموزان پرغیبت'], ['grades', 'گزارش نمرات', 'bi-award', 'میانگین کلاس‌ها در هر درس و دروس ضعیف'], ['teachers', 'گزارش معلمان', 'bi-person-workspace', 'بار کاری و ساعت تدریس']].forEach(function (r) { if (!enabled('reports.' + r[0])) return; %>
  <div class="col-md-6 col-xl-3"><a href="/reports/<%= r[0] %>" class="card h-100 text-decoration-none text-body"><div class="card-body"><i class="bi <%= r[2] %> fs-3 text-primary"></i><h6 class="mt-2"><%= r[1] %></h6><div class="fs-7 text-secondary"><%= r[3] %></div></div></a></div><% }); %>
  <% if (enabled('finance.reports')) { %><div class="col-md-6 col-xl-3"><a href="/finance/reports" class="card h-100 text-decoration-none text-body"><div class="card-body"><i class="bi bi-cash-stack fs-3 text-primary"></i><h6 class="mt-2">گزارش مالی</h6><div class="fs-7 text-secondary">وصولی، معوقات و بدهکاران</div></div></a></div><% } %>
  <% if (enabled('discipline.report')) { %><div class="col-md-6 col-xl-3"><a href="/discipline/report" class="card h-100 text-decoration-none text-body"><div class="card-body"><i class="bi bi-shield-check fs-3 text-primary"></i><h6 class="mt-2">گزارش انضباطی</h6><div class="fs-7 text-secondary">رتبه‌بندی انضباطی کلاس</div></div></a></div><% } %>
  <% if (enabled('tickets.stats')) { %><div class="col-md-6 col-xl-3"><a href="/tickets/stats" class="card h-100 text-decoration-none text-body"><div class="card-body"><i class="bi bi-chat-left-text fs-3 text-primary"></i><h6 class="mt-2">آمار تیکت‌ها</h6><div class="fs-7 text-secondary">وضعیت، دسته و زمان پاسخ</div></div></a></div><% } %>
  <% if (enabled('exams.analytics')) { %><div class="col-md-6 col-xl-3"><a href="/exams/analytics" class="card h-100 text-decoration-none text-body"><div class="card-body"><i class="bi bi-graph-up fs-3 text-primary"></i><h6 class="mt-2">تحلیل نمرات</h6><div class="fs-7 text-secondary">توزیع نمرات، برترین‌ها و مقایسه</div></div></a></div><% } %>
</div>
<div class="row g-3">
  <div class="col-lg-6"><div class="card"><div class="card-header"><h6>دانش‌آموزان به تفکیک پایه</h6></div><div class="card-body"><canvas id="chGrade" height="140"></canvas></div></div></div>
  <div class="col-lg-3"><div class="card h-100"><div class="card-header"><h6>جنسیت</h6></div><div class="card-body"><canvas id="chGender" height="200"></canvas></div></div></div>
  <div class="col-lg-3"><div class="card h-100"><div class="card-header"><h6>وضعیت تحصیلی</h6></div><div class="card-body"><canvas id="chStatus" height="200"></canvas></div></div></div>
  <% if (attTrend.length) { %><div class="col-lg-7"><div class="card"><div class="card-header"><h6>روند غیبت و تأخیر (۳۰ روز اخیر، درصد)</h6></div><div class="card-body"><canvas id="chAtt" height="120"></canvas></div></div></div><% } %>
  <% if (classAvg.length) { %><div class="col-lg-5"><div class="card"><div class="card-header"><h6>میانگین نمرات کلاس‌ها (از ۲۰)</h6></div><div class="card-body"><canvas id="chAvg" height="170"></canvas></div></div></div><% } %>
</div>
<script src="/assets/vendor/chartjs/chart.umd.min.js"></script>
<script>(function(){Chart.defaults.font.family='Vazirmatn';var P=['#2563eb','#059669','#d97706','#7c3aed','#dc2626','#0891b2','#64748b','#db2777'];
new Chart(document.getElementById('chGrade'),{type:'bar',data:{labels:<%- JSON.stringify(byGrade.map(function (g) { return g.title; })) %>,datasets:[{data:<%- JSON.stringify(byGrade.map(function (g) { return Number(g.c); })) %>,backgroundColor:'#2563eb',borderRadius:6}]},options:{plugins:{legend:{display:false}}}});
new Chart(document.getElementById('chGender'),{type:'doughnut',data:{labels:<%- JSON.stringify(byGender.map(function (g) { return GENDERS[g.gender] || g.gender || 'نامشخص'; })) %>,datasets:[{data:<%- JSON.stringify(byGender.map(function (g) { return Number(g.c); })) %>,backgroundColor:P}]},options:{plugins:{legend:{position:'bottom'}}}});
new Chart(document.getElementById('chStatus'),{type:'pie',data:{labels:<%- JSON.stringify(byStatus.map(function (g) { return STATUS[g.status] || g.status; })) %>,datasets:[{data:<%- JSON.stringify(byStatus.map(function (g) { return Number(g.c); })) %>,backgroundColor:P}]},options:{plugins:{legend:{position:'bottom'}}}});
<% if (attTrend.length) { %>new Chart(document.getElementById('chAtt'),{type:'line',data:{labels:<%- JSON.stringify(attTrend.map(function (a) { return a.label; })) %>,datasets:[{label:'غیبت',data:<%- JSON.stringify(attTrend.map(function (a) { return a.absent; })) %>,borderColor:'#dc2626',tension:.3},{label:'تأخیر',data:<%- JSON.stringify(attTrend.map(function (a) { return a.late; })) %>,borderColor:'#d97706',tension:.3}]},options:{scales:{y:{beginAtZero:true}}}});<% } %>
<% if (classAvg.length) { %>new Chart(document.getElementById('chAvg'),{type:'bar',data:{labels:<%- JSON.stringify(classAvg.map(function (c) { return c.title; })) %>,datasets:[{data:<%- JSON.stringify(classAvg.map(function (c) { return Math.round(Number(c.avg) * 100) / 100; })) %>,backgroundColor:'#059669',borderRadius:6}]},options:{indexAxis:'y',plugins:{legend:{display:false}},scales:{x:{min:0,max:20}}}});<% } %>})();</script>
