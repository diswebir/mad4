<% if (!print) { %><%- include('partials/page-header', { title: 'گزارش معلمان', subtitle: 'میانگین ساعت تدریس هفتگی: ' + J.toPersianDigits(avgHours), icon: 'bi-person-workspace', breadcrumbs: [{ title: 'گزارش‌ها', href: '/reports' }, { title: 'معلمان' }], actions: [...(enabled('reports.print') ? [{ href: '/reports/teachers?print=1', label: 'چاپ', icon: 'bi-printer', class: 'btn-light' }] : []), ...(enabled('reports.export') ? [{ href: '/reports/teachers?export=1', label: 'CSV', icon: 'bi-download', class: 'btn-light' }] : [])] }) %><% } else { %><h4 class="text-center mb-3">گزارش بار کاری معلمان</h4><% } %>
<div class="card table-card"><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>#</th><th>معلم</th><th>رشته</th><th>نوع همکاری</th><th>کلاس‌ها</th><th>دروس</th><th>ساعت هفتگی</th><th>سرپرستی کلاس</th><th>مرخصی تأییدشده</th><th>وضعیت</th></tr></thead><tbody>
<% var maxH = Math.max.apply(null, rows.map(function (r) { return Number(r.hours); }).concat([1])); rows.forEach(function (r, i) { %><tr><td class="text-secondary"><%= J.toPersianDigits(i + 1) %></td><td class="fw-semibold"><% if (!print) { %><a href="/teachers/<%= r.id %>" class="text-body"><% } %><%= r.name %><% if (!print) { %></a><% } %></td><td><%= r.field || '' %></td><td class="fs-7"><%= r.employment_type || '' %></td><td><%= J.toPersianDigits(r.classes) %></td><td><%= J.toPersianDigits(r.subjects) %></td><td><div class="d-flex align-items-center gap-1"><div class="progress flex-grow-1" style="height:6px;min-width:60px"><div class="progress-bar <%= Number(r.hours) > 24 ? 'bg-danger' : '' %>" style="width:<%= Math.round(Number(r.hours) / maxH * 100) %>%"></div></div><span class="fs-7"><%= J.toPersianDigits(r.hours) %></span></div></td><td><%- Number(r.homeroom) ? '<i class="bi bi-check-circle text-success"></i>' : '' %></td><td><%= J.toPersianDigits(r.leaves) %></td><td><%- utils.statusBadge(r.status) %></td></tr><% }); %>
</tbody></table></div></div>
