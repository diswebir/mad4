<%- include('partials/page-header', { title: 'لاگ پیامک', icon: 'bi-chat-left-dots', subtitle: 'همهٔ پیامک‌های ارسال‌شده از سامانه (در حالت درگاه «لاگ»، متن‌ها فقط اینجا ثبت می‌شوند و ارسال واقعی انجام نمی‌شود)', breadcrumbs: [{ title: 'سیستم' }, { title: 'لاگ پیامک' }] }) %>
<div class="row g-3 mb-3">
  <div class="col-6 col-xl-3"><div class="card stat-card text-success"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-success"><i class="bi bi-send-check"></i></div><div><div class="value"><%= J.toPersianDigits(stats.sent || 0) %></div><div class="label">ارسال‌شده</div></div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card text-danger"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-danger"><i class="bi bi-send-x"></i></div><div><div class="value"><%= J.toPersianDigits(stats.failed || 0) %></div><div class="label">ناموفق</div></div></div></div></div>
  <div class="col-12 col-xl-6"><div class="card h-100"><div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2"><div><div class="fw-bold">وضعیت درگاه</div><div class="fs-7 text-muted">ارسال پیامک: <span class="badge text-bg-<%= smsEnabled ? 'success' : 'secondary' %>"><%= smsEnabled ? 'فعال' : 'غیرفعال' %></span> — درگاه: <code><%= provider %></code></div></div><a href="/system/settings?tab=sms" class="btn btn-sm btn-outline-primary"><i class="bi bi-sliders me-1"></i>تنظیمات پیامک</a></div></div></div>
</div>
<div class="card table-card">
  <div class="card-header flex-wrap gap-2">
    <form class="d-flex gap-2 flex-wrap" method="get">
      <input class="form-control form-control-sm" name="q" value="<%= f.q %>" placeholder="شماره یا متن" style="width:200px">
      <select class="form-select form-select-sm w-auto" name="status"><option value="">همه</option><option value="sent" <%= f.status === 'sent' ? 'selected' : '' %>>ارسال‌شده</option><option value="failed" <%= f.status === 'failed' ? 'selected' : '' %>>ناموفق</option></select>
      <select class="form-select form-select-sm w-auto" name="context"><option value="">همهٔ انواع</option><% contexts.forEach(function (c) { %><option value="<%= c %>" <%= f.context === c ? 'selected' : '' %>><%= c %></option><% }) %></select>
      <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
    </form>
    <form method="post" action="/system/sms-log/clear" onsubmit="return confirm('لاگ‌های قدیمی‌تر از ۳۰ روز پاک شوند؟')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>پاک‌سازی قدیمی‌ها</button></form>
  </div>
  <div class="table-responsive"><table class="table table-hover mb-0 fs-7"><thead><tr><th>زمان</th><th>گیرنده</th><th>متن</th><th>نوع</th><th>درگاه</th><th>وضعیت</th></tr></thead><tbody>
  <% if (!rows.length) { %><tr><td colspan="6"><%- include('partials/empty', { message: 'پیامکی ثبت نشده است' }) %></td></tr><% } %>
  <% rows.forEach(function (r) { %><tr><td class="text-nowrap"><%= J.formatDateTime(r.created_at) %></td><td dir="ltr" class="text-end"><%= J.toPersianDigits(r.recipient) %></td><td style="white-space:pre-wrap;max-width:420px"><%= r.message %></td><td><code><%= r.context || '' %></code></td><td><%= r.provider %></td><td><span class="badge text-bg-<%= r.status === 'sent' ? 'success' : 'danger' %>" title="<%= r.error || '' %>"><%= r.status === 'sent' ? 'ارسال' : 'ناموفق' %></span><% if (r.error) { %><div class="text-danger"><%= r.error %></div><% } %></td></tr><% }) %>
  </tbody></table></div>
  <% if (pages > 1) { %><div class="card-footer"><%- include('partials/pagination', { result: { page: page, pages: pages } }) %></div><% } %>
</div>
