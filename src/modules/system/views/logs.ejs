<%- include('partials/page-header', { title: 'گزارش خطاها و لاگ سامانه', icon: 'bi-bug', subtitle: 'خطاهای سرور (۵xx)، استثناهای مدیریت‌نشده، شکست کارهای زمان‌بندی‌شده و ارسال پیامک/ایمیل — فایل‌های روزانه در storage/logs', breadcrumbs: [{ title: 'گزارش خطاها' }], actions: [
  { post: '/system/logs/test', label: 'ثبت خطای آزمایشی', icon: 'bi-lightning', class: 'btn-outline-secondary' },
  { post: '/system/logs/prune', label: 'حذف فایل‌های قدیمی', icon: 'bi-trash', class: 'btn-outline-danger', confirm: 'فایل‌های لاگ قدیمی‌تر از مدت تنظیم‌شده حذف شوند؟' }
] }) %>
<div class="row g-3 mb-3">
  <div class="col-6 col-xl-3"><div class="card stat-card text-danger"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-danger"><i class="bi bi-x-octagon"></i></div><div><div class="value"><%= J.toPersianDigits(counts.error || 0) %></div><div class="label">خطا در این روز</div></div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card text-warning"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-warning"><i class="bi bi-exclamation-triangle"></i></div><div><div class="value"><%= J.toPersianDigits(counts.warn || 0) %></div><div class="label">هشدار در این روز</div></div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card text-primary"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-primary"><i class="bi bi-files"></i></div><div><div class="value"><%= J.toPersianDigits(files.length) %></div><div class="label">فایل لاگ</div></div></div></div></div>
  <div class="col-6 col-xl-3"><div class="card stat-card text-secondary"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-secondary"><i class="bi bi-activity"></i></div><div><div class="value"><%= J.toPersianDigits(stats.error || 0) %></div><div class="label">خطا از زمان اجرای فعلی</div></div></div></div></div>
</div>
<div class="row g-3">
  <div class="col-lg-3">
    <div class="card"><div class="card-header"><h6><i class="bi bi-calendar3 me-1"></i>فایل‌های روزانه</h6></div>
      <div class="list-group list-group-flush" style="max-height:520px;overflow:auto">
        <% if (!files.length) { %><div class="list-group-item text-muted fs-7">هنوز فایلی ایجاد نشده است — یعنی خطایی رخ نداده.</div><% } %>
        <% files.forEach(function (f) { %><a href="/system/logs?date=<%= f.date %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center <%= f.date === date ? 'active' : '' %>"><span><%= J.formatDate(f.date) %><br><small class="<%= f.date === date ? '' : 'text-muted' %> ltr d-inline-block"><%= f.date %></small></span><span class="badge bg-light text-dark"><%= J.toPersianDigits(Math.max(1, Math.round(f.size / 1024))) %> KB</span></a><% }); %>
      </div>
      <div class="card-footer fs-7 text-muted ltr text-start"><%= logDir %></div>
    </div>
  </div>
  <div class="col-lg-9">
    <div class="card table-card">
      <div class="card-header flex-wrap gap-2">
        <form class="d-flex gap-2 flex-wrap" method="get">
          <input type="hidden" name="date" value="<%= date %>">
          <input class="form-control form-control-sm" name="q" value="<%= q %>" placeholder="جستجو در متن/آدرس/کاربر" style="width:220px">
          <select class="form-select form-select-sm w-auto" name="level"><option value="">همهٔ سطوح</option><% Object.keys(LOG_LEVELS).forEach(function (k) { %><option value="<%= k %>" <%= level === k ? 'selected' : '' %>><%= LOG_LEVELS[k] %></option><% }); %></select>
          <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
        </form>
        <div class="d-flex gap-2">
          <% if (files.some(function (f) { return f.date === date; })) { %>
            <a class="btn btn-sm btn-outline-secondary" href="/system/logs/download?date=<%= date %>"><i class="bi bi-download me-1"></i>دانلود</a>
            <form method="post" action="/system/logs/delete" onsubmit="return confirm('فایل لاگ این روز حذف شود؟')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="date" value="<%= date %>"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form>
          <% } %>
        </div>
      </div>
      <div class="table-responsive"><table class="table table-hover mb-0 fs-7 align-middle"><thead><tr><th style="width:120px">زمان</th><th style="width:80px">سطح</th><th>پیام</th><th>درخواست</th><th style="width:40px"></th></tr></thead><tbody>
      <% if (!rows.length) { %><tr><td colspan="5"><%- include('partials/empty', { message: 'رخدادی برای این روز/فیلتر ثبت نشده است' }) %></td></tr><% } %>
      <% rows.forEach(function (r, i) { var cls = r.level === 'error' ? 'danger' : r.level === 'warn' ? 'warning' : r.level === 'info' ? 'primary' : 'secondary'; var hasDetail = r.error && r.error.stack; %>
        <tr>
          <td class="text-nowrap"><%= J.formatDateTime(r.t) %></td>
          <td><span class="badge text-bg-<%= cls %>"><%= LOG_LEVELS[r.level] || r.level %></span></td>
          <td><div class="fw-semibold"><%= r.message %></div><% if (r.error && r.error.message && r.error.message !== r.message) { %><div class="text-muted ltr text-start" style="font-family:monospace;font-size:.72rem"><%= r.error.message %></div><% } %><% if (r.job) { %><span class="badge bg-light text-dark">کار: <%= r.job %></span><% } %><% if (r.test) { %><span class="badge bg-light text-dark">آزمایشی</span><% } %></td>
          <td class="fs-7"><% if (r.url) { %><span class="ltr d-inline-block text-start" style="font-family:monospace;font-size:.72rem"><%= r.method %> <%= r.url %></span><% } %><% if (r.user) { %><br><i class="bi bi-person me-1"></i><%= r.user %><% } %><% if (r.ip) { %> <span class="text-muted ltr d-inline-block"><%= r.ip %></span><% } %></td>
          <td><% if (hasDetail) { %><button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#st<%= i %>" title="جزئیات"><i class="bi bi-code-slash"></i></button><% } %></td>
        </tr>
        <% if (hasDetail) { %><tr class="collapse" id="st<%= i %>"><td colspan="5" class="bg-light"><pre class="ltr text-start mb-0" style="font-size:.7rem;white-space:pre-wrap"><%= r.error.stack %></pre></td></tr><% } %>
      <% }); %>
      </tbody></table></div>
      <div class="card-footer fs-7 text-muted">حداکثر ۳۰۰ رخداد آخر نمایش داده می‌شود. برای مشاهدهٔ کامل، فایل را دانلود کنید. خطاهای راه‌اندازی (قبل از اجرای برنامه) در لاگ Passenger/stderr هاست ثبت می‌شوند.</div>
    </div>
  </div>
</div>
