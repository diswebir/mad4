        <%- sel('birthday_notify_teacher', 'اعلان به معلم راهنما (روز تولد)', { '1': 'فعال', '0': 'غیرفعال' }, { col: 4 }) %>
        <%- sel('birthday_notify_student', 'اعلان به دانش‌آموز (روز تولد)', { '1': 'فعال', '0': 'غیرفعال' }, { col: 4 }) %>
