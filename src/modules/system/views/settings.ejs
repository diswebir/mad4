        <%- sel('payment_allow_partial', 'پرداخت بخشی از صورت‌حساب', { '1': 'مجاز (کاربر مبلغ را انتخاب می‌کند)', '0': 'فقط پرداخت کامل مانده' }, { col: 4 }) %>
        <%- inp('site_url', 'نشانی عمومی سامانه (برای بازگشت از درگاه)', { col: 8, ltr: true, placeholder: 'https://school.example.com' }) %>
        <%- inp('payment_description', 'شرح تراکنش', { col: 4, help: 'متغیرها: {title} {number} {name} {school}' }) %>
        <%- inp('zarinpal_base_url', 'نشانی پایهٔ درگاه (پیشرفته)', { col: 12, ltr: true, placeholder: 'خالی = خودکار (payment.zarinpal.com یا sandbox.zarinpal.com)', help: 'فقط برای آزمایش یا درگاه واسط تغییر دهید' }) %>
        <div class="col-12"><a class="btn btn-sm btn-outline-secondary" href="/finance/online"><i class="bi bi-list-check ms-1"></i>فهرست تراکنش‌های آنلاین</a></div>
      <% } else if (tab === 'birthdays') { %>
        <div class="col-12"><div class="alert alert-light border small mb-0"><i class="bi bi-info-circle ms-1"></i>تولدها بر اساس «تقویم شمسی» محاسبه می‌شوند و کار زمان‌بندی‌شدهٔ «اطلاع‌رسانی تولد» هر روز صبح اجرا می‌شود (ساعت آن در <a href="/system/jobs">کارهای زمان‌بندی‌شده</a> قابل تغییر است). متغیرهای قابل استفاده در الگوها: <code>{name}</code> <code>{first_name}</code> <code>{class}</code> <code>{age}</code> <code>{date}</code> <code>{when}</code> <code>{school}</code> و در یادآوری مدیر <code>{list}</code>.</div></div>
