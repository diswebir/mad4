        <div class="col-12"><div class="alert alert-light border fs-7 mb-0"><i class="bi bi-info-circle me-1"></i>با فعال‌شدن این حالت، همهٔ کاربران به‌جز <strong>مدیران</strong> و IPهای مجاز، صفحهٔ «در حال تعمیر» (کد ۵۰۳) می‌بینند؛ صفحهٔ ورود باز می‌ماند تا مدیر بتواند وارد شود. درخواست‌های API پاسخ JSON با کد ۵۰۳ می‌گیرند و بازگشت درگاه پرداخت و cron مسدود نمی‌شوند. هنگام به‌روزرسانی از پنل، این حالت به‌طور خودکار فعال و سپس خاموش می‌شود.</div></div>
        <%- sw('maintenance_mode', 'فعال‌سازی حالت تعمیر و نگهداری', 'فقط مدیران می‌توانند وارد شوند؛ نوار هشدار در بالای صفحه برای مدیر نمایش داده می‌شود') %>
        <%- inp('maintenance_until', 'زمان تقریبی بازگشت (متن آزاد)', { ph: 'مثلاً: امروز ساعت ۱۸', help: 'در صفحهٔ ۵۰۳ به کاربران نشان داده می‌شود' }) %>
        <%- inp('maintenance_message', 'پیام نمایش‌داده‌شده به کاربران', { col: 12, type: 'textarea', ph: 'سامانه به‌طور موقت برای به‌روزرسانی در دسترس نیست…' }) %>
        <%- inp('maintenance_allow_ips', 'IPهای مجاز (با کاما)', { col: 12, ltr: true, ph: '192.168.1.10, 85.9.*', help: 'این آدرس‌ها حتی بدون ورود مدیر هم به سامانه دسترسی دارند؛ ستاره در انتها به‌معنی پیشوند است' }) %>
        <% } %>
        <% if (enabled('system.disk_alert')) { %>
        <div class="col-12 mt-4"><h6 class="text-brand"><i class="bi bi-hdd-network me-1"></i>پایش فضای دیسک</h6></div>
        <div class="col-12"><div class="border rounded-3 p-3 bg-body-tertiary"><%- include('partials/disk-gauge', { h: healthInfo, compact: false }) %></div></div>
        <%- sw('disk_alert_enabled', 'هشدار پرشدن دیسک به مدیران', 'کار ساعتی «پایش فضای دیسک» در صورت عبور از آستانه، روزی یک بار اعلان می‌فرستد و نوار هشدار بالای صفحه نمایش داده می‌شود') %>
        <%- inp('disk_alert_min_mb', 'حداقل فضای آزاد (مگابایت)', { col: 3, ltr: true, help: 'کمتر از این مقدار = هشدار؛ نصف آن = بحرانی' }) %>
        <%- inp('disk_alert_percent', 'حداکثر درصد استفاده', { col: 3, ltr: true, help: 'بین ۵۰ تا ۹۹' }) %>
        <% } %>
        <div class="col-12 mt-4"><h6 class="text-brand"><i class="bi bi-folder2-open me-1"></i>فایل‌ها و نگه‌داری داده‌های موقت</h6></div>
        <%- inp('log_keep_days', 'نگه‌داری فایل‌های لاگ خطا (روز)', { col: 4, ltr: true }) %><%- inp('cleanup_notifications_days', 'حذف اعلان‌های خوانده‌شده پس از (روز)', { col: 4, ltr: true }) %>
        <%- inp('cleanup_login_logs_days', 'حذف لاگ ورود کاربران پس از (روز)', { col: 4, ltr: true }) %><%- inp('cleanup_job_runs_days', 'حذف سابقهٔ اجرای کارها پس از (روز)', { col: 4, ltr: true }) %>
        <div class="col-12"><div class="form-text">این مقادیر در کار زمان‌بندی‌شدهٔ «پاک‌سازی داده‌های موقت» اعمال می‌شوند.</div></div>
      <% } else if (tab === 'demo') { %>
        <div class="col-12">
          <p>دادهٔ نمونه شامل معلمان، کلاس‌ها، دانش‌آموزان، حضور و غیاب، نمرات، تیکت‌ها، اطلاعیه‌ها، تکالیف، رویدادها، شهریه‌ها، کتاب‌ها و… است و برای آشنایی با سامانه کاربرد دارد.</p>
          <div class="alert <%= s.demo_mode === '1' ? 'alert-warning' : 'alert-light border' %>">وضعیت فعلی: <strong><%= s.demo_mode === '1' ? 'دادهٔ نمونه بارگذاری شده است' : 'دادهٔ نمونه فعال نیست' %></strong></div>
          <div class="d-flex gap-2">
            <a href="#" data-post="/system/demo/load" data-confirm="دادهٔ نمونه به داده‌های فعلی اضافه می‌شود. ادامه می‌دهید؟" class="btn btn-outline-primary"><i class="bi bi-database-add me-1"></i>بارگذاری دادهٔ نمونه</a>
            <a href="#" data-post="/system/demo/clear" data-confirm="هشدار! همهٔ داده‌ها (دانش‌آموزان، معلمان، کلاس‌ها، نمرات و…) به‌جز حساب شما و تنظیمات حذف می‌شوند. این عمل برگشت‌ناپذیر است. ادامه می‌دهید؟" class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>پاک‌سازی کامل داده‌ها</a>
          </div>
        </div>
      <% } %>
      </div></div>
      <% if (tab !== 'demo' && tab !== 'advanced') { %>
      <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
        <% if (tab === 'sms' || tab === 'email') { %>
          <div class="input-group input-group-sm" style="max-width:360px"><input class="form-control ltr" placeholder="<%= tab === 'sms' ? '09123456789' : 'you@example.com' %>" form="testForm" name="to"><button class="btn btn-outline-secondary" form="testForm">ارسال آزمایشی</button></div>
        <% } else if (tab === 'offsite') { %>
          <button class="btn btn-outline-secondary btn-sm" form="testForm"><i class="bi bi-plug me-1"></i>آزمایش اتصال (با تنظیمات ذخیره‌شده)</button>
        <% } else if (tab === 'maintenance') { %>
          <div class="d-flex gap-2 flex-wrap">
            <% if (enabled('system.maintenance')) { %><button class="btn btn-sm <%= maintenanceActive ? 'btn-success' : 'btn-outline-warning' %>" form="quickMaintForm" name="enabled" value="<%= maintenanceActive ? '0' : '1' %>"><i class="bi <%= maintenanceActive ? 'bi-unlock' : 'bi-lock' %> me-1"></i><%= maintenanceActive ? 'خروج فوری از حالت نگهداری' : 'فعال‌سازی فوری (با پیام فعلی)' %></button><% } %>
            <% if (enabled('system.disk_alert')) { %><button class="btn btn-sm btn-outline-secondary" form="diskCheckForm"><i class="bi bi-arrow-clockwise me-1"></i>بررسی دوبارهٔ دیسک</button><% } %>
          </div>
        <% } else { %><span></span><% } %>
        <button class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i>ذخیره</button>
      </div>
      <% } %>
    </form>
    <% if (tab === 'sms' || tab === 'email' || tab === 'offsite') { %><form id="testForm" method="post" action="/system/settings/test/<%= tab %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><% } %>
    <% if (tab === 'advanced') { %>
    <div class="modal fade" id="importSettingsModal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/system/settings/import" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header"><h6 class="modal-title">ورودی تنظیمات از فایل JSON</h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button></div>
      <div class="modal-body"><p class="fs-7 text-secondary">فایل خروجی همین صفحه (از این مدرسه یا مدرسهٔ دیگر) را انتخاب کنید. کلیدهای محرمانه (رمزها، کلید API) و داخلی هرگز وارد نمی‌شوند؛ کلیدهای ناشناخته فقط با تیک زیر پذیرفته می‌شوند.</p>
        <input type="file" class="form-control" name="file" id="importSettingsFile" accept=".json,application/json" required aria-label="فایل JSON تنظیمات">
        <div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="allow_unknown" value="1" id="allowUnknown"><label class="form-check-label fs-7" for="allowUnknown">کلیدهای ناشناخته (مثلاً ماژول‌های سفارشی) هم وارد شوند</label></div></div>
      <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">انصراف</button><button class="btn btn-primary"><i class="bi bi-upload me-1"></i>اعمال</button></div></form></div></div>
    <% } %>
    <% if (tab === 'maintenance') { %><form id="quickMaintForm" method="post" action="/system/maintenance/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><form id="diskCheckForm" method="post" action="/system/update/disk-check"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form><% } %>
  </div>
</div>
