        <%- inp('backup_ftp_user', 'نام کاربری FTP', { col: 6, ltr: true }) %><%- inp('backup_ftp_pass', 'رمز عبور FTP', { col: 6, ltr: true, type: 'password' }) %>
        <div class="col-12 offsite-sec" data-mode="webdav"><h6 class="text-brand border-bottom pb-2 mb-0 mt-2"><i class="bi bi-cloud me-1"></i>WebDAV</h6></div>
        <%- inp('backup_webdav_url', 'نشانی پوشهٔ WebDAV', { col: 12, ltr: true, ph: 'https://cloud.example.com/remote.php/dav/files/USER/backups', help: 'پوشه باید از قبل وجود داشته باشد' }) %>
        <%- inp('backup_webdav_user', 'نام کاربری', { col: 6, ltr: true }) %><%- inp('backup_webdav_pass', 'رمز عبور / App password', { col: 6, ltr: true, type: 'password' }) %>
        <script>(function(){var sel=document.getElementById('st_backup_offsite_mode');if(!sel)return;function upd(){var m=sel.value;document.querySelectorAll('[name^="backup_ftp_"],[name^="backup_webdav_"],[name="backup_email_to"],.offsite-sec').forEach(function(el){var box=el.classList.contains('offsite-sec')?el:el.closest('.col-md-2,.col-md-3,.col-md-5,.col-md-6,.col-md-12,.col-12');if(!box)return;var mode=el.getAttribute('data-mode')||(el.name.indexOf('backup_ftp_')===0?'ftp':el.name.indexOf('backup_webdav_')===0?'webdav':'email');box.style.display=(m===mode)?'':'none';});}sel.addEventListener('change',upd);upd();})()</script>
      <% } else if (tab === 'maintenance') { %>
        <% if (enabled('system.maintenance')) { %>
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2"><h6 class="text-brand mb-0"><i class="bi bi-tools me-1"></i>حالت تعمیر و نگهداری</h6>
