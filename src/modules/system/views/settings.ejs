        <div class="col-md-4"></div>
        <%- sel('birthday_sms_student', 'پیامک تبریک به دانش‌آموز', { '0': 'خیر', '1': 'بله (در صورت فعال بودن پیامک و داشتن شمارهٔ همراه)' }, { col: 6 }) %>
        <%- sel('birthday_sms_parents', 'پیامک تبریک به اولیا', { '0': 'خیر', '1': 'بله (در صورت فعال بودن پیامک)' }, { col: 6 }) %>
        <div class="col-12"><h6 class="mt-2 mb-0"><i class="bi bi-chat-square-quote ms-1"></i>الگوی پیام هر گیرنده</h6><div class="text-muted fs-7">خالی بگذارید تا متن پیش‌فرض استفاده شود. پیش‌نمایش با دادهٔ نمونه زیر هر الگو نمایش داده می‌شود.</div></div>
        <% var bp = (typeof birthdayPreview !== 'undefined' && birthdayPreview) || {}; var bd = (typeof birthdayDefaults !== 'undefined' && birthdayDefaults) || {};
           [['birthday_tpl_admin_upcoming', 'یادآوری به مدیر (چند روز قبل)'], ['birthday_tpl_admin_today', 'اطلاع به مدیر (روز تولد)'], ['birthday_tpl_teacher', 'اطلاع به معلم راهنما'], ['birthday_tpl_student', 'تبریک به دانش‌آموز'], ['birthday_tpl_parent', 'تبریک به اولیا']].forEach(function (t) { %>
          <%- inp(t[0], t[1], { col: 12, type: 'textarea', placeholder: bd[t[0]] }) %>
          <div class="col-12 mt-0"><div class="fs-7 text-muted bg-light rounded p-2 mb-1"><i class="bi bi-eye ms-1"></i><span class="text-dark"><%= bp[t[0]] %></span></div></div>
        <% }); %>
      <% } else if (tab === 'sms') { %>
        <%- sw('sms_enabled', 'فعال‌سازی ارسال پیامک') %>
        <%- sel('sms_provider', 'درگاه', { log: 'فقط ثبت در لاگ (آزمایشی، بدون هزینه)', kavenegar: 'کاوه‌نگار', webhook: 'وب‌هوک سفارشی (POST JSON)' }) %>
        <%- inp('sms_api_key', 'کلید API', { ltr: true }) %><%- inp('sms_sender', 'شمارهٔ فرستنده', { ltr: true }) %>
        <%- inp('sms_webhook_url', 'آدرس وب‌هوک (در صورت انتخاب وب‌هوک)', { col: 12, ltr: true }) %>
        <%- inp('site_url', 'نشانی عمومی سامانه (برای لینک داخل پیامک‌ها)', { col: 12, ltr: true, placeholder: 'https://school.example.com' }) %>
        <%- inp('sms_price', 'هزینهٔ هر بخش پیامک (ریال/تومان — برای برآورد هزینه در گزارش مصرف)', { col: 6, ltr: true, help: 'صفر = برآورد هزینه نمایش داده نمی‌شود' }) %>
        <% if (enabled('notifications.retry_queue')) { %><%- inp('notify_retry_max', 'سقف تلاش مجدد برای ارسال ناموفق', { type: 'number', col: 4, help: 'پیامک/ایمیل‌هایی که به خاطر خطای شبکه یا درگاه ارسال نشده‌اند، تا این تعداد بار با فاصلهٔ افزایشی دوباره ارسال می‌شوند (صف ارسال)' }) %><% } %>
      <% } else if (tab === 'email') { %>
        <%- sw('email_enabled', 'فعال‌سازی ارسال ایمیل') %>
