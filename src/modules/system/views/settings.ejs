        <%- sel('smtp_secure', 'SSL/TLS', { '0': 'خیر (STARTTLS)', '1': 'بله (SSL)' }, { col: 3 }) %>
        <%- inp('smtp_user', 'نام کاربری', { ltr: true }) %><%- inp('smtp_pass', 'رمز عبور', { ltr: true, type: 'password' }) %><%- inp('smtp_from', 'آدرس فرستنده', { ltr: true }) %>
      <% } else if (tab === 'offsite') { %>
        <div class="col-12"><div class="alert alert-light border fs-7 mb-0"><i class="bi bi-info-circle me-1"></i>پس از هر پشتیبان‌گیری شبانه (کار «پشتیبان‌گیری خودکار»)، فایل به‌صورت فشرده (gzip) به مقصد انتخابی ارسال می‌شود. از صفحهٔ <a href="/system/backup">پشتیبان‌گیری</a> هم می‌توانید هر فایل را دستی ارسال کنید.</div></div>
        <%- sel('backup_offsite_mode', 'مقصد', { none: 'غیرفعال', email: 'ایمیل (پیوست)', ftp: 'FTP / FTPS', webdav: 'WebDAV (Nextcloud، ownCloud، …)' }, { col: 6 }) %>
        <%- inp('backup_offsite_max_mb', 'سقف حجم فایل فشرده (مگابایت)', { col: 6, ltr: true, help: 'برای ایمیل معمولاً ۲۰–۲۵ مگابایت؛ فایل‌های بزرگ‌تر ارسال نمی‌شوند' }) %>
        <div class="col-12 offsite-sec" data-mode="email"><h6 class="text-brand border-bottom pb-2 mb-0 mt-2"><i class="bi bi-envelope me-1"></i>ایمیل</h6></div>
