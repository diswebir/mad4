<%- include('partials/page-header', {
  title: 'پیام‌ها',
  subtitle: unread ? (J.toPersianDigits(unread) + ' پیام جدید و خوانده‌نشده دارید که نیازمند توجه شماست.') : 'سامانهٔ مکاتبات و پیام‌های داخلی مدرسه',
  icon: 'bi-chat-dots-fill',
  actions: [
    ...(canSend ? [{ href: '/messages/compose', label: 'ارسال پیام جدید', icon: 'bi-pencil-square', class: 'btn-primary' }] : []),
    ...(unread ? [{ post: '/messages/read-all', label: 'خواندن همهٔ پیام‌ها', icon: 'bi-check2-all', class: 'btn-light' }] : [])
  ]
}) %>

<!-- نوار تب‌ها و فیلترهای پیام‌ها -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
  <ul class="nav notif-nav-pills gap-1">
    <li class="nav-item">
      <a class="nav-link notif-pill <%= box === 'inbox' ? 'active' : '' %>" href="/messages">
        <i class="bi bi-inbox-fill me-1"></i>
        <span>صندوق ورودی</span>
        <% if (unread) { %>
          <span class="badge notif-count-badge bg-danger text-white"><%= J.toPersianDigits(unread) %></span>
        <% } else if (typeof counts !== 'undefined' && counts.inbox) { %>
          <span class="badge notif-count-badge <%= box === 'inbox' ? 'bg-white text-primary' : 'bg-secondary-subtle text-secondary' %>"><%= J.toPersianDigits(counts.inbox) %></span>
        <% } %>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link notif-pill <%= box === 'sent' ? 'active' : '' %>" href="/messages?box=sent">
        <i class="bi bi-send-fill me-1"></i>
        <span>ارسال‌شده‌ها</span>
        <% if (typeof counts !== 'undefined' && counts.sent) { %>
          <span class="badge notif-count-badge <%= box === 'sent' ? 'bg-white text-primary' : 'bg-secondary-subtle text-secondary' %>"><%= J.toPersianDigits(counts.sent) %></span>
        <% } %>
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link notif-pill <%= box === 'all' ? 'active' : '' %>" href="/messages?box=all">
        <i class="bi bi-collection-fill me-1"></i>
        <span>همهٔ پیام‌ها</span>
        <% if (typeof counts !== 'undefined' && counts.all) { %>
          <span class="badge notif-count-badge <%= box === 'all' ? 'bg-white text-primary' : 'bg-secondary-subtle text-secondary' %>"><%= J.toPersianDigits(counts.all) %></span>
        <% } %>
      </a>
    </li>
  </ul>

  <!-- فرم جستجو و فیلتر خوانده نشده -->
  <form method="get" class="d-flex align-items-center flex-wrap gap-2">
    <input type="hidden" name="box" value="<%= box %>">
    <% if (box !== 'sent') { %>
      <label class="form-check fs-8 align-self-center mb-0 cursor-pointer user-select-none bg-surface px-3 py-2 rounded-3 border">
        <input type="checkbox" class="form-check-input" name="unread" value="1" <%= f.unread === '1' ? 'checked' : '' %> data-auto-submit>
        <span>فقط خوانده‌نشده</span>
      </label>
    <% } %>
    <div class="input-group input-group-sm" style="max-width: 260px;">
      <input class="form-control" name="q" value="<%= f.q %>" placeholder="جستجو در پیام‌ها…">
      <button class="btn btn-primary" aria-label="جستجو" title="جستجو"><i class="bi bi-search"></i></button>
      <% if (f.q || f.unread) { %>
        <a href="/messages?box=<%= box %>" class="btn btn-outline-secondary" title="حذف فیلترها"><i class="bi bi-x"></i></a>
      <% } %>
    </div>
  </form>
</div>

<!-- فهرست کارت‌های مستقل پیام‌ها (فاصله‌دار، بدون چسبیدگی) -->
<div class="msg-feed mb-4">
  <% result.data.forEach(function (m) {
    var isMine = (m.sender_id === currentUser.id);
    var contactName = isMine ? m.receiver_name : m.sender_name;
    var contactRole = isMine ? m.receiver_role : m.sender_role;
    var contactAvatar = isMine ? m.receiver_avatar : m.sender_avatar;
    var isUnread = (!isMine && !m.is_read);
  %>
    <div class="msg-card <%= isUnread ? 'is-unread' : 'is-read' %>">
      <div class="p-3 p-md-4">
        <div class="d-flex align-items-start gap-3">
          
          <!-- آواتار فرستنده یا گیرنده -->
          <div class="flex-shrink-0">
            <%- include('partials/avatar', { user: { name: contactName, avatar: contactAvatar }, size: 48 }) %>
          </div>

          <!-- بدنه اصلی اطلاعات پیام -->
          <div class="flex-grow-1 min-w-0">
            <!-- ردیف بالا: نام مخاطب، نشانگرها، زمان -->
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
              <div class="d-flex align-items-center gap-2 flex-wrap min-w-0">
                <% if (isUnread) { %>
                  <span class="notif-unread-dot" title="خوانده نشده"></span>
                  <span class="badge notif-badge-new">جدید</span>
                <% } %>

                <!-- نشانگر جهت پیام -->
                <% if (isMine) { %>
                  <span class="badge bg-light-subtle text-secondary border fs-8 d-inline-flex align-items-center gap-1">
                    <i class="bi bi-arrow-up-right text-primary"></i>
                    <span>ارسال‌شده به: <strong><%= contactName %></strong></span>
                  </span>
                <% } else { %>
                  <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-8 d-inline-flex align-items-center gap-1">
                    <i class="bi bi-arrow-down-left"></i>
                    <span>از: <strong><%= contactName %></strong></span>
                  </span>
                <% } %>

                <span class="badge badge-soft-secondary fw-normal fs-8">
                  <%= utils.ROLES[contactRole] || contactRole %>
                </span>
              </div>

              <!-- زمان نسبی پیام -->
              <span class="text-secondary fs-8 d-inline-flex align-items-center gap-1">
                <i class="bi bi-clock"></i>
                <span class="num"><%= J.timeAgo(m.created_at) %></span>
              </span>
            </div>

            <!-- موضوع پیام -->
            <div class="mb-2">
              <a href="/messages/<%= m.id %>" class="msg-title text-decoration-none">
                <%= m.subject %>
              </a>
            </div>

            <!-- پیش‌نمایش متن پیام -->
            <% if (m.body) { %>
              <p class="msg-preview mb-3">
                <%= utils.truncate(m.body, 140) %>
              </p>
            <% } %>

            <!-- فوتر کارت: تاریخ دقیق + وضعیت رسید + دکمه‌ها -->
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2 border-top border-light-subtle">
              <div class="d-flex align-items-center gap-3 text-secondary fs-8 flex-wrap">
                <span class="d-inline-flex align-items-center gap-1">
                  <i class="bi bi-calendar3"></i>
                  <span class="num"><%= J.formatDateTime(m.created_at) %></span>
                </span>

                <!-- وضعیت ارسال و رسید خوانده شدن بدون نشت کد HTML -->
                <% if (isMine && enabled('messages.read_receipt')) { %>
                  <span class="d-inline-flex align-items-center gap-1">
                    <% if (m.is_read) { %>
                      <span class="text-primary fw-medium d-inline-flex align-items-center gap-1" title="توسط گیرنده خوانده شد">
                        <i class="bi bi-check2-all fs-6"></i>
                        <span>خوانده شده <%= m.read_at ? J.timeAgo(m.read_at) : '' %></span>
                      </span>
                    <% } else { %>
                      <span class="text-secondary d-inline-flex align-items-center gap-1" title="ارسال شد (هنوز خوانده نشده)">
                        <i class="bi bi-check2 fs-6"></i>
                        <span>ارسال شده</span>
                      </span>
                    <% } %>
                  </span>
                <% } %>
              </div>

              <!-- دکمه‌های اقدام سریع -->
              <div class="d-flex align-items-center gap-2">
                <a href="/messages/<%= m.id %>" class="btn btn-sm btn-outline-primary notif-action-btn">
                  <span>مشاهده گفتگو</span>
                  <i class="bi bi-arrow-left"></i>
                </a>
                <a href="#" data-post="/messages/<%= m.id %>/delete" data-confirm="آیا این پیام حذف شود؟" class="btn btn-sm btn-light text-danger notif-icon-btn" title="حذف پیام">
                  <i class="bi bi-trash3"></i>
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  <% }); %>

  <!-- حالت خالی (Empty State) -->
  <% if (!result.data.length) { %>
    <div class="card border-0 shadow-sm py-5 text-center my-3">
      <div class="card-body">
        <div class="mb-3">
          <i class="bi <%= f.unread === '1' ? 'bi-check-circle-fill text-success' : 'bi-chat-square-dots text-secondary' %> fs-1 opacity-75"></i>
        </div>
        <h5 class="fw-bold mb-2">
          <% if (f.unread === '1') { %>
            تمام پیام‌های شما خوانده شده‌اند
          <% } else if (f.q) { %>
            پیامی مطابق با «<%= f.q %>» پیدا نشد
          <% } else if (box === 'sent') { %>
            هیچ پیام ارسالی توسط شما ثبت نشده است
          <% } else if (box === 'all') { %>
            هیچ پیامی در صندوق شما وجود ندارد
          <% } else { %>
            صندوق ورودی شما خالی است
          <% } %>
        </h5>
        <p class="text-secondary fs-7 mb-4">
          <% if (f.unread === '1') { %>
            هیچ پیامی نیازمند پاسخ یا بررسی فوری نیست.
          <% } else if (f.q) { %>
            می‌توانید کلمه جستجو را تغییر دهید یا فیلترها را حذف کنید.
          <% } else { %>
            می‌توانید با معلمان، کادر مدرسه، اولیا یا دانش‌آموزان گفتگو را آغاز کنید.
          <% } %>
        </p>
        <div class="d-flex justify-content-center gap-2">
          <% if (f.q || f.unread) { %>
            <a href="/messages?box=<%= box %>" class="btn btn-sm btn-outline-secondary">
              <i class="bi bi-arrow-repeat me-1"></i>حذف فیلترها
            </a>
          <% } %>
          <% if (canSend) { %>
            <a href="/messages/compose" class="btn btn-sm btn-primary">
              <i class="bi bi-pencil-square me-1"></i>ارسال پیام جدید
            </a>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<!-- صفحه‌بندی -->
<% if (result && result.pages > 1) { %>
  <div class="card border-0 shadow-sm mt-3">
    <%- include('partials/pagination', { result: result, query: query }) %>
  </div>
<% } else if (result && result.total) { %>
  <div class="text-secondary fs-8 text-center mt-3">
    مجموع <%= J.toPersianDigits(result.total) %> پیام در این بخش
  </div>
<% } %>
