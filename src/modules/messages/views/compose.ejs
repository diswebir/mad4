<%- include('partials/page-header', { title: reply ? 'پاسخ به پیام' : 'پیام جدید', icon: 'bi-pencil-square', breadcrumbs: [{ title: 'پیام‌ها', href: '/messages' }, { title: reply ? 'پاسخ' : 'جدید' }] }) %>
<div class="row justify-content-center"><div class="col-lg-8"><form method="post" action="/messages/compose" class="card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (reply) { %><input type="hidden" name="parent_id" value="<%= reply.parent_id || reply.id %>"><% } %>
  <div class="card-body"><div class="row g-3">
    <% if (canBroadcast && !reply) { %><div class="col-md-4"><label class="form-label">نوع ارسال</label><select class="form-select" name="mode" id="mode"><option value="user">به یک کاربر</option><option value="class">به دانش‌آموزان یک کلاس</option><% if (isStaff) { %><option value="role">به همهٔ یک نقش</option><% } %></select></div><% } else { %><input type="hidden" name="mode" value="user"><% } %>
    <div class="col-md-8 mode mode-user"><label class="form-label required">گیرنده</label><select class="form-select" name="receiver_id"><option value="">انتخاب کنید…</option><% groups.forEach(function (g) { %><optgroup label="<%= g.group %>"><% g.users.forEach(function (u) { %><option value="<%= u.id %>" <%= Number(to) === Number(u.id) ? 'selected' : '' %>><%= u.name %></option><% }); %></optgroup><% }); %></select><% if (!groups.length) { %><div class="form-text text-danger">گیرندهٔ مجازی برای شما تعریف نشده است.</div><% } %></div>
    <div class="col-md-8 mode mode-class d-none"><label class="form-label">کلاس</label><select class="form-select" name="class_id"><% classes.forEach(function (c) { %><option value="<%= c.id %>"><%= c.title %></option><% }); %></select></div>
    <div class="col-md-8 mode mode-role d-none"><label class="form-label">نقش</label><select class="form-select" name="role"><% Object.entries(ROLES).forEach(function (r) { %><option value="<%= r[0] %>"><%= r[1] %></option><% }); %></select></div>
    <div class="col-12"><label class="form-label">موضوع</label><input class="form-control" name="subject" maxlength="200" value="<%= reply ? (reply.subject.startsWith('پاسخ:') ? reply.subject : 'پاسخ: ' + reply.subject) : '' %>"></div>
    <div class="col-12"><label class="form-label required">متن پیام</label><textarea class="form-control" name="body" rows="8" required autofocus></textarea></div>
    <% if (reply) { %><div class="col-12"><div class="border rounded p-2 bg-light-subtle fs-7"><div class="text-secondary mb-1"><%= reply.sender_name %> نوشت:</div><%- utils.nl2br(utils.escapeHtml(utils.truncate(reply.body, 400))) %></div></div><% } %>
  </div></div>
  <div class="card-footer bg-transparent d-flex justify-content-between"><a href="/messages" class="btn btn-light">انصراف</a><button class="btn btn-primary px-4"><i class="bi bi-send me-1"></i>ارسال</button></div>
</form></div></div>
<script>(function(){var m=document.getElementById('mode');if(!m)return;function u(){document.querySelectorAll('.mode').forEach(function(e){e.classList.add('d-none')});var e=document.querySelector('.mode-'+m.value);if(e)e.classList.remove('d-none');}m.addEventListener('change',u);u();})();</script>
