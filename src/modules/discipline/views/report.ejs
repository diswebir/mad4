<%- include('partials/page-header', { title: 'گزارش انضباطی کلاس', icon: 'bi-bar-chart', breadcrumbs: [{ title: 'انضباط و تشویق', href: '/discipline' }, { title: 'گزارش' }], actions: [{ print: true, label: 'چاپ', icon: 'bi-printer', class: 'btn-light' }] }) %>
<form method="get" class="card mb-3 no-print"><div class="card-body py-2 d-flex flex-wrap gap-2 align-items-end">
  <div><label class="form-label fs-7 mb-0">کلاس</label><select class="form-select form-select-sm" name="class_id"><% classes.forEach(function (c) { %><option value="<%= c.value %>" <%= String(classId) === String(c.value) ? 'selected' : '' %>><%= c.label %></option><% }); %></select></div>
  <div><label class="form-label fs-7 mb-0">از</label><input class="form-control form-control-sm jdate" name="from" value="<%= J.formatDate(from) %>"></div><div><label class="form-label fs-7 mb-0">تا</label><input class="form-control form-control-sm jdate" name="to" value="<%= J.formatDate(to) %>"></div>
  <button class="btn btn-sm btn-primary">نمایش</button></div></form>
<div class="row g-3"><div class="col-lg-8"><div class="card table-card"><div class="card-header"><h6>رتبه‌بندی دانش‌آموزان (<%= J.formatDate(from) %> تا <%= J.formatDate(to) %>)</h6></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>#</th><th>دانش‌آموز</th><th>تعداد موارد</th><th>امتیاز مثبت</th><th>امتیاز منفی</th><th>جمع</th></tr></thead><tbody>
<% rows.forEach(function (r, i) { %><tr><td><%= J.toPersianDigits(i + 1) %></td><td><a href="/discipline?student_id=<%= r.id %>" class="text-body"><%= r.first_name %> <%= r.last_name %></a> <span class="fs-7 text-secondary"><%= J.toPersianDigits(r.student_number) %></span></td><td><%= J.toPersianDigits(r.cnt) %></td><td class="text-success"><%= J.toPersianDigits(r.pos) %></td><td class="text-danger"><%= J.toPersianDigits(r.neg) %></td><td class="fw-bold <%= r.total < 0 ? 'text-danger' : 'text-success' %>"><%= J.toPersianDigits(r.total) %></td></tr><% }); if (!rows.length) { %><tr><td colspan="6" class="text-center text-secondary py-4">کلاسی انتخاب نشده یا دانش‌آموزی ندارد</td></tr><% } %>
</tbody></table></div></div></div>
<div class="col-lg-4"><div class="card"><div class="card-header"><h6>به تفکیک دسته</h6></div><ul class="list-group list-group-flush"><% byCat.forEach(function (c) { %><li class="list-group-item d-flex justify-content-between"><span><i class="bi <%= c.type === 'positive' ? 'bi-plus-circle text-success' : 'bi-dash-circle text-danger' %> me-1"></i><%= CATEGORIES[c.category] || c.category %></span><strong><%= J.toPersianDigits(c.c) %></strong></li><% }); if (!byCat.length) { %><li class="list-group-item text-secondary fs-7">موردی در این بازه ثبت نشده</li><% } %></ul></div></div></div>
