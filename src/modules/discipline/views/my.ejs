<%- include('partials/page-header', { title: 'سوابق انضباطی و تشویقی من', subtitle: 'جمع امتیاز: ' + J.toPersianDigits(sum), icon: 'bi-shield-check' }) %>
<div class="card table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>تاریخ</th><th>نوع</th><th>دسته</th><th>شرح</th><th>اقدام</th><th>امتیاز</th><th>ثبت‌کننده</th></tr></thead><tbody>
<% rows.forEach(function (r) { %><tr><td class="text-nowrap"><%= J.formatDate(r.date) %></td><td><%- r.type === 'positive' ? '<span class="badge badge-soft-success">تشویقی</span>' : '<span class="badge badge-soft-danger">انضباطی</span>' %></td><td><%= CATEGORIES[r.category] || r.category %></td><td><%= r.description %></td><td class="fs-7"><%= r.action_taken || '—' %></td><td class="fw-bold <%= Number(r.points) < 0 ? 'text-danger' : 'text-success' %>"><%= J.toPersianDigits(r.points || 0) %></td><td class="fs-7"><%= r.recorder || '' %></td></tr><% }); if (!rows.length) { %><tr><td colspan="7"><%- include('partials/empty', { message: 'سابقه‌ای ثبت نشده است — آفرین!', icon: 'bi-emoji-smile' }) %></td></tr><% } %>
</tbody></table></div></div>
