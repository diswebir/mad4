<%- include('partials/page-header', { title: 'سوابق سلامت من', icon: 'bi-heart-pulse' }) %>
<div class="row g-3"><div class="col-lg-4"><div class="card"><div class="card-header"><h6>اطلاعات پزشکی پرونده</h6></div><ul class="list-group list-group-flush fs-7">
  <li class="list-group-item d-flex justify-content-between"><span>گروه خونی</span><strong><%= s.blood_type || '—' %></strong></li><li class="list-group-item d-flex justify-content-between"><span>قد / وزن</span><strong><%= s.height ? J.toPersianDigits(s.height) + ' cm' : '—' %> / <%= s.weight ? J.toPersianDigits(s.weight) + ' kg' : '—' %></strong></li>
  <li class="list-group-item"><div class="text-secondary">حساسیت‌ها</div><%= s.allergies || '—' %></li><li class="list-group-item"><div class="text-secondary">بیماری‌های خاص</div><%= s.medical_conditions || '—' %></li><li class="list-group-item"><div class="text-secondary">داروهای مصرفی</div><%= s.medications || '—' %></li><li class="list-group-item d-flex justify-content-between"><span>شمارهٔ بیمه</span><strong><%= s.insurance_number ? J.toPersianDigits(s.insurance_number) : '—' %></strong></li></ul></div></div>
<div class="col-lg-8"><div class="card table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>تاریخ</th><th>نوع</th><th>عنوان</th><th>شرح</th><th>اقدام</th><th>ارجاع</th></tr></thead><tbody>
<% rows.forEach(function (r) { %><tr><td class="text-nowrap"><%= J.formatDate(r.date) %></td><td><span class="badge badge-soft-info"><%= TYPES[r.type] || r.type %></span></td><td class="fw-semibold"><%= r.title %></td><td class="fs-7"><%= r.description || '' %></td><td class="fs-7"><%= r.action || '' %></td><td><%- r.referred ? '<i class="bi bi-check-circle text-warning"></i>' : '' %></td></tr><% }); if (!rows.length) { %><tr><td colspan="6"><%- include('partials/empty', { message: 'سابقه‌ای ثبت نشده است', icon: 'bi-heart-pulse' }) %></td></tr><% } %>
</tbody></table></div></div></div></div>
