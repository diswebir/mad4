<%- include('partials/page-header', { title: 'هشدارهای سلامت', subtitle: 'دانش‌آموزان دارای حساسیت، بیماری خاص، داروی مصرفی یا نیاز ویژه', icon: 'bi-exclamation-triangle', breadcrumbs: [{ title: 'سلامت', href: currentUser.role === 'teacher' ? '/health/alerts' : '/health' }, { title: 'هشدارها' }], actions: [{ print: true, label: 'چاپ', icon: 'bi-printer', class: 'btn-light' }] }) %>
<form method="get" class="mb-3 no-print d-flex gap-2"><select class="form-select form-select-sm w-auto" name="class_id" data-auto-submit aria-label="کلاس"><option value="">همهٔ کلاس‌ها</option><% classes.forEach(function (c) { %><option value="<%= c.value %>" <%= String(classId) === String(c.value) ? 'selected' : '' %>><%= c.label %></option><% }); %></select></form>
<div class="card table-card"><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>دانش‌آموز</th><th>کلاس</th><th>گروه خونی</th><th>حساسیت</th><th>بیماری خاص</th><th>دارو</th><th>نیاز ویژه</th><th>تماس اضطراری</th></tr></thead><tbody>
<% rows.forEach(function (r) { %><tr><td><a href="/students/<%= r.id %>" class="text-body fw-semibold"><%= r.first_name %> <%= r.last_name %></a></td><td><%= r.class_title || '' %></td><td><%= r.blood_type || '—' %></td><td class="text-danger"><%= r.allergies || '' %></td><td><%= r.medical_conditions || '' %></td><td><%= r.medications || '' %></td><td><%= r.special_needs || '' %></td><td class="fs-7 ltr text-end"><%= J.toPersianDigits(r.emergency_phone || r.father_phone || r.mother_phone || '') %> <span class="fs-7 text-secondary"><%= r.emergency_name || '' %></span></td></tr><% }); if (!rows.length) { %><tr><td colspan="8"><%- include('partials/empty', { message: 'موردی یافت نشد', icon: 'bi-heart' }) %></td></tr><% } %>
</tbody></table></div></div>
