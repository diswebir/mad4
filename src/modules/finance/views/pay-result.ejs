<% var isPublic = !currentUser; %>
<div class="<%= isPublic ? '' : 'col-lg-7 mx-auto' %>">
  <div class="card text-center">
    <div class="card-body py-5">
      <% if (ok) { %>
        <div class="display-4 text-success mb-2"><i class="bi bi-check-circle-fill"></i></div>
        <h4 class="mb-1"><%= already ? 'این پرداخت قبلاً تأیید شده است' : 'پرداخت با موفقیت انجام شد' %></h4>
        <% if (payment) { %><div class="text-secondary">مبلغ <strong class="text-dark"><%= utils.money(payment.amount, unit) %></strong><% if (invoice) { %> بابت «<%= invoice.title %>» (صورت‌حساب <span class="ltr d-inline-block"><%= J.toPersianDigits(invoice.number) %></span>)<% } %></div><% } %>
        <% if (refId) { %><div class="mt-3"><span class="badge badge-soft-success fs-6 px-3 py-2">کد پیگیری: <span class="ltr d-inline-block"><%= J.toPersianDigits(refId) %></span></span></div><% } %>
        <div class="fs-7 text-secondary mt-3">رسید این پرداخت در بخش «شهریه و پرداخت‌ها» قابل مشاهده و چاپ است.</div>
      <% } else { %>
        <div class="display-4 text-danger mb-2"><i class="bi bi-x-circle-fill"></i></div>
        <h4 class="mb-1">پرداخت انجام نشد</h4>
        <div class="text-secondary"><%= error || 'تراکنش ناموفق بود' %></div>
        <% if (payment && payment.amount) { %><div class="fs-7 text-secondary mt-2">مبلغ: <%= utils.money(payment.amount, unit) %><% if (invoice) { %> — بابت «<%= invoice.title %>»<% } %></div><% } %>
        <div class="fs-7 text-secondary mt-3">اگر مبلغی از حساب شما کسر شده باشد، تا ۷۲ ساعت آینده به‌طور خودکار برگشت داده می‌شود.</div>
      <% } %>
      <div class="d-flex gap-2 justify-content-center mt-4">
        <% if (isPublic) { %><a href="/auth/login" class="btn btn-primary"><i class="bi bi-box-arrow-in-right ms-1"></i>ورود به سامانه</a>
        <% } else if (currentUser.role === 'student' || currentUser.role === 'parent') { %><a href="/finance/my" class="btn btn-primary"><i class="bi bi-cash-stack ms-1"></i>شهریه و پرداخت‌ها</a><% if (invoice && ok) { %><a href="/finance/my/<%= invoice.id %>?print=1" class="btn btn-outline-secondary" target="_blank"><i class="bi bi-printer ms-1"></i>چاپ رسید</a><% } %>
        <% } else { %><a href="/finance/online" class="btn btn-primary">تراکنش‌های آنلاین</a><% } %>
      </div>
    </div>
  </div>
</div>
