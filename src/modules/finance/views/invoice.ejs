<% var isStudent = currentUser.role === 'student'; var base = isStudent ? '/finance/my/' + inv.id : '/finance/invoices/' + inv.id; var receiptId = Number(query.receipt) || null; %>
<% if (!print) { %><%- include('partials/page-header', { title: 'صورت‌حساب ' + J.toPersianDigits(inv.number), subtitle: inv.title, icon: 'bi-receipt', breadcrumbs: [{ title: 'امور مالی', href: isStudent ? '/finance/my' : '/finance' }, ...(isStudent ? [] : [{ title: 'صورت‌حساب‌ها', href: '/finance/invoices' }]), { title: J.toPersianDigits(inv.number) }], actions: [...(enabled('finance.receipt') ? [{ href: base + '?print=1', label: 'چاپ', icon: 'bi-printer', class: 'btn-light' }] : []), ...(!isStudent ? [{ href: '/finance/invoices/' + inv.id + '/edit', label: 'ویرایش', icon: 'bi-pencil', class: 'btn-light' }, ...(enabled('finance.overdue_notify') && remaining > 0 ? [{ post: '/finance/invoices/' + inv.id + '/remind', label: 'یادآوری', icon: 'bi-bell', class: 'btn-outline-warning' }] : [])] : [])] }) %><% } else { %><div class="text-center mb-3"><h4 class="mb-0"><%= schoolInfo.name %></h4><div class="fs-7 text-secondary"><%= schoolInfo.address || '' %> <%= schoolInfo.phone ? '· ' + J.toPersianDigits(schoolInfo.phone) : '' %></div><h5 class="mt-3"><%= receiptId ? 'رسید پرداخت' : 'صورت‌حساب' %></h5></div><% } %>
<div class="row g-3 justify-content-center"><div class="col-lg-<%= print ? 10 : 8 %>">
  <div class="card"><div class="card-body">
    <div class="row g-3">
      <div class="col-md-6"><div class="fs-7 text-secondary">دانش‌آموز</div><div class="fw-semibold"><%= inv.first_name %> <%= inv.last_name %> <span class="fs-7 text-secondary">(<%= J.toPersianDigits(inv.student_number) %>)</span></div><div class="fs-7"><%= inv.class_title || '' %><%= inv.father_name ? ' · ولی: ' + inv.father_name : '' %></div></div>
      <div class="col-md-6 text-md-end"><div class="fs-7 text-secondary">شمارهٔ صورت‌حساب</div><div class="fw-semibold ltr d-inline-block"><%= J.toPersianDigits(inv.number) %></div><div class="fs-7">صدور: <%= J.formatDate(inv.created_at) %> · سررسید: <span class="<%= inv.due_date < J.todayISO() && remaining > 0 ? 'text-danger' : '' %>"><%= J.formatDate(inv.due_date) %></span></div></div>
    </div>
    <table class="table mt-3 mb-0"><tbody>
      <tr><td><%= inv.title %><% if (inv.fee_type) { %> <span class="badge badge-soft-secondary"><%= FEE_TYPES[inv.fee_type] || '' %></span><% } %></td><td class="text-end"><%= utils.money(inv.amount, unit) %></td></tr>
      <% if (Number(inv.discount)) { %><tr><td>تخفیف</td><td class="text-end text-success">− <%= utils.money(inv.discount, unit) %></td></tr><% } %>
      <tr class="fw-semibold"><td>قابل پرداخت</td><td class="text-end"><%= utils.money(Number(inv.amount) - Number(inv.discount || 0), unit) %></td></tr>
      <tr><td>پرداخت‌شده</td><td class="text-end text-success"><%= utils.money(inv.paid_amount, unit) %></td></tr>
      <tr class="table-light fw-bold"><td>مانده</td><td class="text-end <%= remaining > 0 ? 'text-danger' : 'text-success' %>"><%= utils.money(remaining, unit) %> <%- utils.statusBadge(inv.status) %></td></tr>
    </tbody></table>
    <% if (inv.notes) { %><div class="fs-7 text-secondary mt-2"><i class="bi bi-sticky me-1"></i><%= inv.notes %></div><% } %>
  </div></div>
  <div class="card mt-3 table-card"><div class="card-header"><h6><i class="bi bi-cash me-1"></i>پرداخت‌ها</h6></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>تاریخ</th><th>مبلغ</th><th>روش</th><th>پیگیری</th><th>یادداشت</th><% if (!isStudent && !print) { %><th></th><% } %></tr></thead><tbody>
    <% payments.forEach(function (p) { %><tr class="<%= receiptId === p.id ? 'table-success' : '' %>"><td><%= J.formatDateTime(p.paid_at) %></td><td class="fw-semibold"><%= utils.money(p.amount, unit) %></td><td><%= METHODS[p.method] || p.method %></td><td class="ltr text-end"><%= p.reference ? J.toPersianDigits(p.reference) : '—' %></td><td class="fs-7"><%= p.note || '' %><%= p.recorder ? ' · ' + p.recorder : '' %></td><% if (!isStudent && !print) { %><td class="text-end"><a href="/finance/payments/<%= p.id %>/edit" class="btn btn-sm btn-light" aria-label="ویرایش" title="ویرایش"><i class="bi bi-pencil"></i></a></td><% } %></tr><% }); if (!payments.length) { %><tr><td colspan="6" class="text-center text-secondary py-3">پرداختی ثبت نشده</td></tr><% } %>
  </tbody></table></div></div>
  <% if (canPay && !print) { %><form method="post" action="/finance/invoices/<%= inv.id %>/pay" class="card mt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="card-header"><h6><i class="bi bi-plus-circle me-1"></i>ثبت پرداخت</h6></div><div class="card-body"><div class="row g-2">
    <div class="col-md-3"><label class="form-label fs-7" for="f_amount">مبلغ (<%= unit %>)</label><input class="form-control ltr" name="amount" value="<%= remaining %>" required id="f_amount"></div>
    <div class="col-md-3"><label class="form-label fs-7" for="f_method">روش</label><select class="form-select" name="method" id="f_method"><% Object.entries(METHODS).forEach(function (m) { %><option value="<%= m[0] %>"><%= m[1] %></option><% }); %></select></div>
    <div class="col-md-3"><label class="form-label fs-7" for="f_paid_at">تاریخ</label><input class="form-control jdate" name="paid_at" value="<%= J.formatDate(J.todayISO()) %>" id="f_paid_at"></div>
    <div class="col-md-3"><label class="form-label fs-7" for="f_reference">شماره پیگیری</label><input class="form-control ltr" name="reference" id="f_reference"></div>
    <div class="col-12"><input class="form-control form-control-sm" name="note" placeholder="یادداشت (اختیاری)"></div>
  </div></div><div class="card-footer bg-transparent text-end"><button class="btn btn-success px-4"><i class="bi bi-check2 me-1"></i>ثبت پرداخت</button></div></form><% } %>
  <% if (print) { %><div class="row mt-4 fs-7"><div class="col-6">مهر و امضای مدرسه</div><div class="col-6 text-end">امضای پرداخت‌کننده</div></div><% } %>
</div></div>
