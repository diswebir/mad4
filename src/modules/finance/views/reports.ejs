<% if (!print) { %><%- include('partials/page-header', { title: 'گزارش مالی', icon: 'bi-graph-up', breadcrumbs: [{ title: 'امور مالی', href: '/finance' }, { title: 'گزارش' }], actions: [{ href: '/finance/reports?print=1', label: 'چاپ', icon: 'bi-printer', class: 'btn-light' }, ...(enabled('finance.export') ? [{ href: '/finance/invoices/export', label: 'CSV صورت‌حساب‌ها', icon: 'bi-download', class: 'btn-light' }, { href: '/finance/payments/export', label: 'CSV پرداخت‌ها', icon: 'bi-download', class: 'btn-light' }] : [])] }) %><% } else { %><h4 class="text-center mb-3">گزارش مالی — <%= J.formatLong(J.todayISO()) %></h4><% } %>
<div class="row g-2 mb-3"><% [['کل مطالبات', sum.due, 'primary'], ['وصول‌شده', sum.paid, 'success'], ['مانده', sum.remaining, 'warning'], ['معوق', sum.overdue, 'danger']].forEach(function (c) { %><div class="col-6 col-md-3"><div class="card"><div class="card-body py-2"><div class="fs-7 text-secondary"><%= c[0] %></div><div class="fs-5 fw-bold text-<%= c[2] %>"><%= utils.money(c[1], unit) %></div></div></div></div><% }); %></div>
<div class="row g-3">
  <div class="col-lg-6"><div class="card table-card"><div class="card-header"><h6>به تفکیک کلاس</h6></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>کلاس</th><th>تعداد</th><th>مطالبات</th><th>وصولی</th><th>درصد</th></tr></thead><tbody><% byClass.forEach(function (r) { var pct = r.due ? Math.round(r.paid / r.due * 100) : 0; %><tr><td><%= r.class_title || '—' %></td><td><%= J.toPersianDigits(r.cnt) %></td><td><%= utils.money(r.due, false) %></td><td class="text-success"><%= utils.money(r.paid, false) %></td><td><div class="d-flex align-items-center gap-1"><div class="progress flex-grow-1" style="height:6px"><div class="progress-bar bg-success" style="width:<%= pct %>%"></div></div><span class="fs-7"><%= J.toPersianDigits(pct) %>٪</span></div></td></tr><% }); %></tbody></table></div></div>
    <div class="card table-card mt-3"><div class="card-header"><h6>به تفکیک نوع هزینه</h6></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>نوع</th><th>تعداد</th><th>مطالبات</th><th>وصولی</th></tr></thead><tbody><% byType.forEach(function (r) { %><tr><td><%= FEE_TYPES[r.type] || 'متفرقه' %></td><td><%= J.toPersianDigits(r.cnt) %></td><td><%= utils.money(r.due, false) %></td><td class="text-success"><%= utils.money(r.paid, false) %></td></tr><% }); %></tbody></table></div></div>
    <div class="card table-card mt-3"><div class="card-header"><h6>روش‌های پرداخت</h6></div><div class="table-responsive"><table class="table table-sm mb-0"><tbody><% byMethod.forEach(function (r) { %><tr><td><%= METHODS[r.method] || r.method %></td><td><%= J.toPersianDigits(r.cnt) %> تراکنش</td><td class="fw-semibold"><%= utils.money(r.total, false) %></td></tr><% }); %></tbody></table></div></div></div>
  <div class="col-lg-6"><div class="card table-card"><div class="card-header"><h6><i class="bi bi-person-exclamation text-danger me-1"></i>بدهکاران (۳۰ نفر اول)</h6></div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>دانش‌آموز</th><th>کلاس</th><th>تماس ولی</th><th>صورت‌حساب</th><th>بدهی</th></tr></thead><tbody><% debtors.forEach(function (d) { %><tr><td><a href="/finance/invoices?student_id=<%= d.id %>" class="text-body"><%= d.first_name %> <%= d.last_name %></a></td><td><%= d.class_title || '' %></td><td class="ltr text-end fs-7"><%= J.toPersianDigits(d.father_phone || '') %></td><td><%= J.toPersianDigits(d.cnt) %></td><td class="fw-semibold text-danger"><%= utils.money(d.debt, false) %></td></tr><% }); if (!debtors.length) { %><tr><td colspan="5" class="text-center text-secondary py-3">بدهکاری وجود ندارد</td></tr><% } %></tbody></table></div></div></div>
</div>
