<%- include('partials/page-header', { title: 'امور مالی', icon: 'bi-cash-stack', actions: [{ href: '/finance/invoices/new', label: 'صورت‌حساب جدید', icon: 'bi-plus-lg', class: 'btn-primary' }, { href: '/finance/fees', label: 'شهریه و هزینه‌ها', icon: 'bi-tags', class: 'btn-light' }, { href: '/finance/invoices', label: 'صورت‌حساب‌ها', icon: 'bi-receipt', class: 'btn-light' }, { href: '/finance/payments', label: 'پرداخت‌ها', icon: 'bi-cash', class: 'btn-light' }, ...(enabled('finance.reports') ? [{ href: '/finance/reports', label: 'گزارش', icon: 'bi-graph-up', class: 'btn-light' }] : [])] }) %>
<div class="row g-3 mb-3">
  <% [['کل مطالبات', sum.due, 'primary', 'bi-wallet2'], ['وصول‌شده', sum.paid, 'success', 'bi-check2-circle'], ['مانده', sum.remaining, 'warning', 'bi-hourglass-split'], ['معوق', sum.overdue, 'danger', 'bi-exclamation-octagon']].forEach(function (c) { %>
  <div class="col-6 col-xl-3"><div class="card stat-card"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-<%= c[2] %>"><i class="bi <%= c[3] %>"></i></div><div><div class="fs-7 text-secondary"><%= c[0] %></div><div class="fs-5 fw-bold"><%= utils.money(c[1], unit) %></div></div></div></div></div><% }); %>
</div>
<div class="row g-3">
  <div class="col-lg-7"><div class="card"><div class="card-header"><h6><i class="bi bi-graph-up me-1"></i>وصولی شش ماه اخیر</h6></div><div class="card-body"><canvas id="chMonthly" height="110"></canvas></div></div>
    <div class="card mt-3 table-card"><div class="card-header"><h6><i class="bi bi-exclamation-circle text-danger me-1"></i>صورت‌حساب‌های معوق</h6><div class="d-flex gap-2"><% if (enabled('finance.overdue_notify') && overdue.length) { %><a href="#" data-post="/finance/overdue/remind-all" data-confirm="برای همهٔ بدهکاران یادآوری ارسال شود؟" class="btn btn-sm btn-outline-warning"><i class="bi bi-bell me-1"></i>یادآوری به همه</a><% } %><a href="/finance/invoices?overdue=1" class="btn btn-sm btn-light">همه</a></div></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>شماره</th><th>دانش‌آموز</th><th>عنوان</th><th>سررسید</th><th>مانده</th></tr></thead><tbody>
      <% overdue.forEach(function (i) { %><tr><td><a href="/finance/invoices/<%= i.id %>" class="ltr d-inline-block"><%= J.toPersianDigits(i.number) %></a></td><td><%= i.first_name %> <%= i.last_name %> <span class="fs-7 text-secondary"><%= i.class_title || '' %></span></td><td class="fs-7"><%= i.title %></td><td class="text-danger"><%= J.formatDate(i.due_date) %></td><td class="fw-semibold"><%= utils.money(Number(i.amount) - Number(i.discount || 0) - Number(i.paid_amount || 0), false) %></td></tr><% }); if (!overdue.length) { %><tr><td colspan="5" class="text-center text-secondary py-3">معوقی وجود ندارد</td></tr><% } %></tbody></table></div></div></div>
  <div class="col-lg-5"><div class="card"><div class="card-header"><h6><i class="bi bi-pie-chart me-1"></i>به تفکیک نوع هزینه</h6></div><div class="card-body"><canvas id="chType" height="160"></canvas><table class="table table-sm fs-7 mt-2 mb-0"><% byType.forEach(function (t) { %><tr><td><%= FEE_TYPES[t.type] || 'متفرقه' %></td><td><%= utils.money(t.paid, false) %> / <%= utils.money(t.due, false) %></td><td style="width:90px"><div class="progress" style="height:6px"><div class="progress-bar bg-success" style="width:<%= t.due ? Math.round(t.paid / t.due * 100) : 0 %>%"></div></div></td></tr><% }); %></table></div></div>
    <div class="card mt-3"><div class="card-header"><h6><i class="bi bi-clock-history me-1"></i>آخرین پرداخت‌ها</h6><a href="/finance/payments" class="btn btn-sm btn-light">همه</a></div><ul class="list-group list-group-flush"><% recent.forEach(function (p) { %><li class="list-group-item d-flex justify-content-between align-items-center"><div><div><%= p.first_name %> <%= p.last_name %></div><div class="fs-7 text-secondary"><%= METHODS[p.method] || p.method %> · <%= J.formatDateTime(p.paid_at) %> · <a href="/finance/invoices/<%= p.invoice_id %>" class="ltr d-inline-block"><%= J.toPersianDigits(p.number || '') %></a></div></div><strong class="text-success"><%= utils.money(p.amount, false) %></strong></li><% }); if (!recent.length) { %><li class="list-group-item text-secondary fs-7">پرداختی ثبت نشده</li><% } %></ul></div></div>
</div>
<script src="/assets/vendor/chartjs/chart.umd.min.js"></script>
<script>(function(){var m=<%- JSON.stringify(monthly) %>;new Chart(document.getElementById('chMonthly'),{type:'bar',data:{labels:m.map(function(x){return x.label}),datasets:[{label:'وصولی',data:m.map(function(x){return x.value}),backgroundColor:'#2563eb',borderRadius:6}]},options:{plugins:{legend:{display:false}},scales:{y:{ticks:{callback:function(v){return App.fa(Math.round(v/1000000))+' م'}}}}}});
var t=<%- JSON.stringify(byType.map(function (t) { return { l: FEE_TYPES[t.type] || 'متفرقه', v: Number(t.paid) }; })) %>;new Chart(document.getElementById('chType'),{type:'doughnut',data:{labels:t.map(function(x){return x.l}),datasets:[{data:t.map(function(x){return x.v}),backgroundColor:['#2563eb','#059669','#d97706','#7c3aed','#dc2626','#0891b2','#64748b']}]},options:{plugins:{legend:{position:'bottom'}}}});})();</script>
