<%- include('partials/page-header', { title: 'شهریه و پرداخت‌ها', subtitle: s.first_name + ' ' + s.last_name, icon: 'bi-cash-stack' }) %>
<div class="row g-2 mb-3"><% [['کل شهریه و هزینه‌ها', total, 'primary'], ['پرداخت‌شده', paid, 'success'], ['مانده', total - paid, total - paid > 0 ? 'danger' : 'success']].forEach(function (c) { %><div class="col-md-4"><div class="card"><div class="card-body py-2"><div class="fs-7 text-secondary"><%= c[0] %></div><div class="fs-5 fw-bold text-<%= c[2] %>"><%= utils.money(c[1], unit) %></div></div></div></div><% }); %></div>
<div class="row g-3"><div class="col-lg-7"><div class="card table-card"><div class="card-header"><h6>صورت‌حساب‌ها</h6></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>شماره</th><th>عنوان</th><th>مبلغ</th><th>مانده</th><th>سررسید</th><th>وضعیت</th></tr></thead><tbody>
  <% invoices.forEach(function (i) { var rem = Number(i.amount) - Number(i.discount || 0) - Number(i.paid_amount || 0); %><tr><td><a href="/finance/my/<%= i.id %>" class="ltr d-inline-block"><%= J.toPersianDigits(i.number) %></a></td><td><%= i.title %></td><td><%= utils.money(Number(i.amount) - Number(i.discount || 0), false) %></td><td class="<%= rem > 0 ? 'text-danger fw-semibold' : 'text-success' %>"><%= utils.money(rem, false) %></td><td class="<%= rem > 0 && i.due_date < today ? 'text-danger' : '' %>"><%= J.formatDate(i.due_date) %></td><td><%- utils.statusBadge(i.status) %></td></tr><% }); if (!invoices.length) { %><tr><td colspan="6"><%- include('partials/empty', { message: 'صورت‌حسابی ثبت نشده', icon: 'bi-receipt' }) %></td></tr><% } %>
</tbody></table></div></div></div>
<div class="col-lg-5"><div class="card table-card"><div class="card-header"><h6>پرداخت‌های انجام‌شده</h6></div><div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>تاریخ</th><th>بابت</th><th>روش</th><th>مبلغ</th></tr></thead><tbody>
  <% payments.forEach(function (p) { %><tr><td class="fs-7"><%= J.formatDate(p.paid_at) %></td><td class="fs-7"><%= p.invoice_title || '' %></td><td class="fs-7"><%= METHODS[p.method] || p.method %></td><td class="fw-semibold text-success"><%= utils.money(p.amount, false) %></td></tr><% }); if (!payments.length) { %><tr><td colspan="4" class="text-center text-secondary py-3">پرداختی ثبت نشده</td></tr><% } %>
</tbody></table></div></div><div class="fs-7 text-secondary mt-2"><i class="bi bi-info-circle me-1"></i>برای پرداخت به دفتر مدرسه مراجعه کنید یا با امور مالی تماس بگیرید. مبالغ به <%= unit %> است.</div></div></div>
