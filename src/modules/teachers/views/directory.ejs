<%- include('partials/page-header', { title: 'دفترچهٔ تماس همکاران', icon: 'bi-people', breadcrumbs: [{ title: 'همکاران' }] }) %>
<div class="card mb-3"><div class="card-body py-2"><input class="form-control" placeholder="جستجوی نام یا تخصص…" data-filter-table="#dirTable"></div></div>
<div class="row g-3" id="dirTable"><% rows.forEach(function (r) { %>
  <div class="col-md-6 col-xl-4 filter-item" data-text="<%= r.name %> <%= r.field || '' %>"><div class="card h-100"><div class="card-body d-flex align-items-center gap-3">
    <%- include('partials/avatar', { user: r, size: 48 }) %>
    <div class="flex-grow-1"><div class="fw-semibold"><%= r.name %></div><div class="text-secondary fs-7"><%= r.field || '' %> <%= r.education ? '· ' + (utils.EDUCATIONS[r.education] || r.education) : '' %></div>
      <div class="fs-7 mt-1"><% if (r.phone) { %><a href="tel:<%= r.phone %>" class="ltr d-inline-block me-2"><i class="bi bi-telephone me-1"></i><%= J.toPersianDigits(r.phone) %></a><% } %><% if (r.email) { %><a href="mailto:<%= r.email %>" class="ltr d-inline-block"><i class="bi bi-envelope me-1"></i><%= r.email %></a><% } %></div></div>
    <% if (enabled('messages')) { %><a href="/messages/compose?to=<%= r.id %>" class="btn btn-sm btn-light" title="پیام"><i class="bi bi-chat-dots"></i></a><% } %>
  </div></div></div>
<% }); %></div>
