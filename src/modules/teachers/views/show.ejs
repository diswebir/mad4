<%- include('partials/page-header', { title: t.name, subtitle: (t.field ? t.field + ' · ' : '') + (utils.EDUCATIONS[t.education] || '') + (t.personnel_code ? ' · کد پرسنلی ' + J.toPersianDigits(t.personnel_code) : ''), icon: 'bi-person-video3', breadcrumbs: [{ title: 'معلمان', href: isAdmin ? '/teachers' : '/dashboard' }, { title: t.name }], actions: [
  ...(enabled('academic.schedule') ? [{ href: '/academic/schedule/teacher/' + t.id, label: 'برنامه هفتگی', icon: 'bi-table', class: 'btn-light' }] : []),
  ...(isAdmin && enabled('messages') ? [{ href: '/messages/compose?to=' + t.user_id, label: 'پیام', icon: 'bi-envelope', class: 'btn-light' }] : []),
  ...(isAdmin ? [{ href: '/teachers/' + t.id + '/edit', label: 'ویرایش', icon: 'bi-pencil', class: 'btn-primary' }] : [])
] }) %>
<div class="row g-3">
  <div class="col-lg-4">
    <div class="card mb-3"><div class="card-body text-center">
      <div class="mx-auto mb-2"><%- include('partials/avatar', { user: t, size: 96 }) %></div>
      <h5 class="mb-0"><%= t.name %></h5>
      <div class="text-secondary fs-7 mb-2"><%= utils.statusBadge(t.status, { active: 'فعال', inactive: 'غیرفعال', leave: 'مرخصی' }) %> <span class="ltr d-inline-block">@<%= t.username %></span></div>
      <div class="d-flex justify-content-center gap-3 fs-7">
        <% if (t.phone) { %><a href="tel:<%= t.phone %>" class="ltr"><i class="bi bi-telephone me-1"></i><%= J.toPersianDigits(t.phone) %></a><% } %>
        <% if (t.email) { %><a href="mailto:<%= t.email %>" class="ltr"><i class="bi bi-envelope me-1"></i><%= t.email %></a><% } %>
      </div>
    </div>
    <div class="card-body border-top info-list">
      <div class="row g-2 fs-7">
        <div class="col-6"><span class="text-secondary">کد ملی:</span> <span class="ltr d-inline-block"><%= J.toPersianDigits(t.national_id || '—') %></span></div>
        <div class="col-6"><span class="text-secondary">جنسیت:</span> <%= utils.GENDERS_ADULT[t.gender] || '—' %></div>
        <div class="col-6"><span class="text-secondary">تولد:</span> <%= t.birth_date ? J.formatDate(t.birth_date) + ' (' + J.toPersianDigits(J.age(t.birth_date)) + ' سال)' : '—' %></div>
        <div class="col-6"><span class="text-secondary">استخدام:</span> <%= t.hire_date ? J.formatDate(t.hire_date) : '—' %></div>
        <div class="col-6"><span class="text-secondary">نوع همکاری:</span> <%= { official: 'رسمی', contract: 'پیمانی', hourly: 'حق‌التدریس', parttime: 'پاره‌وقت' }[t.employment_type] || '—' %></div>
        <div class="col-6"><span class="text-secondary">آخرین ورود:</span> <%= t.last_login_at ? J.timeAgo(t.last_login_at) : 'هرگز' %></div>
        <% if (t.address) { %><div class="col-12"><span class="text-secondary">نشانی:</span> <%= t.address %></div><% } %>
        <% if (t.bio) { %><div class="col-12 border-top pt-2 mt-1"><%- utils.nl2br(t.bio) %></div><% } %>
      </div>
    </div></div>
    <% if (enabled('hr.leaves')) { %>
    <div class="card mb-3"><div class="card-header"><h6><i class="bi bi-calendar-x me-1"></i>مرخصی‌ها</h6><a href="/hr/leaves?user_id=<%= t.user_id %>" class="fs-7">همه</a></div>
      <ul class="list-group list-group-flush"><% leaves.forEach(function (l) { %><li class="list-group-item d-flex justify-content-between fs-7"><span><%= J.formatDate(l.from_date) %><%= l.to_date && l.to_date !== l.from_date ? ' تا ' + J.formatDate(l.to_date) : '' %></span><%- utils.statusBadge(l.status) %></li><% }); if (!leaves.length) { %><li class="list-group-item text-secondary fs-7">درخواستی ثبت نشده</li><% } %></ul></div>
    <% } %>
    <% if (enabled('attendance.staff') && staffAtt.length) { %>
    <div class="card mb-3"><div class="card-header"><h6><i class="bi bi-clipboard-check me-1"></i>حضور کارکنان</h6></div><div class="card-body d-flex gap-2 flex-wrap"><% staffAtt.forEach(function (a) { %><span class="badge badge-soft-<%= utils.ATT_COLORS[a.status] || 'secondary' %>"><%= utils.ATT_STATUS[a.status] || a.status %>: <%= J.toPersianDigits(a.c) %></span><% }); %></div></div>
    <% } %>
  </div>
  <div class="col-lg-8">
    <div class="row g-3 mb-3">
      <div class="col-4"><div class="card stat-card text-primary"><div class="card-body d-flex align-items-center gap-3"><div class="icon bg-brand-soft"><i class="bi bi-clock"></i></div><div><div class="value"><%= J.toPersianDigits(hours) %></div><div class="label">ساعت تدریس در هفته</div></div></div></div></div>
      <div class="col-4"><div class="card stat-card text-success"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-success"><i class="bi bi-door-open"></i></div><div><div class="value"><%= J.toPersianDigits(homeroom.filter(function (c) { return c.is_active; }).length) %></div><div class="label">کلاس تحت سرپرستی</div></div></div></div></div>
      <div class="col-4"><div class="card stat-card text-warning"><div class="card-body d-flex align-items-center gap-3"><div class="icon badge-soft-warning"><i class="bi bi-book"></i></div><div><div class="value"><%= J.toPersianDigits(teaching.length) %></div><div class="label">درس در کلاس‌ها <% if (enabled('tickets') && tickets) { %>· <%= J.toPersianDigits(tickets) %> تیکت باز<% } %></div></div></div></div></div>
    </div>
    <div class="card table-card mb-3"><div class="card-header"><h6><i class="bi bi-door-open me-1"></i>کلاس‌های تحت سرپرستی</h6></div>
      <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>کلاس</th><th>پایه</th><th>دانش‌آموزان</th><th>وضعیت</th><th></th></tr></thead>
        <tbody><% homeroom.forEach(function (c) { %><tr><td class="fw-semibold"><a href="/academic/classes/<%= c.id %>"><%= c.title %></a></td><td><%= c.grade_title %></td><td><%= J.toPersianDigits(c.cnt) %></td><td><%- c.is_active ? '<span class="badge badge-soft-success">فعال</span>' : '<span class="badge badge-soft-secondary">بایگانی</span>' %></td><td class="text-end"><% if (enabled('attendance')) { %><a href="/attendance/take?class_id=<%= c.id %>" class="btn btn-sm btn-light">حضور و غیاب</a><% } %></td></tr><% }); if (!homeroom.length) { %><tr><td colspan="5" class="text-center text-secondary py-3">کلاسی تحت سرپرستی ندارد</td></tr><% } %></tbody></table></div></div>
    <div class="card table-card mb-3"><div class="card-header"><h6><i class="bi bi-book me-1"></i>دروس تدریسی</h6></div>
      <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>درس</th><th>کلاس</th><th>ساعت/هفته</th><th></th></tr></thead>
        <tbody><% teaching.forEach(function (r) { %><tr><td class="fw-semibold"><%= r.subject_title %></td><td><a href="/academic/classes/<%= r.class_id %>"><%= r.class_title %></a></td><td><%= J.toPersianDigits(r.weekly_hours || 0) %></td><td class="text-end"><% if (enabled('exams')) { %><a href="/exams?class_subject_id=<%= r.id %>" class="btn btn-sm btn-light">آزمون‌ها</a><% } %> <% if (enabled('homework')) { %><a href="/homework?class_subject_id=<%= r.id %>" class="btn btn-sm btn-light">تکالیف</a><% } %></td></tr><% }); if (!teaching.length) { %><tr><td colspan="4" class="text-center text-secondary py-3">درسی تخصیص داده نشده</td></tr><% } %></tbody></table></div></div>
    <% if (enabled('teachers.documents')) { %>
    <div class="card table-card" id="docs"><div class="card-header"><h6><i class="bi bi-folder2-open me-1"></i>مدارک و فایل‌ها</h6></div>
      <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>عنوان</th><th>فایل</th><th>حجم</th><th>تاریخ</th><th></th></tr></thead>
        <tbody><% documents.forEach(function (d) { %><tr><td><%= d.title %></td><td><a href="/files/<%= d.file_path %>" target="_blank" class="fs-7"><i class="bi bi-download me-1"></i><%= d.file_name %></a></td><td class="fs-7"><%= utils.fileSize(d.size) %></td><td class="fs-7"><%= J.formatDate(d.created_at) %></td><td class="text-end"><% if (isAdmin || mine) { %><a href="#" data-post="/teachers/<%= t.id %>/documents/<%= d.id %>/delete" data-confirm="حذف شود؟" class="btn btn-sm btn-light text-danger" aria-label="حذف" title="حذف"><i class="bi bi-trash"></i></a><% } %></td></tr><% }); if (!documents.length) { %><tr><td colspan="5" class="text-center text-secondary py-3">مدرکی بارگذاری نشده</td></tr><% } %></tbody></table></div>
      <% if (isAdmin || mine) { %><div class="card-footer bg-transparent"><form method="post" action="/teachers/<%= t.id %>/documents" enctype="multipart/form-data" class="row g-2 align-items-end"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="col-md-4"><label class="form-label fs-7" for="f_title">عنوان</label><input class="form-control form-control-sm" name="title" placeholder="مثال: حکم کارگزینی" id="f_title"></div>
        <div class="col-md-5"><label class="form-label fs-7" for="f_file">فایل (حداکثر ۱۰ مگابایت)</label><input type="file" class="form-control form-control-sm" name="file" required id="f_file"></div>
        <div class="col-md-3"><button class="btn btn-sm btn-primary w-100"><i class="bi bi-upload me-1"></i>بارگذاری</button></div></form></div><% } %>
    </div>
    <% } %>
  </div>
</div>
