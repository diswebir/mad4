<%- include('partials/page-header', { title: 'کلاس‌های من', icon: 'bi-easel', breadcrumbs: [{ title: 'کلاس‌های من' }], actions: [
  ...(enabled('academic.schedule') ? [{ href: '/academic/schedule/teacher/' + teacher.id, label: 'برنامه هفتگی من', icon: 'bi-table', class: 'btn-light' }] : []),
  { href: '/teachers/' + teacher.id, label: 'پروندهٔ من', icon: 'bi-person', class: 'btn-light' }
] }) %>
<% if (enabled('academic.schedule')) { %>
<div class="card mb-3"><div class="card-header"><h6><i class="bi bi-calendar-day me-1"></i>برنامهٔ امروز — <%= J.formatLong(J.todayISO()) %></h6></div>
  <div class="card-body d-flex flex-wrap gap-2"><% todaySlots.forEach(function (s) { %><div class="border rounded p-2 fs-7 d-flex align-items-center gap-2"><span class="badge text-bg-primary">زنگ <%= J.toPersianDigits(s.period) %></span><strong><%= s.subject_title %></strong><span class="text-secondary"><%= s.class_title %></span><% if (enabled('attendance.per_subject')) { %><a href="/attendance/take?class_id=<%= s.class_id %>&class_subject_id=<%= s.class_subject_id %>" class="btn btn-sm btn-outline-success py-0">حضور و غیاب</a><% } %></div><% }); if (!todaySlots.length) { %><span class="text-secondary fs-7">امروز زنگی در برنامهٔ شما ثبت نشده است.</span><% } %></div></div>
<% } %>
<% if (homeroom.length) { %>
<h6 class="text-brand mb-2"><i class="bi bi-star me-1"></i>کلاس‌های تحت سرپرستی (معلم راهنما)</h6>
<div class="row g-3 mb-4"><% homeroom.forEach(function (c) { %>
  <div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-body">
    <div class="d-flex justify-content-between align-items-start"><div><h5 class="mb-0"><a href="/academic/classes/<%= c.id %>"><%= c.title %></a></h5><div class="text-secondary fs-7"><%= c.grade_title %> · <%= J.toPersianDigits(c.cnt) %> دانش‌آموز</div></div><span class="badge badge-soft-warning">راهنما</span></div>
    <div class="d-flex flex-wrap gap-2 mt-3">
      <% if (enabled('attendance.daily')) { %><a href="/attendance/take?class_id=<%= c.id %>" class="btn btn-sm btn-success"><i class="bi bi-clipboard-check me-1"></i>حضور و غیاب روزانه</a><% } %>
      <a href="/academic/classes/<%= c.id %>" class="btn btn-sm btn-light"><i class="bi bi-people me-1"></i>دانش‌آموزان</a>
      <% if (enabled('attendance.class_report')) { %><a href="/attendance/report/class/<%= c.id %>" class="btn btn-sm btn-light"><i class="bi bi-graph-up me-1"></i>گزارش حضور</a><% } %>
      <% if (enabled('discipline')) { %><a href="/discipline?class_id=<%= c.id %>" class="btn btn-sm btn-light"><i class="bi bi-shield-check me-1"></i>انضباطی</a><% } %>
    </div>
  </div></div></div>
<% }); %></div>
<% } %>
<h6 class="text-brand mb-2"><i class="bi bi-book me-1"></i>دروس تدریسی</h6>
<div class="row g-3"><% teaching.forEach(function (r) { %>
  <div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-body">
    <h6 class="mb-0"><%= r.subject_title %></h6><div class="text-secondary fs-7"><a href="/academic/classes/<%= r.class_id %>"><%= r.class_title %></a> · <%= r.grade_title %> · <%= J.toPersianDigits(r.cnt) %> دانش‌آموز · <%= J.toPersianDigits(r.weekly_hours || 0) %> ساعت/هفته</div>
    <div class="d-flex flex-wrap gap-2 mt-3">
      <% if (enabled('attendance.per_subject')) { %><a href="/attendance/take?class_id=<%= r.class_id %>&class_subject_id=<%= r.id %>" class="btn btn-sm btn-outline-success">حضور و غیاب</a><% } %>
      <% if (enabled('exams')) { %><a href="/exams?class_subject_id=<%= r.id %>" class="btn btn-sm btn-light">آزمون‌ها (<%= J.toPersianDigits(r.exams) %>)</a><% } %>
      <% if (enabled('homework')) { %><a href="/homework?class_subject_id=<%= r.id %>" class="btn btn-sm btn-light">تکالیف (<%= J.toPersianDigits(r.homework) %>)</a><% } %>
    </div>
  </div></div></div>
<% }); if (!teaching.length) { %><div class="col-12"><%- include('partials/empty', { message: 'هنوز درسی به شما تخصیص داده نشده است' }) %></div><% } %></div>
