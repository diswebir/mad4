<%- include('partials/page-header', { title: 'راهنمای سامانه', icon: 'bi-life-preserver', subtitle: 'راهنمای کاربری مطابق نقش شما و بخش‌های فعال سامانه', breadcrumbs: [{ title: 'راهنما' }], actions: enabled('help.about') ? [{ href: '/help/about', label: 'دربارهٔ سامانه', icon: 'bi-info-circle', class: 'btn-outline-secondary' }] : [] }) %>
<div class="row g-3">
  <div class="col-lg-3">
    <div class="card mb-3"><div class="card-body p-2">
      <form method="get" class="d-flex gap-1"><input class="form-control form-control-sm" name="q" value="<%= q %>" placeholder="جستجو در راهنما…"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button></form>
    </div></div>
    <div class="list-group help-nav">
      <% topics.forEach(function (t) { %><a href="/help?topic=<%= t.key %>" class="list-group-item list-group-item-action d-flex align-items-center gap-2 <%= (!results && topic && topic.key === t.key) ? 'active' : '' %>"><i class="bi <%= t.icon %>"></i><%= t.title %></a><% }); %>
    </div>
  </div>
  <div class="col-lg-9">
    <% if (results) { %>
      <div class="card"><div class="card-header"><h6><i class="bi bi-search me-1"></i>نتایج جستجو برای «<%= q %>» (<%= J.toPersianDigits(results.length) %>)</h6></div>
        <div class="list-group list-group-flush">
          <% if (!results.length) { %><div class="list-group-item"><%- include('partials/empty', { message: 'موردی یافت نشد' }) %></div><% } %>
          <% results.forEach(function (r) { %><a class="list-group-item list-group-item-action" href="/help?topic=<%= r.topic.key %>#s-<%= encodeURIComponent(r.section.h) %>"><div class="fw-bold"><%= r.section.h %></div><div class="fs-7 text-muted"><i class="bi <%= r.topic.icon %> me-1"></i><%= r.topic.title %> · <%= ((r.section.p || r.section.steps || r.section.tips || [])[0] || '').slice(0, 140) %>…</div></a><% }); %>
        </div></div>
    <% } else if (topic) { %>
      <div class="card">
        <div class="card-header"><h5 class="mb-0"><i class="bi <%= topic.icon %> me-2 text-brand"></i><%= topic.title %></h5></div>
        <div class="card-body help-body">
          <% if (topic.intro) { %><p class="lead fs-6 text-secondary"><%= topic.intro %></p><% } %>
          <% if (topic.key === 'start' && enabled('help.checklist')) { %><a href="/help/setup" class="btn btn-primary btn-sm mb-3"><i class="bi bi-check2-square me-1"></i>مشاهدهٔ وضعیت زندهٔ راه‌اندازی</a><% } %>
          <% topic.sections.forEach(function (s) { %>
            <section class="help-section mb-4" id="s-<%= encodeURIComponent(s.h) %>">
              <h6 class="border-bottom pb-2 mb-2"><i class="bi bi-chevron-left fs-7 me-1 text-brand"></i><%= s.h %></h6>
              <% (s.p || []).forEach(function (p) { %><p class="mb-2"><%= p %></p><% }); %>
              <% if (s.steps) { %><ol class="mb-2 lh-lg"><% s.steps.forEach(function (st) { %><li><%= st %></li><% }); %></ol><% } %>
              <% if (s.tips) { %><ul class="mb-0 lh-lg list-unstyled"><% s.tips.forEach(function (tp) { %><li><i class="bi bi-lightbulb text-warning me-1"></i><%= tp %></li><% }); %></ul><% } %>
            </section>
          <% }); %>
        </div>
        <div class="card-footer fs-7 text-muted d-flex justify-content-between flex-wrap gap-2"><span>نسخهٔ <%= J.toPersianDigits(appVersion) %> · بخش‌های مربوط به ماژول‌های غیرفعال نمایش داده نمی‌شوند.</span><% if (enabled('tickets') && currentUser.role !== 'admin') { %><a href="/tickets/new"><i class="bi bi-ticket me-1"></i>پاسخ خود را نیافتید؟ تیکت بزنید</a><% } %></div>
      </div>
    <% } else { %>
      <%- include('partials/empty', { message: 'راهنمایی برای نقش شما ثبت نشده است' }) %>
    <% } %>
  </div>
</div>
