<%- include('../../views/partials/page-header', { title: 'تغییر رمز عبور', icon: 'bi-key', breadcrumbs: [{ title: 'تغییر رمز عبور' }] }) %>
<% if (force) { %><div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i>برای ادامه باید رمز عبور خود را تغییر دهید.</div><% } %>
<form method="post" action="/auth/password" class="card" style="max-width:520px">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <% if (!force) { %><div class="mb-3"><label class="form-label required">رمز عبور فعلی</label><input class="form-control ltr" type="password" name="current" required autocomplete="current-password"></div><% } %>
    <div class="mb-3"><label class="form-label required">رمز عبور جدید</label><input class="form-control ltr" type="password" name="password" required minlength="6" autocomplete="new-password"><div class="form-text">حداقل ۶ کاراکتر</div></div>
    <div class="mb-3"><label class="form-label required">تکرار رمز عبور جدید</label><input class="form-control ltr" type="password" name="password2" required minlength="6" autocomplete="new-password"></div>
  </div>
  <div class="card-footer bg-transparent text-end"><button class="btn btn-primary px-4">ذخیره</button></div>
</form>
