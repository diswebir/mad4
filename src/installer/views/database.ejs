<form method="post" action="/install/database" class="card">
  <div class="card-header"><h5><i class="bi bi-database me-1 text-brand"></i>تنظیمات پایگاه داده</h5></div>
  <div class="card-body">
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <label class="d-block border rounded-3 p-3 h-100 cursor-pointer <%= !mysql ? 'opacity-50' : '' %>">
          <input class="form-check-input me-2" type="radio" name="db_client" value="mysql" <%= (form.db_client === 'mysql') ? 'checked' : '' %> <%= mysql ? '' : 'disabled' %> onchange="document.getElementById('mysqlBox').classList.remove('d-none')">
          <strong>MySQL / MariaDB</strong> <span class="badge badge-soft-success">پیشنهادی برای cPanel</span>
          <div class="fs-7 text-secondary mt-1">ابتدا از بخش «MySQL® Databases» در cPanel یک پایگاه داده و کاربر بسازید و همهٔ دسترسی‌ها را به کاربر بدهید.</div>
        </label>
      </div>
      <div class="col-md-6">
        <label class="d-block border rounded-3 p-3 h-100 cursor-pointer <%= !sqliteDrivers.length ? 'opacity-50' : '' %>">
          <input class="form-check-input me-2" type="radio" name="db_client" value="sqlite" <%= (!form.db_client || form.db_client === 'sqlite') && sqliteDrivers.length ? 'checked' : '' %> <%= sqliteDrivers.length ? '' : 'disabled' %> onchange="document.getElementById('mysqlBox').classList.add('d-none')">
          <strong>SQLite</strong> <span class="badge badge-soft-info">بدون تنظیم</span>
          <div class="fs-7 text-secondary mt-1">فایل پایگاه داده در پوشهٔ storage ساخته می‌شود. درایور: <span class="ltr"><%= sqliteDrivers.join(' › ') || '—' %></span></div>
        </label>
      </div>
    </div>
    <div id="mysqlBox" class="row g-3 <%= form.db_client === 'mysql' ? '' : 'd-none' %>">
      <div class="col-md-8"><label class="form-label" for="f_db_host">میزبان (Host)</label><input class="form-control ltr" name="db_host" value="<%= form.db_host || 'localhost' %>" id="f_db_host"></div>
      <div class="col-md-4"><label class="form-label" for="f_db_port">پورت</label><input class="form-control ltr" name="db_port" value="<%= form.db_port || '3306' %>" id="f_db_port"></div>
      <div class="col-md-4"><label class="form-label" for="f_db_name">نام پایگاه داده</label><input class="form-control ltr" name="db_name" value="<%= form.db_name || '' %>" placeholder="cpuser_school" id="f_db_name"></div>
      <div class="col-md-4"><label class="form-label" for="f_db_user">نام کاربری</label><input class="form-control ltr" name="db_user" value="<%= form.db_user || '' %>" placeholder="cpuser_school" id="f_db_user"></div>
      <div class="col-md-4"><label class="form-label" for="f_db_password">رمز عبور</label><input class="form-control ltr" type="password" name="db_password" value="<%= form.db_password || '' %>" id="f_db_password"></div>
    </div>
  </div>
  <div class="card-footer bg-transparent d-flex justify-content-between">
    <a href="/install" class="btn btn-light"><i class="bi bi-arrow-right me-1"></i>قبلی</a>
    <button class="btn btn-primary">آزمایش اتصال و ادامه <i class="bi bi-arrow-left ms-1"></i></button>
  </div>
</form>
