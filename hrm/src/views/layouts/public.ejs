<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<meta name="robots" content="noindex, nofollow">
<title><%= title %> | <%= company('company_short_name') || company('company_name') %></title>
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/vendor/bootstrap/bootstrap.rtl.min.css">
<link rel="stylesheet" href="/assets/vendor/bootstrap-icons/bootstrap-icons.min.css">
<link rel="stylesheet" href="/assets/css/app.css?v=<%= appVersion %>">
<%- typeof style !== 'undefined' ? style : '' %>
</head>
<body>
<div class="public-wrap">
  <div class="public-top">
    <div class="inner">
      <span class="logo d-inline-flex align-items-center justify-content-center rounded-4 text-white" style="width:42px;height:42px;background:linear-gradient(135deg,var(--brand),var(--sky));overflow:hidden"><% if (company('company_logo')) { %><img src="/files/<%= company('company_logo') %>" alt="" style="width:100%;height:100%;object-fit:cover"><% } else { %><i class="bi bi-people-fill"></i><% } %></span>
      <div class="mw-0"><div class="fw-bold truncate"><%= company('company_name') %></div><div class="text-secondary fs-8">سامانهٔ استخدام</div></div>
      <div class="ms-auto d-flex gap-2 align-items-center">
        <% if (currentUser) { %>
          <span class="d-none d-sm-inline fs-7 text-secondary"><i class="bi bi-person-circle me-1"></i><%= currentUser.name || utils.maskMobile(currentUser.mobile) %></span>
          <a href="#" data-post="/auth/logout" class="btn btn-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i>خروج</a>
        <% } else { %>
          <a href="/apply/login" class="btn btn-light btn-sm"><i class="bi bi-phone me-1"></i>ورود متقاضیان</a>
        <% } %>
      </div>
    </div>
  </div>
  <div class="public-body<%= typeof narrow !== 'undefined' && narrow ? ' narrow' : '' %>">
    <%- include('../partials/flash') %>
    <%- body %>
    <p class="text-center text-secondary fs-7 mt-4"><%= company('company_name') %> · <%= J.formatLong(J.todayISO()) %></p>
  </div>
</div>
<script src="/assets/vendor/bootstrap/bootstrap.bundle.min.js"></script>
<script src="/assets/js/jalali.js?v=<%= appVersion %>"></script>
<script src="/assets/js/app.js?v=<%= appVersion %>"></script>
<%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
