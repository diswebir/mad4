<aside class="sidebar">
  <a class="brand" href="<%= currentUser && currentUser.role === 'applicant' ? '/portal' : '/dashboard' %>">
    <span class="logo"><% if (company('company_logo')) { %><img src="/files/<%= company('company_logo') %>" alt=""><% } else { %><i class="bi bi-people-fill"></i><% } %></span>
    <span class="mw-0"><span class="name d-block truncate"><%= company('company_short_name') || company('company_name') %></span><span class="sub d-block truncate"><%= company('company_slogan') || 'سامانهٔ منابع انسانی' %></span></span>
  </a>
  <% if (currentUser) { %>
  <div class="user-card">
    <%- include('avatar', { user: currentUser, size: 36 }) %>
    <div class="mw-0"><div class="fw-bold fs-7 truncate"><%= currentUser.name %></div><div class="text-secondary truncate" style="font-size:.7rem"><%= utils.ROLES[currentUser.role] %></div></div>
  </div>
  <% } %>
  <nav class="<%= S.get('sidebar_mode', 'accordion') === 'flat' ? 'flat' : 'accordion' %>" id="sideNav" data-single="<%= S.get('sidebar_single', '0') === '1' ? '1' : '0' %>">
    <% (menu || []).forEach(function (group, gi) {
         var groupActive = false; var groupBadge = 0;
         group.items.forEach(function (item) {
           item._active = (item.href === '/dashboard' || item.href === '/portal') ? currentPath === item.href : (currentPath === item.href || currentPath.startsWith(item.href + '/') || (item.match && currentPath.startsWith(item.match)));
           if (item._active) groupActive = true;
           var b = item.badge === 'notifications' ? (unreadNotifications || 0) : item.badge === 'applications' ? (typeof badgeNewApplications !== 'undefined' ? badgeNewApplications : 0) : 0; item._badge = b; groupBadge += b;
         });
         var pinned = group.key === 'main';
    %>
      <div class="nav-group<%= pinned ? ' pinned' : '' %><%= groupActive || pinned ? ' open' : '' %>" data-group="<%= group.key %>">
        <% if (pinned) { %><div class="group-title"><%= group.title %></div><% } else { %>
        <button type="button" class="group-toggle" aria-expanded="<%= groupActive ? 'true' : 'false' %>" aria-controls="sbg-<%= group.key %>">
          <i class="bi <%= group.icon || 'bi-folder' %>"></i><span><%= group.title %></span>
          <% if (groupBadge) { %><span class="badge text-bg-danger group-badge"><%= J.toPersianDigits(groupBadge) %></span><% } %>
          <i class="bi bi-chevron-down chev"></i>
        </button>
        <% } %>
        <div class="group-items" id="sbg-<%= group.key %>">
        <% group.items.forEach(function (item) { %>
          <a class="nav-link<%= item._active ? ' active' : '' %>" href="<%= item.href %>">
            <i class="bi <%= item.icon %>"></i><span><%= item.title %></span>
            <% if (item._badge) { %><span class="badge text-bg-danger"><%= J.toPersianDigits(item._badge) %></span><% } %>
          </a>
        <% }); %>
        </div>
      </div>
    <% }); %>
  </nav>
  <div class="footer">نسخهٔ <%= J.toPersianDigits(appVersion) %> · <%= currentUser ? utils.ROLES[currentUser.role] : '' %></div>
</aside>
