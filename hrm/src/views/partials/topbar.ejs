<header class="topbar">
  <button class="icon-btn d-lg-none" type="button" data-toggle-sidebar aria-label="منو"><i class="bi bi-list"></i></button>
  <% if (currentUser && isHR && enabled('recruitment') && can('applicants.view')) { %>
  <form class="search position-relative" action="/recruitment/applications" method="get" role="search">
    <i class="bi bi-search"></i>
    <input type="search" class="form-control" id="globalSearch" name="q" placeholder="جستجوی متقاضی: نام، کد ملی، موبایل، کد پیگیری… (Ctrl+K)" value="<%= currentPath.startsWith('/recruitment/applications') ? (query.q || '') : '' %>" autocomplete="off">
  </form>
  <% } %>
  <div class="ms-auto d-flex align-items-center gap-1">
    <span class="d-none d-md-inline text-secondary fs-7 me-2"><i class="bi bi-calendar3 me-1"></i><%= J.formatLong(J.todayISO()) %></span>
    <% if (enabled('system.dark_mode')) { %><button class="icon-btn" type="button" data-toggle-theme title="تغییر پوسته"><i class="bi <%= theme === 'dark' ? 'bi-sun' : 'bi-moon-stars' %>"></i></button><% } %>
    <% if (currentUser && enabled('notifications.inapp')) { %>
    <div class="dropdown">
      <button class="icon-btn" type="button" id="notifBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="اعلان‌ها"><i class="bi bi-bell"></i><% if (unreadNotifications) { %><span class="dot"><%= J.toPersianDigits(unreadNotifications) %></span><% } %></button>
      <div class="dropdown-menu dropdown-menu-start notif-menu" id="notifMenu">
        <div class="d-flex justify-content-between align-items-center px-2 py-1"><strong>اعلان‌ها</strong><a href="/notifications" class="fs-7">مشاهده همه</a></div>
        <div class="px-2 py-3 text-center text-secondary fs-7" id="notifLoading">در حال بارگذاری…</div>
      </div>
    </div>
    <% } %>
    <% if (currentUser) { %>
    <div class="dropdown">
      <button class="btn d-flex align-items-center gap-2 p-1 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <%- include('avatar', { user: currentUser, size: '' }) %>
        <span class="d-none d-md-block text-start lh-sm"><span class="d-block fw-500 fs-7"><%= currentUser.name %></span><span class="d-block text-secondary" style="font-size:.7rem"><%= utils.ROLES[currentUser.role] %></span></span>
        <i class="bi bi-chevron-down fs-7 d-none d-md-block"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-start">
        <li><a class="dropdown-item" href="/auth/profile"><i class="bi bi-person"></i>پروفایل من</a></li>
        <% if (currentUser.role !== 'applicant') { %><li><a class="dropdown-item" href="/auth/password"><i class="bi bi-key"></i>تغییر رمز عبور</a></li><% } %>
        <% if (can('settings.manage')) { %><li><a class="dropdown-item" href="/system/settings"><i class="bi bi-gear"></i>تنظیمات</a></li><% } %>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item text-danger" href="#" data-post="/auth/logout"><i class="bi bi-box-arrow-right"></i>خروج</a></li>
      </ul>
    </div>
    <% } %>
  </div>
</header>
<% if (currentUser && enabled('notifications.inapp')) { %>
<script>
(function(){var btn=document.getElementById('notifBtn');if(!btn)return;var loaded=false;btn.addEventListener('show.bs.dropdown',function(){if(loaded)return;fetch('/notifications/latest',{headers:{'Accept':'application/json'}}).then(function(r){return r.json()}).then(function(d){loaded=true;var box=document.getElementById('notifLoading');if(!d.items||!d.items.length){box.textContent='اعلانی ندارید';return;}var html='';d.items.forEach(function(n){html+='<a class="item'+(n.is_read?'':' unread')+'" href="'+(n.link||'/notifications')+'"><i class="bi bi-dot fs-4 lh-1"></i><div><div class="t">'+n.title+'</div>'+(n.body?'<div class="b">'+n.body+'</div>':'')+'<div class="b">'+n.ago+'</div></div></a>';});box.outerHTML=html;}).catch(function(){});});})();
</script>
<% } %>
