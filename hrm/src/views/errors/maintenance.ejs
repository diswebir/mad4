<div class="text-center py-4">
  <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning mb-3" style="width:88px;height:88px"><i class="bi bi-tools" style="font-size:2.6rem"></i></div>
  <h3 class="mb-2">سامانه در حال تعمیر و نگهداری است</h3>
  <p class="text-secondary mb-3" style="white-space:pre-line"><%= message %></p>
  <% if (until) { %><div class="alert alert-light border d-inline-block py-2 px-3 mb-3"><i class="bi bi-clock-history me-1"></i>زمان تقریبی بازگشت: <strong><%= until %></strong></div><% } %>
  <div class="d-flex justify-content-center gap-2 flex-wrap">
    <button class="btn btn-primary" onclick="location.reload()"><i class="bi bi-arrow-clockwise me-1"></i>تلاش دوباره</button>
    <% if (typeof user !== 'undefined' && user) { %><a href="/auth/logout" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-right me-1"></i>خروج</a><% } else { %><a href="/auth/login" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-in-left me-1"></i>ورود مدیر</a><% } %>
  </div>
  <p class="text-secondary fs-7 mt-4 mb-0">کد وضعیت ۵۰۳ · صفحه هر دو دقیقه به‌طور خودکار بررسی می‌شود</p>
</div>
<script>setTimeout(function () { location.reload(); }, 120000);</script>
