<form method="post" action="/install/run" class="card" data-no-lock>
  <input type="hidden" name="db_client" value="<%= dbCfg.client %>">
  <input type="hidden" name="db_host" value="<%= dbCfg.host %>"><input type="hidden" name="db_port" value="<%= dbCfg.port %>">
  <input type="hidden" name="db_name" value="<%= dbCfg.database %>"><input type="hidden" name="db_user" value="<%= dbCfg.user %>"><input type="hidden" name="db_password" value="<%= dbCfg.password %>">
  <div class="card-header"><h5><i class="bi bi-building me-1 text-brand"></i>اطلاعات شرکت و حساب مدیر ارشد</h5><% if (driver) { %><span class="badge badge-soft-success">اتصال موفق: <span class="ltr"><%= driver %></span></span><% } %></div>
  <div class="card-body">
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <h6 class="text-brand border-bottom pb-2">شرکت</h6>
    <div class="row g-3 mb-4">
      <div class="col-md-8"><label class="form-label required" for="f_company_name">نام کامل شرکت</label><input class="form-control" name="company_name" value="<%= form.company_name || 'شرکت دانش‌بنیان عرفان صنعت اصفهان' %>" required id="f_company_name"></div>
      <div class="col-md-4"><label class="form-label" for="f_company_short_name">نام کوتاه (برای پیامک)</label><input class="form-control" name="company_short_name" value="<%= form.company_short_name || 'عرفان صنعت' %>" id="f_company_short_name"></div>
      <div class="col-md-4"><label class="form-label" for="f_company_phone">تلفن</label><input class="form-control ltr" name="company_phone" value="<%= form.company_phone || '' %>" id="f_company_phone"></div>
      <div class="col-md-4"><label class="form-label" for="f_company_email">ایمیل</label><input class="form-control ltr" type="email" name="company_email" value="<%= form.company_email || '' %>" id="f_company_email"></div>
      <div class="col-md-4"><label class="form-label" for="f_company_city">شهر</label><input class="form-control" name="company_city" value="<%= form.company_city || 'اصفهان' %>" id="f_company_city"></div>
      <div class="col-md-8"><label class="form-label" for="f_company_address">آدرس</label><input class="form-control" name="company_address" value="<%= form.company_address || '' %>" id="f_company_address"></div>
      <div class="col-md-4"><label class="form-label" for="f_timezone_offset">منطقهٔ زمانی</label><select class="form-select ltr" name="timezone_offset" id="f_timezone_offset"><% ['+03:30','+04:30','+00:00','+01:00','+02:00','+03:00','+04:00','+05:00'].forEach(function (t) { %><option <%= (form.timezone_offset || '+03:30') === t ? 'selected' : '' %>><%= t %></option><% }); %></select></div>
    </div>
    <h6 class="text-brand border-bottom pb-2">حساب مدیر ارشد سامانه <span class="fs-7 fw-normal text-secondary">(فقط یک‌بار، در همین مرحله تعیین می‌شود)</span></h6>
    <div class="row g-3 mb-4">
      <div class="col-md-6"><label class="form-label required" for="f_admin_name">نام و نام خانوادگی</label><input class="form-control" name="admin_name" value="<%= form.admin_name || '' %>" required id="f_admin_name"></div>
      <div class="col-md-6"><label class="form-label required" for="f_admin_username">نام کاربری</label><input class="form-control ltr" name="admin_username" value="<%= form.admin_username || 'admin' %>" required pattern="[a-zA-Z0-9_.]{3,30}" id="f_admin_username" autocomplete="off"></div>
      <div class="col-md-6"><label class="form-label required" for="f_admin_password">رمز عبور (حداقل ۸ کاراکتر)</label><input class="form-control ltr" type="password" name="admin_password" required minlength="8" id="f_admin_password" autocomplete="new-password"></div>
      <div class="col-md-6"><label class="form-label required" for="f_admin_password2">تکرار رمز عبور</label><input class="form-control ltr" type="password" name="admin_password2" required minlength="8" id="f_admin_password2" autocomplete="new-password"></div>
      <div class="col-md-6"><label class="form-label" for="f_admin_email">ایمیل</label><input class="form-control ltr" type="email" name="admin_email" value="<%= form.admin_email || '' %>" id="f_admin_email"></div>
      <div class="col-md-6"><label class="form-label" for="f_admin_mobile">موبایل</label><input class="form-control ltr" name="admin_mobile" value="<%= form.admin_mobile || '' %>" id="f_admin_mobile" placeholder="09…"></div>
      <div class="col-12 fs-7 text-secondary"><i class="bi bi-info-circle me-1"></i>مدیر ارشد به همهٔ بخش‌ها دسترسی دارد و می‌تواند سطوح دسترسی دیگر (مدیر منابع انسانی، کارشناس، کارمند و سطوح سفارشی) را تعریف و به کاربران اختصاص دهد.</div>
    </div>
    <h6 class="text-brand border-bottom pb-2">دادهٔ نمونه</h6>
    <div class="form-check form-switch">
      <input type="hidden" name="demo" value="0">
      <input class="form-check-input" type="checkbox" role="switch" name="demo" value="1" id="demo" <%= form.demo === '0' ? '' : 'checked' %>>
      <label class="form-check-label" for="demo">بارگذاری دادهٔ نمایشی (موقعیت‌های شغلی، متقاضیان با فرم تکمیل‌شده و نتایج آزمون، کاربران نمونهٔ منابع انسانی) — برای آشنایی با سامانه توصیه می‌شود. بعداً از «تنظیمات › داده‌های نمونه» قابل حذف است.</label>
    </div>
  </div>
  <div class="card-footer bg-transparent d-flex justify-content-between">
    <a href="/install/database" class="btn btn-light"><i class="bi bi-arrow-right me-1"></i>قبلی</a>
    <button class="btn btn-primary px-4" id="runBtn"><i class="bi bi-rocket-takeoff me-1"></i>نصب سامانه</button>
  </div>
</form>
<script>document.querySelector('form[action="/install/run"]').addEventListener('submit', function () { var b = document.getElementById('runBtn'); setTimeout(function () { b.disabled = true; b.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>در حال نصب… لطفاً صبر کنید'; }, 10); });</script>
